Notebook[{

Cell[CellGroupData[{
Cell["SubTropica", "GuideTitle",ExpressionUUID->"c7647be4-65b4-4f11-adda-58ec2ce602ff"],

Cell["\<\
Feynman-integral evaluation via tropical geometry. SubTropica automates the \
full pipeline from a Feynman graph to an analytic result: Symanzik polynomial \
construction, GL(1) gauge fixing, Nilsson\[Dash]Passare tropical subtraction, \
linear-reducibility analysis, and integration via HyperFLINT (with \
HyperIntica as the built-in fallback). Analytic results can be cross-checked \
numerically against pySecDec, FIESTA, AMFlow, or feyntrop. Install and \
configure external tools once with ConfigureSubTropica, then evaluate \
integrals either through STIntegrate (scripted) or FeynmanIntegrate \
(interactive GUI).\
\>", "GuideAbstract",ExpressionUUID->"5af34ad5-380a-4ddf-9872-7fd0df9a815b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Installation", "GuideFunctionsSection",ExpressionUUID->"3e523689-1146-41db-aa42-6bf031a0220b"],

Cell["Install the paclet from Mathematica:", "GuideText",ExpressionUUID->"5fe6f95a-7d63-4997-a7d6-74c05bea8d35"],

Cell[BoxData[
 RowBox[{"PacletInstall", "[", "\"\<https://subtropi.ca/SubTropica.paclet\>\"",
   "]"}]], "Input",ExpressionUUID->"d37335dc-0899-4ab0-9729-2a0e72941738"],

Cell["Then load it and configure external-tool paths:", "GuideText",ExpressionUUID->"2c88e75e-2ac6-4e0b-92b7-c70a2f3b9328"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"Get", "[", "\"\<SubTropica`\>\"", "]"}], ";"}], "\n", 
 RowBox[{"ConfigureSubTropica", "[", "\n", "  ", 
  RowBox[{"(*", " ", "required", " ", "*)"}], "\n", "  ", 
  RowBox[{
   RowBox[{"PolymakePath", "   ", "->", " ", "\"\<path/to/polymake\>\""}], ",",
    "\n", "  ", 
   RowBox[{"(*", " ", "recommended", " ", "*)"}], "\n", "  ", 
   RowBox[{"FiniteFlowPath", " ", "->", " ", "\"\<path/to/FiniteFlow\>\""}], ",",
    "\n", "  ", 
   RowBox[{"SPQRPath", "       ", "->", " ", "\"\<path/to/SPQR\>\""}], ",", 
   "\n", "  ", 
   RowBox[{"PythonPath", "     ", "->", " ", "\"\<path/to/python\>\""}], ",", 
   "  ", 
   RowBox[{"(*", " ", 
    RowBox[{
    "a", " ", "python", " ", "with", " ", "pySecDec", " ", "installed"}], " ",
     "*)"}], "\n", "  ", 
   RowBox[{"HyperFlintPath", " ", "->", " ", "\"\<path/to/hyperflint\>\""}], ",",
    "  ", 
   RowBox[{"(*", " ", 
    RowBox[{"default", " ", "symbolic", " ", "backend"}], " ", "*)"}], "\n", 
   "  ", 
   RowBox[{"(*", " ", "optional", " ", "*)"}], "\n", "  ", 
   RowBox[{"HyperFormPath", "  ", "->", " ", "\"\<path/to/HyperForm\>\""}], ",",
    "\n", "  ", 
   RowBox[{"GinshPath", "      ", "->", " ", "\"\<path/to/ginsh\>\""}], ",", 
   "\n", "  ", 
   RowBox[{"MaplePath", "      ", "->", " ", "\"\<path/to/maple\>\""}], ",", 
   "\n", "  ", 
   RowBox[{"FIESTAPath", "     ", "->", " ", "\"\<path/to/FIESTA\>\""}]}], 
  "\n", "]"}]}], "Input",ExpressionUUID->"d2ec0b13-0fd8-4b26-ba87-\
e04c83b9e255"],

Cell[TextData[{
 "Paths are written to the persistent config file (",
 StyleBox["$UserBaseDirectory/Kernel/SubTropicaConfig.m", "TI"],
 ") and reapplied on every subsequent ",
 StyleBox["Get[\"SubTropica`\"]", "TI"],
 "; call ",
 StyleBox["ConfigureSubTropica", "TI"],
 " only to add or change a path.  Use ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["STResetConfig"]], "paclet:SubTropica/ref/STResetConfig", 
    "SubTropica Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFunctionSans"]], "InlineFunctionSans",ExpressionUUID->
  "14108e92-67d8-4e65-9acf-9f43069b8f3f"],
 " to discard the saved configuration."
}], "GuideText",ExpressionUUID->"065965a7-0aba-4f4d-b0fb-b7428767a9e9"],

Cell[TextData[{
 StyleBox["polymake", "TI"],
 " is the only required dependency.  ",
 StyleBox["python", "TI"],
 " is strongly recommended (required for the GUI).  ",
 StyleBox["FiniteFlow", "TI"],
 " and ",
 StyleBox["SPQR", "TI"],
 " enable finite-field arithmetic inside HyperIntica's partial-fraction step \
and are recommended for complex diagrams.  ",
 StyleBox["pySecDec", "TI"],
 ", ",
 StyleBox["FIESTA", "TI"],
 ", ",
 StyleBox["AMFlow", "TI"],
 ", ",
 StyleBox["feyntrop", "TI"],
 " enable numerical cross-checks via ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["STVerify"]], "paclet:SubTropica/ref/STVerify", 
    "SubTropica Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFunctionSans"]], "InlineFunctionSans",ExpressionUUID->
  "e4226099-5b96-43e8-9d89-7422e5a07209"],
 " and ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["STNIntegrate"]], "paclet:SubTropica/ref/STNIntegrate", 
    "SubTropica Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFunctionSans"]], "InlineFunctionSans",ExpressionUUID->
  "492ed637-9114-4829-bdfa-ad0d179b10d4"],
 ".  ",
 StyleBox["ginsh", "TI"],
 " is needed only to evaluate hyperlogarithms numerically.  On macOS, install \
most of these via Homebrew; the default Homebrew path for polymake is \
/opt/homebrew/bin/polymake."
}], "GuideText",ExpressionUUID->"3fdc2f7c-909e-4e66-8f9d-9f231f2672a5"],

Cell["After configuring, verify the install with", "GuideText",ExpressionUUID->"1e44e213-e23e-479a-ad7a-82baffdac8cc"],

Cell[BoxData[
 RowBox[{"STBenchmark", "[", "]"}]], "Input",ExpressionUUID->"159a8c4f-551c-4cf0-9e3b-5e43fc7409ad"],

Cell[TextData[{
 "which checks every dependency (see ",
 Cell[BoxData[
  TemplateBox[{
    Cell[
     TextData["STDependencies"]], "paclet:SubTropica/ref/STDependencies", 
    "SubTropica Package Symbol"},
   "PackageLink",
   BaseStyle->"InlineFunctionSans"]], "InlineFunctionSans",ExpressionUUID->
  "e1af4856-56c2-4424-9159-860adfbf6773"],
 ") and runs the curated test suite."
}], "GuideText",ExpressionUUID->"8f77ba9f-e483-4e47-958d-ece0787a3a4b"],

Cell["Mathematica 12.1 or later is required.", "GuideText",ExpressionUUID->"9c65278b-d3e7-4071-93ba-b95cab4526f2"]
}, Open  ]],

