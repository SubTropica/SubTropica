Notebook[{

Cell[CellGroupData[{
Cell["STSubmitResult", "ObjectName",ExpressionUUID->"851df434-62d5-4771-9227-68fc8a0c4038"],

Cell[BoxData[GridBox[{
   {Cell[TextData[{
     StyleBox["STSubmitResult[]", "TI"],
     " \[LineSeparator]submits the most recent integration result to the \
central SubTropica library. No GitHub account required. Submissions are gated \
on numerical verification: if $integrationResult does not carry a passing \
STVerify record, STSubmitResult runs STVerify inline (1 kinematic point, \
pySecDec, Tolerance 10^-3) before submitting and aborts on failure. \
Backend-tuning options are forwarded to the inline STVerify (\"Method\", \
\"MaxTime\", \"NumSamples\", \"Seed\", \"Accuracy\", \"MaxEval\", \
\"Integrator\", \"Verbose\", and FIESTA / AMFlow / feyntrop tunings). The \
pass-criterion options (\"Tolerance\", \"Order\", \"Substitutions\", \
\"Dimension\", \"Exponents\", \"ResultIndex\", \"LibraryPath\") are locked so \
the submission gate cannot be bypassed."
    }], "TableText",ExpressionUUID->"cc62755b-0235-4823-8312-902469487bbe"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Usage",
 CellID->1,ExpressionUUID->"dad92701-0ef8-4669-a12d-bfd215de2eac"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Options", "OptionsSection",ExpressionUUID->"8a952ac9-fedf-4821-a950-8785726d2c9f"],

Cell[BoxData[GridBox[{
   {"\"\<DryRun\>\"", "False", 
    RowBox[{
    "build", " ", "and", " ", "validate", " ", "the", " ", "submission", " ", 
     "without", " ", "sending", " ", "it"}]},
   {"\"\<Accuracy\>\"", 
    RowBox[{"1", "/", "10000"}], 
    RowBox[{
    "target", " ", "relative", " ", "accuracy", " ", "for", " ", "the", " ", 
     "verification", " ", "gate"}]},
   {"\"\<MaxEval\>\"", "Automatic", 
    RowBox[{"maximum", " ", "integrand", " ", "evaluations"}]},
   {"\"\<Verbose\>\"", "False", 
    RowBox[{"print", " ", "verification", " ", "progress"}]},
   {"\"\<Integrator\>\"", "Automatic", 
    RowBox[{"numeric", " ", 
     RowBox[{"backend", "/", "integrator"}], " ", "for", " ", "the", " ", 
     "gate"}]},
   {"\"\<NumSamples\>\"", "1", 
    RowBox[{
    "number", " ", "of", " ", "kinematic", " ", "sample", " ", "points"}]},
   {"\"\<Seed\>\"", "Automatic", 
    RowBox[{
     RowBox[{"seed", " ", "for", " ", "sample"}], "-", 
     RowBox[{"point", " ", "generation"}]}]},
   {"\"\<NumberOfSubkernels\>\"", "1", 
    RowBox[{
    "parallel", " ", "subkernels", " ", "for", " ", "the", " ", "numeric", " ",
      "check"}]},
   {"\"\<NumberOfLinks\>\"", "4", 
    RowBox[{"MathLink", " ", "links", " ", "to", " ", "the", " ", "backend"}]},
   {"\"\<Strategy\>\"", "\"\<S2\>\"", 
    RowBox[{"sector", "-", 
     RowBox[{"decomposition", " ", "strategy"}]}]},
   {"\"\<ComplexMode\>\"", "Automatic", 
    RowBox[{
     RowBox[{"force", " ", "complex"}], "-", 
     RowBox[{"contour", " ", "mode"}]}]},
   {"\"\<FeyntropLambda\>\"", "0", 
    RowBox[{"feyntrop", " ", "deformation", " ", "parameter"}]},
   {"\"\<FeyntropSeed\>\"", "0", 
    RowBox[{"feyntrop", " ", "RNG", " ", "seed"}]},
   {"\"\<FeyntropNThread\>\"", "Automatic", 
    RowBox[{"feyntrop", " ", "thread", " ", "count"}]},
   {"\"\<MaxTime\>\"", "Automatic", 
    RowBox[{"wall", "-", 
     RowBox[{
     "time", " ", "cap", " ", "for", " ", "the", " ", "verification"}]}]},
   {"\"\<Precision\>\"", "80", 
    RowBox[{"working", " ", "precision", " ", 
     RowBox[{"(", 
      RowBox[{"symbolic", "-", 
       RowBox[{"evaluator", " ", "path"}]}], ")"}]}]},
   {"\"\<TolExp\>\"", "45", 
    RowBox[{"tolerance", " ", "exponent", " ", 
     RowBox[{"(", 
      RowBox[{"symbolic", "-", 
       RowBox[{"evaluator", " ", "driver"}]}], ")"}]}]},
   {"\"\<HStartExp\>\"", "28", 
    RowBox[{"initial", " ", "step", " ", "exponent", " ", 
     RowBox[{"(", 
      RowBox[{"symbolic", "-", 
       RowBox[{"evaluator", " ", "driver"}]}], ")"}]}]},
   {"\"\<Epsilon\>\"", 
    RowBox[{"1", "/", "1000000"}], 
    RowBox[{
     RowBox[{"i\[CurlyEpsilon]", " ", "/", " ", "regulator"}], " ", 
     "displacement", " ", "for", " ", "evaluation"}]}
  },
  GridBoxAlignment->{"Columns" -> {Left, Left, Left}},
  GridBoxDividers->{"Rows" -> {True, {False}, True}}]], "OptionsTable",Express\
ionUUID->"ca8fffc7-8d3d-4382-864d-ac9219a5b095"]
}, Open  ]],

