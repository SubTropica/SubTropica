Cell["\<\
Numerically evaluate a Feynman/Euler integral by sector decomposition \
(default pySecDec); for the elliptic kite at a sample point the eps^0 \
coefficient is -0.0708835.  Requires the configured numerical backend.\
\>", "ExampleText",ExpressionUUID->"4d90c101-c230-41d8-a4ad-f7748dc4a052"],

Cell[BoxData[
 RowBox[{"ConfigureSubTropica", "[", 
  RowBox[{
  "PythonPath", " ", "->", " ", "\"\<.venvs/subtropica312/bin/python\>\""}], 
  "]"}]], "Input",ExpressionUUID->"ec0cd384-dfb3-4e0a-9252-afa48e09b3ae"],

Cell[BoxData[
 RowBox[{"STNIntegrate", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"edges", ",", " ", "nodes"}], "}"}], ",", " ", 
   RowBox[{"\"\<Substitutions\>\"", " ", "->", " ", "kinematicPoint"}]}], 
  "]"}]], "Input",ExpressionUUID->"4b6a8f38-41e5-4eb5-a944-17cb9cecb7e7"]
}, Open  ]],

