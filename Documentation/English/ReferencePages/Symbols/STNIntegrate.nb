Notebook[{

Cell[CellGroupData[{
Cell["STNIntegrate", "ObjectName",ExpressionUUID->"125369d9-2bd9-420c-ac46-0d31546a759d"],

Cell[BoxData[GridBox[{
   {Cell[TextData[{
     StyleBox["STNIntegrate", "TI"],
     " \[LineSeparator]STNIntegrate numerically evaluates integrals."
    }], "TableText",ExpressionUUID->"21891ed5-fc8f-4839-a151-ae93692d9668"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Usage",
 CellID->1,ExpressionUUID->"aa386956-0bd2-4cda-b75a-92260606a228"],

Cell["\<\
STNIntegrate numerically evaluates integrals. It accepts all the same input \
formats as STIntegrate (Forms~1--3), including generic parametric \
representations.\
\>", "Notes",ExpressionUUID->"df091e74-7ca0-4526-b900-3b3f364a831b"],

Cell[BoxData[
 RowBox[{"STNIntegrate", "[", 
  RowBox[{"input", "\n", "    ", ",", " ", 
   RowBox[{"\"\<Method\>\"", "             ", "->", " ", "\"\<pySecDec\>\""}],
    "\n", "    ", ",", " ", 
   RowBox[{"\"\<Substitutions\>\"", "     ", "->", " ", 
    RowBox[{"{", "}"}]}], "\n", "    ", ",", " ", 
   RowBox[{"\"\<Order\>\"", "              ", "->", " ", "0"}], "\n", "    ", 
   ",", " ", 
   RowBox[{"\"\<MaxEval\>\"", "            ", "->", " ", 
    RowBox[{"10", "^", "7"}]}], "\n", "    ", ",", " ", 
   RowBox[{"\"\<Accuracy\>\"", "           ", "->", " ", 
    RowBox[{"10", "^", 
     RowBox[{"-", "4"}]}]}], "\n", "    ", ",", " ", 
   RowBox[{"\"\<Integrator\>\"", "         ", "->", " ", "\"\<Qmc\>\""}], 
   "\n", "    ", ",", " ", 
   RowBox[{"\"\<ContourDeformation\>\"", " ", "->", " ", "True"}], "\n", 
   "    ", ",", " ", 
   RowBox[{"\"\<Verbose\>\"", "            ", "->", " ", "False"}], "\n", 
   "    ", ",", " ", 
   RowBox[{"\"\<Dimension\>\"", "          ", "->", " ", 
    RowBox[{"4", " ", "-", " ", 
     RowBox[{"2", " ", "eps"}]}]}], "\n", "    ", ",", " ", 
   RowBox[{"\"\<Normalization\>\"", "      ", "->", " ", "Automatic"}], "\n", 
   "    ", ",", " ", 
   RowBox[{"\"\<Exponents\>\"", "          ", "->", " ", "Automatic"}], "\n", 
   "    ", ",", " ", 
   RowBox[{"\"\<Substitutions\>\"", "      ", "->", " ", 
    RowBox[{"{", "}"}]}], "\n", "    ", ",", " ", 
   RowBox[{"\"\<CacheDirectory\>\"", "     ", "->", " ", "Automatic"}]}], 
  "]"}]], "Input",ExpressionUUID->"97f1c2fb-26db-4751-999e-249854352ed5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Details", "Section",ExpressionUUID->"68b62918-e331-4675-92d3-6554ee716062"],

Cell["Options", "Subsection",ExpressionUUID->"9aa4411c-3f2c-4209-aca8-b35b23c736f6"],

Cell["\<\
\"Method\" selects the backend: \"pySecDec\" (default), \"FIESTA\", \
\"AMFlow\" or \"feyntrop\". \"Substitutions\" specifies the numerical values \
for kinematic variables as a list of rules (e.g., {s12 -> -7, mm -> 3}). \
\"Order\" sets the \[CurlyEpsilon]-expansion depth. \"MaxEval\" caps the \
number of integrand evaluations. \"Integrator\" selects the integration \
algorithm: \"Qmc\" (default, quasi-Monte Carlo), \"Vegas\", or \"Disteval\". \
QMC is the default as it typically provides the fastest convergence.\
\>", "Text",ExpressionUUID->"5f4de625-f083-4088-8ada-798df4072d83"],

Cell["Return value", "Subsection",ExpressionUUID->"6494a2b2-b17d-464d-9fb4-c96f086e49a4"],

Cell["\<\
An Association with keys \"Value\" (the numerical result as a SeriesData), \
\"Error\" (integration uncertainties), \"Method\", \"Integrator\", \
\"Substitutions\", and \"Timing\" (wall-clock time in seconds).\
\>", "Text",ExpressionUUID->"6c5d96b8-fd6b-409e-a981-d783ba745db5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Options", "OptionsSection",ExpressionUUID->"550ac871-ca2d-49ce-a702-271e7f4868f2"],

Cell[BoxData[GridBox[{
   {"\"\<Method\>\"", "\"\<pySecDec\>\"", 
    RowBox[{
     RowBox[{"numerical", " ", 
      RowBox[{"backend", ":", " ", "\"\<pySecDec\>\""}]}], ",", 
     " ", "\"\<FIESTA\>\"", ",", " ", "\"\<AMFlow\>\"", ",", " ", 
     RowBox[{"or", " ", "\"\<feyntrop\>\""}]}]},
   {"\"\<Order\>\"", "0", 
    RowBox[{
     RowBox[{"highest", " ", "\[CurlyEpsilon]"}], "-", 
     RowBox[{"order", " ", "to", " ", "evaluate"}]}]},
   {"\"\<Accuracy\>\"", 
    RowBox[{"1", "/", "10000"}], 
    RowBox[{"target", " ", "relative", " ", "accuracy"}]},
   {"\"\<MaxEval\>\"", 
    RowBox[{"10", "^", "7"}], 
    RowBox[{"maximum", " ", "integrand", " ", "evaluations"}]},
   {"\"\<Substitutions\>\"", "Automatic", 
    RowBox[{
     RowBox[{"kinematic", " ", "point", " ", "as", " ", "rules"}], ";", " ", 
     RowBox[{
      RowBox[{"Automatic", " ", "auto"}], "-", 
      RowBox[{"generates", " ", "a", " ", "valid", " ", "point"}]}]}]},
   {"\"\<NumSamples\>\"", "1", 
    RowBox[{
     RowBox[{"if", " ", ">", "1"}], ",", " ", 
     RowBox[{"re", "-", 
      RowBox[{
      "evaluate", " ", "at", " ", "that", " ", "many", " ", "independent", " ",
        "kinematic", " ", "points"}]}]}]},
   {"\"\<Seed\>\"", "Automatic", 
    RowBox[{
     RowBox[{
     "integer", " ", "seed", " ", "override", " ", "for", " ", "the", " ", 
      "auto"}], "-", 
     RowBox[{"generated", " ", "kinematic", " ", "point"}]}]},
   {"\"\<Verbose\>\"", "False", 
    RowBox[{"print", " ", "backend", " ", "progress"}]},
   {"\"\<ContourDeformation\>\"", "True", 
    RowBox[{
     RowBox[{
     "enable", " ", "contour", " ", "deformation", " ", "for", " ", 
      "physical"}], "-", 
     RowBox[{"region", " ", "integrals"}]}]},
   {"\"\<CacheDirectory\>\"", "Automatic", 
    RowBox[{"directory", " ", "for", " ", "the", " ", 
     RowBox[{"generated", "/", "compiled"}], " ", "sector", " ", 
     "library"}]},
   {"\"\<Normalization\>\"", "Automatic", 
    RowBox[{"overall", " ", "prefactor", " ", "convention"}]},
   {"\"\<Dimension\>\"", 
    RowBox[{"4", " ", "-", " ", 
     RowBox[{"2", " ", "eps"}]}], 
    RowBox[{"spacetime", " ", "dimension"}]},
   {"\"\<Exponents\>\"", "Automatic", 
    RowBox[{
     RowBox[{"propagator", "/", "numerator"}], " ", "powers"}]},
   {"\"\<LoopMomenta\>\"", "Automatic", 
    RowBox[{"loop", "-", 
     RowBox[{"momentum", " ", "symbols"}]}]},
   {"\"\<Integrator\>\"", "Automatic", 
    RowBox[{"integration", " ", "algorithm", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"pySecDec", ":", " ", "Qmc"}], ",", " ", "Disteval", ",", " ", 
       "Vegas", ",", " ", "tropicalMC"}], ")"}]}]},
   {"\"\<MaxTime\>\"", "Automatic", 
    RowBox[{
     RowBox[{
      RowBox[{"unified", " ", "wall"}], "-", 
      RowBox[{"clock", " ", "cap", " ", 
       RowBox[{"(", "s", ")"}]}]}], ";", " ", 
     RowBox[{"Infinity", " ", "disables", " ", "every", " ", "timer"}]}]},
   {"\"\<NumberOfSubkernels\>\"", "4", 
    RowBox[{
     RowBox[{"(", "FIESTA", ")"}], " ", "subkernel", " ", "count"}]},
   {"\"\<NumberOfLinks\>\"", "4", 
    RowBox[{
     RowBox[{"(", "FIESTA", ")"}], " ", "MathLink", " ", "link", " ", 
     "count"}]},
   {"\"\<Strategy\>\"", "\"\<S2\>\"", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", "FIESTA", ")"}], " ", "sector"}], "-", 
      RowBox[{"decomposition", " ", 
       RowBox[{"strategy", ":", " ", "S2"}]}]}], ",", " ", "X", ",", " ", 
     "KU", ",", " ", "KU0"}]},
   {"\"\<ComplexMode\>\"", "Automatic", 
    RowBox[{
     RowBox[{"(", "FIESTA", ")"}], " ", "force", " ", "complex", " ", 
     "arithmetic"}]},
   {"\"\<AMFlowIBPReducer\>\"", "\"\<FiniteFlow+LiteRed\>\"", 
    RowBox[{
     RowBox[{"(", "AMFlow", ")"}], " ", "IBP", " ", "reducer"}]},
   {"\"\<AMFlowPrecision\>\"", "16", 
    RowBox[{
     RowBox[{"(", "AMFlow", ")"}], " ", "working", " ", "precision", " ", 
     RowBox[{"(", "digits", ")"}]}]},
   {"\"\<AMFlowFamily\>\"", "Automatic", 
    RowBox[{
     RowBox[{
      RowBox[{"(", "AMFlow", ")"}], " ", "integral"}], "-", 
     RowBox[{"family", " ", "specification"}]}]},
   {"\"\<AMFlowNThread\>\"", "4", 
    RowBox[{
     RowBox[{"(", "AMFlow", ")"}], " ", "thread", " ", "count"}]},
   {"\"\<FeyntropLambda\>\"", "0", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"(", "feyntrop", ")"}], " ", "contour"}], "-", 
      RowBox[{"deformation", " ", "parameter"}]}], ";", " ", 
     RowBox[{"0", " ", "=", " ", "Euclidean"}]}]},
   {"\"\<FeyntropSeed\>\"", "0", 
    RowBox[{
     RowBox[{"(", "feyntrop", ")"}], " ", "RNG", " ", "seed"}]},
   {"\"\<FeyntropNThread\>\"", "Automatic", 
    RowBox[{
     RowBox[{
      RowBox[{"(", "feyntrop", ")"}], " ", "OMP", " ", "thread", " ", 
      "count"}], ";", " ", 
     RowBox[{"Automatic", " ", "=", " ", 
      RowBox[{"all", " ", "cores"}]}]}]}
  },
  GridBoxAlignment->{"Columns" -> {Left, Left, Left}},
  GridBoxDividers->{"Rows" -> {True, {False}, True}}]], "OptionsTable",Express\
ionUUID->"44989040-4145-44c7-b9a1-116a2a87bc6b"]
}, Open  ]],

