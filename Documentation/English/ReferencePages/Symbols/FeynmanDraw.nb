   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"885f740e-4da7-\
4369-8275-5c08031822ce"],

Cell["\<\
FeynmanDraw is a bare symbol that opens the drawing canvas and returns an \
{edges, nodes} pair usable by STIntegrate / FeynmanPlot.  Requires a notebook \
front end.\
\>", "ExampleText",ExpressionUUID->"e48b64fc-1aa2-4589-ab06-695fb5698d43"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"edges", ",", " ", "nodes"}], "}"}], " ", "=", " ", 
  "FeynmanDraw"}]], "Input",ExpressionUUID->"f5efbb42-9da3-444a-b3f7-\
7e4cc273ca99"]
}, Open  ]],

