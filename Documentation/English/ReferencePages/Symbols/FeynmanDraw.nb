Notebook[{

Cell[CellGroupData[{
Cell["FeynmanDraw", "ObjectName",ExpressionUUID->"9b20a0a6-4e54-498a-96e0-de82b80ff30d"],

Cell[BoxData[GridBox[{
   {Cell[TextData[{
     StyleBox["FeynmanDraw", "TI"],
     " \[LineSeparator]FeynmanDraw opens an interactive canvas for drawing a \
Feynman diagram and returns the resulting {edges, nodes} pair in the SOFIA / \
SubTropica convention. Usage: {edges, nodes} = FeynmanDraw. The returned pair \
can be passed directly to STIntegrate or visualized with FeynmanPlot."
    }], "TableText",ExpressionUUID->"d75a1d08-a928-4dd6-85ce-4a19a6e9e08a"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Usage",
 CellID->1,ExpressionUUID->"cff7ac24-2939-494f-856b-cef63e40b8f1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"660ed0d0-677e-4807-8fd7-bb9781ff546b"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["FeynmanPlot",
   BaseStyle->"Link",
   ButtonData->"paclet:SubTropica/ref/FeynmanPlot"]], "InlineFormula",
  ExpressionUUID->"7ed3dd54-5603-4373-889c-928783128041"],
 " \[EmptyVerySmallSquare] ",
 Cell[BoxData[
  ButtonBox["FeynmanIntegrate",
   BaseStyle->"Link",
   ButtonData->"paclet:SubTropica/ref/FeynmanIntegrate"]], "InlineFormula",
  ExpressionUUID->"e5cd0595-ba1f-4483-945c-dc388819fce7"],
 " \[EmptyVerySmallSquare] ",
 Cell[BoxData[
  ButtonBox["STIntegrate",
   BaseStyle->"Link",
   ButtonData->"paclet:SubTropica/ref/STIntegrate"]], "InlineFormula",
  ExpressionUUID->"f06b16ea-c75e-44cb-ad6f-8af4cb2d5f78"]
}], "SeeAlso",ExpressionUUID->"165e8974-7dfe-47b7-991f-9b8bc562a87e"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[GridBox[{
    {
