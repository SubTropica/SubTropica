Notebook[{

Cell[CellGroupData[{
Cell["FeynmanDraw", "ObjectName",ExpressionUUID->"6f8d738b-c347-4e82-8182-f8a4e25b1da0"],

Cell[BoxData[GridBox[{
   {Cell[TextData[{
     StyleBox["FeynmanDraw", "TI"],
     " \[LineSeparator]FeynmanDraw opens an interactive canvas for drawing a \
Feynman diagram and returns the resulting {edges, nodes} pair in the SOFIA / \
SubTropica convention. Usage: {edges, nodes} = FeynmanDraw. The returned pair \
can be passed directly to STIntegrate or visualized with FeynmanPlot."
    }], "TableText",ExpressionUUID->"975dbe68-25ba-48ae-999a-a705a778b9ba"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Usage",
 CellID->1,ExpressionUUID->"b12ef02d-31d2-419f-9afb-01a78dd08087"]
}, Open  ]],

Cell[CellGroupData[{

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"bfd4e1df-6e9e-48ea-b028-821be6061200"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["FeynmanPlot",
   BaseStyle->"Link",
   ButtonData->"paclet:SubTropica/ref/FeynmanPlot"]], "InlineFormula",
  ExpressionUUID->"45497463-3190-4441-9f25-e5c14b9cc1f9"],
 " \[EmptyVerySmallSquare] ",
 Cell[BoxData[
  ButtonBox["FeynmanIntegrate",
   BaseStyle->"Link",
   ButtonData->"paclet:SubTropica/ref/FeynmanIntegrate"]], "InlineFormula",
  ExpressionUUID->"31df9e05-8667-4389-8c75-90858b7b1ced"],
 " \[EmptyVerySmallSquare] ",
 Cell[BoxData[
  ButtonBox["STIntegrate",
   BaseStyle->"Link",
   ButtonData->"paclet:SubTropica/ref/STIntegrate"]], "InlineFormula",
  ExpressionUUID->"1d2b9360-ba62-44c0-a661-000aab00b941"]
}], "SeeAlso",ExpressionUUID->"10745182-272c-4da4-b495-8ee7bd1890d2"]
