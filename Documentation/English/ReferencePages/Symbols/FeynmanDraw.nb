Notebook[{

Cell[CellGroupData[{
Cell["FeynmanDraw", "ObjectName",ExpressionUUID->"5e2d100a-966e-4a0b-8296-aa3b9ff757d9"],

Cell[BoxData[GridBox[{
   {Cell[TextData[{
     StyleBox["FeynmanDraw", "TI"],
     " \[LineSeparator]FeynmanDraw opens an interactive canvas for drawing a \
Feynman diagram and returns the resulting {edges, nodes} pair in the SOFIA / \
SubTropica convention. Usage: {edges, nodes} = FeynmanDraw. The returned pair \
can be passed directly to STIntegrate or visualized with FeynmanPlot."
    }], "TableText",ExpressionUUID->"16144b6c-aad0-44e7-beca-6bd44c7768cc"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Usage",
 CellID->1,ExpressionUUID->"bfdd546c-1342-483a-b44a-130416db58fe"]
}, Open  ]],

Cell[CellGroupData[{

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"63e917c6-241e-4ff4-912b-f6dea19aa75e"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["FeynmanPlot",
   BaseStyle->"Link",
   ButtonData->"paclet:SubTropica/ref/FeynmanPlot"]], "InlineFormula",
  ExpressionUUID->"c45ff3c6-c749-44cd-b3c5-1aaec1a520b8"],
 " \[EmptyVerySmallSquare] ",
 Cell[BoxData[
  ButtonBox["FeynmanIntegrate",
   BaseStyle->"Link",
   ButtonData->"paclet:SubTropica/ref/FeynmanIntegrate"]], "InlineFormula",
  ExpressionUUID->"eca00434-f7c7-4c50-9591-77498991ffbd"],
 " \[EmptyVerySmallSquare] ",
 Cell[BoxData[
  ButtonBox["STIntegrate",
   BaseStyle->"Link",
   ButtonData->"paclet:SubTropica/ref/STIntegrate"]], "InlineFormula",
  ExpressionUUID->"60843157-4919-49fa-9762-e0e176dc6dfb"]
}], "SeeAlso",ExpressionUUID->"d33723af-523c-4bc4-ac77-286d23b7f0dd"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[GridBox[{
    {
     StyleBox[
      RowBox[{"Basic", " ", "Examples"}], "PrimaryExamplesSection"], 
     ButtonBox[
      RowBox[{
       RowBox[{"More", " ", "Examples"}], " ", "\[RightTriangle]"}],
      BaseStyle->"ExtendedExamplesLink",
      ButtonData:>"ExtendedExamples"]}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"9a491434-b5b1-\
4d43-8f7d-aa23ccc1a77d"],

Cell["\<\
FeynmanDraw is a bare symbol that opens the drawing canvas and returns an \
{edges, nodes} pair usable by STIntegrate / FeynmanPlot.  Requires a notebook \
front end.\
\>", "ExampleText",ExpressionUUID->"ff1135a8-630d-449d-8a5c-e81b46aeaac4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"edges", ",", " ", "nodes"}], "}"}], " ", "=", " ", 
  "FeynmanDraw"}]], "Input",ExpressionUUID->"1c9d063f-ff62-4db2-bbdd-\
c6e94e8aa306"]
}, Open  ]],

