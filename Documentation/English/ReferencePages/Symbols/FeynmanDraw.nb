      RowBox[{"Basic", " ", "Examples"}], "PrimaryExamplesSection"], 
     ButtonBox[
      RowBox[{
       RowBox[{"More", " ", "Examples"}], " ", "\[RightTriangle]"}],
      BaseStyle->"ExtendedExamplesLink",
      ButtonData:>"ExtendedExamples"]}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"372a8315-9bfe-\
4e4d-b1d7-eb914ed603f8"],

Cell["\<\
FeynmanDraw is a bare symbol that opens the drawing canvas and returns an \
{edges, nodes} pair usable by STIntegrate / FeynmanPlot.  Requires a notebook \
front end.\
\>", "ExampleText",ExpressionUUID->"f26c69f5-af7f-4c40-9f15-1a156c75035b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"{", 
   RowBox[{"edges", ",", " ", "nodes"}], "}"}], " ", "=", " ", 
  "FeynmanDraw"}]], "Input",ExpressionUUID->"71bd94a5-16d6-4492-81b0-\
977a7ceb0e82"]
}, Open  ]],

