Notebook[{

Cell[CellGroupData[{
Cell["FeynmanDraw", "ObjectName",ExpressionUUID->"5c290193-210a-476d-9a8e-7a69141d17c4"],

Cell[BoxData[GridBox[{
   {Cell[TextData[{
     StyleBox["FeynmanDraw", "TI"],
     " \[LineSeparator]FeynmanDraw opens an interactive canvas for drawing a \
Feynman diagram and returns the resulting {edges, nodes} pair in the SOFIA / \
SubTropica convention. Usage: {edges, nodes} = FeynmanDraw. The returned pair \
can be passed directly to STIntegrate or visualized with FeynmanPlot."
    }], "TableText",ExpressionUUID->"a9a43a4f-9a90-4a63-b4a3-ba770b7e13a9"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Usage",
 CellID->1,ExpressionUUID->"1bee8b35-5c6a-45f0-8cb7-23d623977629"]
}, Open  ]],

Cell[CellGroupData[{

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"a400f8c2-fdc0-481e-a0f1-3efefe72d40e"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["FeynmanPlot",
   BaseStyle->"Link",
   ButtonData->"paclet:SubTropica/ref/FeynmanPlot"]], "InlineFormula",
  ExpressionUUID->"f8c9b41f-92ca-43af-ba83-082ab1795cce"],
 " \[EmptyVerySmallSquare] ",
 Cell[BoxData[
  ButtonBox["FeynmanIntegrate",
   BaseStyle->"Link",
   ButtonData->"paclet:SubTropica/ref/FeynmanIntegrate"]], "InlineFormula",
  ExpressionUUID->"5cc1c8b7-139b-4dfd-89b4-395f841c4c89"],
 " \[EmptyVerySmallSquare] ",
 Cell[BoxData[
  ButtonBox["STIntegrate",
   BaseStyle->"Link",
   ButtonData->"paclet:SubTropica/ref/STIntegrate"]], "InlineFormula",
  ExpressionUUID->"8896e6bc-6ee2-42d9-8cc2-3e2d9392149a"]
}], "SeeAlso",ExpressionUUID->"61f88f64-bcd6-4ed0-9cec-e68c5fcad10d"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[GridBox[{
