Notebook[{

Cell[CellGroupData[{
Cell["FeynmanDraw", "ObjectName",ExpressionUUID->"d8b09d4c-03df-4132-b4cf-b5600adcec0d"],

Cell[BoxData[GridBox[{
   {Cell[TextData[{
     StyleBox["FeynmanDraw", "TI"],
     " \[LineSeparator]FeynmanDraw opens an interactive canvas for drawing a \
Feynman diagram and returns the resulting {edges, nodes} pair in the SOFIA / \
SubTropica convention. Usage: {edges, nodes} = FeynmanDraw. The returned pair \
can be passed directly to STIntegrate or visualized with FeynmanPlot."
    }], "TableText",ExpressionUUID->"7f8b7965-9b52-4015-9771-403810a31b1e"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Usage",
 CellID->1,ExpressionUUID->"7bc64ad3-03a4-45c9-b4c0-4d055f6a8184"]
}, Open  ]],

Cell[CellGroupData[{

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"2ae77352-d32e-4abb-8562-cba4de1ea585"],

Cell[TextData[{
 Cell[BoxData[
  ButtonBox["FeynmanPlot",
   BaseStyle->"Link",
   ButtonData->"paclet:SubTropica/ref/FeynmanPlot"]], "InlineFormula",
  ExpressionUUID->"929b5dd2-9c5b-4273-8f6d-f884e93124c9"],
 " \[EmptyVerySmallSquare] ",
 Cell[BoxData[
  ButtonBox["FeynmanIntegrate",
   BaseStyle->"Link",
   ButtonData->"paclet:SubTropica/ref/FeynmanIntegrate"]], "InlineFormula",
  ExpressionUUID->"3f0f69e6-6259-4276-b2b2-fae5bb3a6a07"],
 " \[EmptyVerySmallSquare] ",
 Cell[BoxData[
  ButtonBox["STIntegrate",
   BaseStyle->"Link",
   ButtonData->"paclet:SubTropica/ref/STIntegrate"]], "InlineFormula",
  ExpressionUUID->"a57d614e-9db0-4902-9814-59ea2a7b04fe"]
}], "SeeAlso",ExpressionUUID->"5450f946-88d1-48f3-8c0b-970cca384835"]
}, Open  ]],

