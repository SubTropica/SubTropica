Cell["\<\
Numerically evaluate a Feynman integral with pySecDec at a numeric kinematic \
point, returning the eps-expansion coefficients with error estimates.  \
Requires pySecDec.\
\>", "ExampleText",ExpressionUUID->"200c4873-609f-4732-ab9b-9aaca5981ca6"],

Cell[BoxData[
 RowBox[{"ConfigureSubTropica", "[", 
  RowBox[{
  "PythonPath", " ", "->", " ", "\"\<.venvs/subtropica312/bin/python\>\""}], 
  "]"}]], "Input",ExpressionUUID->"e2972d27-22ab-4b56-afd4-ca01b4dae1e4"],

Cell[BoxData[
 RowBox[{"STToPySecDec", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"edges", ",", " ", "nodes"}], "}"}], ",", " ", 
   RowBox[{"\"\<KinematicPoint\>\"", " ", "->", " ", "kinematicPoint"}]}], 
  "]"}]], "Input",ExpressionUUID->"9b61187b-02b2-4418-892b-90fcb76e2080"]
}, Open  ]],

