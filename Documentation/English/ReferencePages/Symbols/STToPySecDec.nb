Cell["\<\
Numerically evaluate a Feynman integral with pySecDec at a numeric kinematic \
point, returning the eps-expansion coefficients with error estimates.  \
Requires pySecDec.\
\>", "ExampleText",ExpressionUUID->"7caaf04c-1fd5-49c4-a68a-682c0c032454"],

Cell[BoxData[
 RowBox[{"ConfigureSubTropica", "[", 
  RowBox[{
  "PythonPath", " ", "->", " ", "\"\<.venvs/subtropica312/bin/python\>\""}], 
  "]"}]], "Input",ExpressionUUID->"40bba737-07ba-4d14-a0c5-b0c9d5ec0a27"],

Cell[BoxData[
 RowBox[{"STToPySecDec", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"edges", ",", " ", "nodes"}], "}"}], ",", " ", 
   RowBox[{"\"\<KinematicPoint\>\"", " ", "->", " ", "kinematicPoint"}]}], 
  "]"}]], "Input",ExpressionUUID->"c8dae4a1-e239-4fb2-8094-e67340e4c2e6"]
}, Open  ]],

