Cell["\<\
Numerically evaluate a Feynman integral with pySecDec at a numeric kinematic \
point, returning the eps-expansion coefficients with error estimates.  \
Requires pySecDec.\
\>", "ExampleText",ExpressionUUID->"189c0b94-7eb1-4f60-8ad5-dc27bbb74181"],

Cell[BoxData[
 RowBox[{"ConfigureSubTropica", "[", 
  RowBox[{
  "PythonPath", " ", "->", " ", "\"\<.venvs/subtropica312/bin/python\>\""}], 
  "]"}]], "Input",ExpressionUUID->"326dcdf0-0c5c-4ff6-8c45-5525e229f9bd"],

Cell[BoxData[
 RowBox[{"STToPySecDec", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"edges", ",", " ", "nodes"}], "}"}], ",", " ", 
   RowBox[{"\"\<KinematicPoint\>\"", " ", "->", " ", "kinematicPoint"}]}], 
  "]"}]], "Input",ExpressionUUID->"758b2feb-6a3c-4257-b723-4c855ade6824"]
}, Open  ]],

