Notebook[{

Cell[CellGroupData[{
Cell["STToPySecDec", "ObjectName",ExpressionUUID->"de861408-ef29-4083-9de2-039afe7fdab2"],

Cell[BoxData[GridBox[{
   {Cell[TextData[{
     StyleBox["STToPySecDec[{edges, nodes}, opts]", "TI"],
     " \[LineSeparator]and"
    }], "TableText",ExpressionUUID->"476c03d2-1ad9-47b1-ae05-8697d2386908"]},
   {Cell[TextData[{
     StyleBox["STToPySecDec[{propagators}, opts]", "TI"],
     " \[LineSeparator]numerically evaluate a Feynman integral with pySecDec \
(numerical sector decomposition), returning the epsilon-expansion \
coefficients (a numerical value plus an error estimate per order). Requires a \
Python with pySecDec installed (point at it with \
ConfigureSubTropica[PythonPath -> ...]); numeric kinematics are supplied \
through the \"KinematicPoint\" option (a rule-list of Mandelstam / \
squared-mass values). Options include \"Order\", \"Dimension\", \"MaxEval\", \
\"Accuracy\", \"ContourDeformation\", and \"Integrator\". Usually reached \
indirectly via STNIntegrate[..., Method -> \"pySecDec\"] and STVerify; call \
it directly for low-level control of the pySecDec build."
    }], "TableText",ExpressionUUID->"9c5eed3c-3799-4972-9d84-76f4f90e10ec"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Usage",
 CellID->1,ExpressionUUID->"bb65ff8a-11cd-422a-a15b-8348111a949d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Options", "OptionsSection",ExpressionUUID->"b0906b74-072a-4aef-82ee-d3310ffe1ddf"],

Cell[BoxData[GridBox[{
   {"\"\<Order\>\"", "0", 
    RowBox[{
     RowBox[{"highest", " ", "\[CurlyEpsilon]"}], "-", 
     RowBox[{"order", " ", "to", " ", "compute"}]}]},
   {"\"\<Accuracy\>\"", 
    RowBox[{"1", "/", "10000"}], 
    RowBox[{
    "target", " ", "relative", " ", "accuracy", " ", "for", " ", "the", " ", 
     "integrator"}]},
   {"\"\<MaxEval\>\"", 
    RowBox[{"10", "^", "7"}], 
    RowBox[{"maximum", " ", "integrand", " ", "evaluations"}]},
   {"\"\<KinematicPoint\>\"", 
    RowBox[{"{", "}"}], 
    RowBox[{
    "rules", " ", "giving", " ", "numeric", " ", "values", " ", "for", " ", 
     "every", " ", 
     RowBox[{"Mandelstam", " ", "/", " ", "squared"}], " ", "mass", " ", 
     RowBox[{"(", "required", ")"}]}]},
   {"\"\<Verbose\>\"", "False", 
    RowBox[{"echo", " ", "the", " ", "generated", " ", "pySecDec", " ", 
     RowBox[{"build", "/", "run"}]}]},
   {"\"\<ContourDeformation\>\"", "True", 
    RowBox[{"enable", " ", "contour", " ", "deformation", " ", 
     RowBox[{"(", 
      RowBox[{"needed", " ", "for", " ", 
       RowBox[{"physical", "/", "complex"}], " ", "kinematics"}], ")"}]}]},
   {"\"\<CacheDirectory\>\"", "Automatic", 
    RowBox[{"directory", " ", "for", " ", "the", " ", 
     RowBox[{"generated", "/", "compiled"}], " ", "pySecDec", " ", 
     "library"}]},
   {"\"\<Normalization\>\"", "Automatic", 
    RowBox[{"overall", " ", "prefactor", " ", "convention"}]},
   {"\"\<Dimension\>\"", 
    RowBox[{"4", " ", "-", " ", 
     RowBox[{"2", " ", "eps"}]}], 
    RowBox[{"spacetime", " ", "dimension"}]},
   {"\"\<Exponents\>\"", "Automatic", 
    RowBox[{"propagator", " ", "exponents", " ", 
     RowBox[{"(", 
      RowBox[{"non", "-", 
       RowBox[{"unit", " ", 
        RowBox[{"powers", " ", "/", " ", "numerators"}]}]}], ")"}]}]},
   {"\"\<LoopMomenta\>\"", "Automatic", 
    RowBox[{"loop", "-", 
     RowBox[{"momentum", " ", "labels", " ", 
      RowBox[{"(", 
       RowBox[{"propagator", " ", "form"}], ")"}]}]}]},
   {"\"\<Substitutions\>\"", 
    RowBox[{"{", "}"}], 
    RowBox[{
    "symbolic", " ", "replacements", " ", "applied", " ", "before", " ", 
     "building"}]},
   {"\"\<Integrator\>\"", "\"\<Qmc\>\"", 
    RowBox[{
     RowBox[{"integration", " ", 
      RowBox[{"algorithm", ":", " ", "Qmc"}]}], ",", " ", "Disteval", ",", 
     " ", 
     RowBox[{"or", " ", "Vegas"}]}]},
   {"\"\<MaxTime\>\"", "Automatic", 
    RowBox[{
     RowBox[{"wall", "-", 
      RowBox[{"clock", " ", "cap", " ", 
       RowBox[{"(", "s", ")"}], " ", "on", " ", "the", " ", "Python", " ", 
       "subprocess"}]}], ";", " ", 
     RowBox[{"Infinity", " ", "disables"}]}]},
   {"\"\<Homogenize\>\"", "Automatic", 
    RowBox[{"Euler", "-", 
     RowBox[{"quadruple", " ", 
      RowBox[{"route", ":", " ", 
       RowBox[{
       "Automatic", " ", "homogenizes", " ", "iff", " ", "the", " ", 
        "integrand", " ", "is", " ", "inhomogeneous"}]}]}]}]}
  },
  GridBoxAlignment->{"Columns" -> {Left, Left, Left}},
  GridBoxDividers->{"Rows" -> {True, {False}, True}}]], "OptionsTable",Express\
ionUUID->"6c3227ac-8510-4535-ab18-eb600ce2050e"]
}, Open  ]],

