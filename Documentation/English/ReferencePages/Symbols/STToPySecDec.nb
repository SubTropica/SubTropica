Cell["\<\
Numerically evaluate a Feynman integral with pySecDec at a numeric kinematic \
point, returning the eps-expansion coefficients with error estimates.  \
Requires pySecDec.\
\>", "ExampleText",ExpressionUUID->"c357db33-3878-47e5-8e18-4cf0f1ea3006"],

Cell[BoxData[
 RowBox[{"ConfigureSubTropica", "[", 
  RowBox[{
  "PythonPath", " ", "->", " ", "\"\<.venvs/subtropica312/bin/python\>\""}], 
  "]"}]], "Input",ExpressionUUID->"9dbfe695-3046-41aa-a02d-35dd3dccba8d"],

Cell[BoxData[
 RowBox[{"STToPySecDec", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"edges", ",", " ", "nodes"}], "}"}], ",", " ", 
   RowBox[{"\"\<KinematicPoint\>\"", " ", "->", " ", "kinematicPoint"}]}], 
  "]"}]], "Input",ExpressionUUID->"796513e4-9004-4b54-984f-2c63ce3eb828"]
}, Open  ]],

