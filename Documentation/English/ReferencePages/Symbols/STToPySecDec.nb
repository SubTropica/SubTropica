Cell["\<\
Numerically evaluate a Feynman integral with pySecDec at a numeric kinematic \
point, returning the eps-expansion coefficients with error estimates.  \
Requires pySecDec.\
\>", "ExampleText",ExpressionUUID->"514b1f15-ef7d-4b22-b877-2e675db495f6"],

Cell[BoxData[
 RowBox[{"ConfigureSubTropica", "[", 
  RowBox[{
  "PythonPath", " ", "->", " ", "\"\<.venvs/subtropica312/bin/python\>\""}], 
  "]"}]], "Input",ExpressionUUID->"cd99ef2c-a1ea-42ac-b7e6-2b8a0c54a288"],

Cell[BoxData[
 RowBox[{"STToPySecDec", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"edges", ",", " ", "nodes"}], "}"}], ",", " ", 
   RowBox[{"\"\<KinematicPoint\>\"", " ", "->", " ", "kinematicPoint"}]}], 
  "]"}]], "Input",ExpressionUUID->"39a4da7c-0a66-4881-8084-1d2e64f2f4ec"]
}, Open  ]],

