Notebook[{

Cell[CellGroupData[{
Cell["STBuildFactorTable", "ObjectName",ExpressionUUID->"4272e767-c750-40cc-9f98-516a8f3830c3"],

Cell[BoxData[GridBox[{
   {Cell[TextData[{
     StyleBox["STBuildFactorTable[polys, \"Order\" -> {x1, ...}]", "TI"],
     " \[LineSeparator]builds the factor-prediction table for the Fubini \
reduction along the given LR order via HyperFLINT's factor_table op. `polys` \
is a flat list or list-of-lists (groups, matching STFindLROrdersHF's \
convention). The integration variables are exactly the entries of \"Order\"; \
remaining symbols are kinematic parameters. Returns the table Association and \
installs it as the kernel-global default $STFactorPredictorTable (NOT cleared \
by STResetKernelCaches). All factorizations are over Q; the table is faithful \
to HyperIntica integration only when $HyperSplittingField is trivial. NOTE: \
TimeConstrained cannot abort the in-process LibraryLink call (the singleton \
fallback factorization is the most likely hang site); the CLI transport is \
abortable. SCOPE OF THE HYGIENE GUARANTEE: the clean scope protects the HF \
response parse and the table assembly; the INPUT polynomials are evaluated at \
the call boundary like any Mathematica arguments, so kinematic variables must \
be unassigned at build time (a session assignment m = 5 silently bakes 5 into \
the input letters before STBuildFactorTable runs)."
    }], "TableText",ExpressionUUID->"3360e4b2-c2cb-48a1-9040-785d6dea0b9e"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Usage",
 CellID->1,ExpressionUUID->"0876b7bf-dbdb-4752-ab65-869175dac6eb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Options", "OptionsSection",ExpressionUUID->"c07f9eec-02a3-4bfc-a4c7-640f50f7f2cf"],

Cell[BoxData[GridBox[{
   {"\"\<Order\>\"", "Automatic", 
    RowBox[{
     RowBox[{
      RowBox[{"the", " ", "linear"}], "-", 
      RowBox[{"reducibility", " ", "integration", " ", "order", " ", 
       RowBox[{"(", 
        RowBox[{"list", " ", "of", " ", "distinct", " ", "symbols"}], 
        ")"}]}]}], ";", " ", "required"}]},
   {"\"\<FindRoots\>\"", "False", 
    RowBox[{"emit", " ", "algebraic", " ", 
     RowBox[{"(", 
      RowBox[{"square", "-", "root"}], ")"}], " ", "letters", " ", "into", " ",
      "the", " ", "table"}]},
   {"\"\<TimeConstraint\>\"", "1800", 
    RowBox[{"soft", " ", "time", " ", "cap", " ", 
     RowBox[{"(", "s", ")"}], " ", "on", " ", "the", " ", "table", " ", 
     "build"}]},
   {"\"\<Threads\>\"", "Automatic", 
    RowBox[{"HyperFLINT", " ", "worker", " ", "threads"}]},
   {"\"\<MaxPairs\>\"", "2000000", 
    RowBox[{"cap", " ", "on", " ", "stored", " ", "pair", " ", 
     RowBox[{"(", "resultant", ")"}], " ", "entries"}]},
   {"\"\<MaxSingletons\>\"", "200000", 
    RowBox[{"cap", " ", "on", " ", "stored", " ", "singleton", " ", 
     RowBox[{"(", "letter", ")"}], " ", "entries"}]},
   {"\"\<MaxResponseMB\>\"", "512", 
    RowBox[{"cap", " ", 
     RowBox[{"(", "MB", ")"}], " ", "on", " ", "the", " ", "HyperFLINT", " ", 
     "response", " ", "size"}]}
  },
  GridBoxAlignment->{"Columns" -> {Left, Left, Left}},
  GridBoxDividers->{"Rows" -> {True, {False}, True}}]], "OptionsTable",Express\
ionUUID->"dcb798a8-3ead-4943-a27e-bb05a50765a5"]
}, Open  ]],

