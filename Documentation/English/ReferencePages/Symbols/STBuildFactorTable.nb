Cell[BoxData[
 InterpretationBox[GridBox[{
    {
     StyleBox[
      RowBox[{"Basic", " ", "Examples"}], "PrimaryExamplesSection"], 
     ButtonBox[
      RowBox[{
       RowBox[{"More", " ", "Examples"}], " ", "\[RightTriangle]"}],
      BaseStyle->"ExtendedExamplesLink",
      ButtonData:>"ExtendedExamples"]}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"f721ba2f-6b8a-\
4c76-a392-c96469bbf9b4"],

Cell["\<\
Build the factor-prediction table for the Fubini reduction along the given \
order (via HyperFLINT) and install it as $STFactorPredictorTable; the \
reduce-time denominators over x are {s, t, s-t}.  Kinematic symbols must be \
unassigned at call time.\
\>", "ExampleText",ExpressionUUID->"373e88e6-034e-4ad0-8e01-328c807094b0"],

Cell[BoxData[
 RowBox[{"STBuildFactorTable", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"s", " ", "x"}], " ", "+", " ", "1"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"t", " ", "x"}], " ", "+", " ", "1"}], ")"}]}], "}"}], ",", 
   " ", 
   RowBox[{"\"\<Order\>\"", " ", "->", " ", 
    RowBox[{"{", "x", "}"}]}]}], "]"}]], "Input",ExpressionUUID->"289e14c0-\
4ec4-4fed-8776-f17c0c9e8711"]
}, Open  ]],

