      ButtonData:>"ExtendedExamples"]}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"35e44c11-51fd-\
4258-a7e2-7ea6f4b99eb8"],

Cell["\<\
Build the factor-prediction table for the Fubini reduction along the given \
order (via HyperFLINT) and install it as $STFactorPredictorTable; the \
reduce-time denominators over x are {s, t, s-t}.  Kinematic symbols must be \
unassigned at call time.\
\>", "ExampleText",ExpressionUUID->"6fe4df79-76dd-4b40-9a43-38a0b3e447aa"],

Cell[BoxData[
 RowBox[{"STBuildFactorTable", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"s", " ", "x"}], " ", "+", " ", "1"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"t", " ", "x"}], " ", "+", " ", "1"}], ")"}]}], "}"}], ",", 
   " ", 
   RowBox[{"\"\<Order\>\"", " ", "->", " ", 
    RowBox[{"{", "x", "}"}]}]}], "]"}]], "Input",ExpressionUUID->"ebc0de4f-\
b33a-49f0-aa1d-d0564c12d279"]
}, Open  ]],

