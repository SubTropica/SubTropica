       RowBox[{"More", " ", "Examples"}], " ", "\[RightTriangle]"}],
      BaseStyle->"ExtendedExamplesLink",
      ButtonData:>"ExtendedExamples"]}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"986b3f2e-899b-\
44ed-ba04-f3cfd7bdc474"],

Cell["\<\
Build the factor-prediction table for the Fubini reduction along the given \
order (via HyperFLINT) and install it as $STFactorPredictorTable; the \
reduce-time denominators over x are {s, t, s-t}.  Kinematic symbols must be \
unassigned at call time.\
\>", "ExampleText",ExpressionUUID->"772c268c-fadf-42f0-a774-faf01b6d7994"],

Cell[BoxData[
 RowBox[{"STBuildFactorTable", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"s", " ", "x"}], " ", "+", " ", "1"}], ")"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"t", " ", "x"}], " ", "+", " ", "1"}], ")"}]}], "}"}], ",", 
   " ", 
   RowBox[{"\"\<Order\>\"", " ", "->", " ", 
    RowBox[{"{", "x", "}"}]}]}], "]"}]], "Input",ExpressionUUID->"a2e39e50-\
7c37-44ab-8b23-000db185f7f3"]
}, Open  ]],

