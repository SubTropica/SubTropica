Cell["\<\
Integrate over [0,1]^2 and clean up to MZVs; here the result is (Log 2)^2.  \
HyperIntica returns a combination of multiple zeta values; the in-process \
period reduction runs best from a notebook front end.\
\>", "ExampleText",ExpressionUUID->"5545701e-db95-456d-90b3-155c5798aaa4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HyperIntica", "[", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", "x"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", "y"}], ")"}]}], ")"}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"y", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}], " ", "//", 
  " ", "CleanZeroInf"}]], "Input",ExpressionUUID->"39773379-9768-41cd-b05d-\
462b857549bc"]
}, Open  ]],

