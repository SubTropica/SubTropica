Cell["\<\
Integrate over [0,1]^2 and clean up to MZVs; here the result is (Log 2)^2.  \
HyperIntica returns a combination of multiple zeta values; the in-process \
period reduction runs best from a notebook front end.\
\>", "ExampleText",ExpressionUUID->"c67dece0-58f4-422d-85ad-3cdf28ffbb1b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HyperIntica", "[", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", "x"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", "y"}], ")"}]}], ")"}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"y", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}], " ", "//", 
  " ", "CleanZeroInf"}]], "Input",ExpressionUUID->"541bb072-558d-493d-9be7-\
3440d0312144"]
}, Open  ]],

