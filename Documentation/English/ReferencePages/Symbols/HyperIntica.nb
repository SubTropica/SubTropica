Cell["\<\
Integrate over [0,1]^2 and clean up to MZVs; here the result is (Log 2)^2.  \
HyperIntica returns a combination of multiple zeta values; the in-process \
period reduction runs best from a notebook front end.\
\>", "ExampleText",ExpressionUUID->"d45890c6-a76d-4c05-932b-87b8fdf8fd87"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HyperIntica", "[", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", "x"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", "y"}], ")"}]}], ")"}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"y", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}], " ", "//", 
  " ", "CleanZeroInf"}]], "Input",ExpressionUUID->"7449b78e-d95f-4122-9ef6-\
b23f8603ae39"]
}, Open  ]],

