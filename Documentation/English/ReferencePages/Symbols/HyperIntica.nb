Cell["\<\
Integrate over [0,1]^2 and clean up to MZVs; here the result is (Log 2)^2.  \
HyperIntica returns a combination of multiple zeta values; the in-process \
period reduction runs best from a notebook front end.\
\>", "ExampleText",ExpressionUUID->"82b83fb7-9482-4064-b406-56949265fca7"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HyperIntica", "[", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", "x"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", "y"}], ")"}]}], ")"}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"y", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}], " ", "//", 
  " ", "CleanZeroInf"}]], "Input",ExpressionUUID->"49943987-4b4d-46e8-96d9-\
6fa4c262342e"]
}, Open  ]],

