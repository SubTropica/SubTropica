Cell["\<\
Integrate over [0,1]^2 and clean up to MZVs; here the result is (Log 2)^2.  \
HyperIntica returns a combination of multiple zeta values; the in-process \
period reduction runs best from a notebook front end.\
\>", "ExampleText",ExpressionUUID->"5aa7f155-0a4e-449b-b67e-c7089c5626de"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HyperIntica", "[", 
   RowBox[{
    RowBox[{"1", "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", "x"}], ")"}], " ", 
       RowBox[{"(", 
        RowBox[{"1", " ", "+", " ", "y"}], ")"}]}], ")"}]}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"x", ",", " ", "0", ",", " ", "1"}], "}"}], ",", " ", 
    RowBox[{"{", 
     RowBox[{"y", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}], " ", "//", 
  " ", "CleanZeroInf"}]], "Input",ExpressionUUID->"8ef6b837-bb32-41d7-97a6-\
333c9dec1997"]
}, Open  ]],

