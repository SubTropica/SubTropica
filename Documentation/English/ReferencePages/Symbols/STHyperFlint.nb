Cell["\<\
Evaluate the Euler integral over [0,Infinity) with the HyperFLINT engine; \
here the result is Log[2].  The in-process integrator runs best from a \
notebook front end.\
\>", "ExampleText",ExpressionUUID->"1a5d140e-591c-40c2-b811-ae3d6bc5cd2d"],

Cell[BoxData[
 RowBox[{"STHyperFlint", "[", 
  RowBox[{
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", " ", "+", " ", "x1"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"2", " ", "+", " ", "x1"}], ")"}]}], ")"}]}], ",", " ", 
   RowBox[{"{", "x1", "}"}]}], "]"}]], "Input",ExpressionUUID->"d7af28d9-912c-\
494c-aba3-c8608ac72112"]
}, Open  ]],

