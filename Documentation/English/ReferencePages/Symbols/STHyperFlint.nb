Cell["\<\
Evaluate the Euler integral over [0,Infinity) with the HyperFLINT engine; \
here the result is Log[2].  The in-process integrator runs best from a \
notebook front end.\
\>", "ExampleText",ExpressionUUID->"117c13aa-53e1-4bd1-b81c-d496f7ff9de7"],

Cell[BoxData[
 RowBox[{"STHyperFlint", "[", 
  RowBox[{
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", " ", "+", " ", "x1"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"2", " ", "+", " ", "x1"}], ")"}]}], ")"}]}], ",", " ", 
   RowBox[{"{", "x1", "}"}]}], "]"}]], "Input",ExpressionUUID->"47dcdf2b-6b3e-\
40f5-8967-52e0e868ccbf"]
}, Open  ]],

