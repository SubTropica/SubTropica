Cell["\<\
Evaluate the Euler integral over [0,Infinity) with the HyperFLINT engine; \
here the result is Log[2].  The in-process integrator runs best from a \
notebook front end.\
\>", "ExampleText",ExpressionUUID->"509ceac1-c0ef-43a0-8319-e0d3bbf4b587"],

Cell[BoxData[
 RowBox[{"STHyperFlint", "[", 
  RowBox[{
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", " ", "+", " ", "x1"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"2", " ", "+", " ", "x1"}], ")"}]}], ")"}]}], ",", " ", 
   RowBox[{"{", "x1", "}"}]}], "]"}]], "Input",ExpressionUUID->"08af03e8-168f-\
4207-9db1-635b8b7445ab"]
}, Open  ]],

