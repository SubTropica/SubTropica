Notebook[{

Cell[CellGroupData[{
Cell["STHyperFlint", "ObjectName",ExpressionUUID->"ed234656-490f-4db4-98fe-e54502b09aea"],

Cell[BoxData[GridBox[{
   {Cell[TextData[{
     StyleBox["STHyperFlint[integrand, {x1, ..., xn}]", "TI"],
     " \[LineSeparator]evaluates the Euler integral over [0, \\[Infinity])^n \
analytically with the HyperFLINT engine (a C++17/FLINT reimplementation of \
the HyperIntica hyperlogarithm algorithm). Returns the same symbolic form \
HyperInt[integrand, {x1, ..., xn}] produces on convergent inputs. The default \
transport is the in-process LibraryLink dylib (whose hf_version must equal \
$SubTropicaVersion); the CLI subprocess transport is disabled by default \
($STHyperFlintAllowCLI = False) and is used only on parallel subkernels or \
when explicitly enabled. Check $HyperFLINTAvailable to see whether the engine \
is usable. SimplifyOutput (default True) post-processes the result; \
SimplifyOutput -> False returns the unreduced factored form quickly. \
Rationalize -> Automatic | True | False is the root-handling umbrella (it \
supersedes the deprecated Carry); on this single-integrand primitive \
Automatic leaves the Euler-rationalization rung OFF, so use STIntegrate / \
STIntegrateHF for the full strict -> FindRoots -> rationalize escalation. \
CheckDivergences is armed in hard mode here (a detection fails with \
STHyperFlint::divergent). IntegrationOrder -> {x1, ..., xn} (a permutation of \
the supplied variables) reorders the integration before the call (the \
variable list is otherwise itself the order); the per-face rule-list form is \
ignored on this single-integrand leaf. For verified per-face pinning use \
STIntegrate / STIntegrateHF."
    }], "TableText",ExpressionUUID->"565b5c8b-70cb-4a7e-84b6-361096a87834"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Usage",
 CellID->1,ExpressionUUID->"6bc38a35-e9da-49a4-bebf-d31893e326b3"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Options", "OptionsSection",ExpressionUUID->"fe1cd45e-4dfc-42a7-a745-1947da930cf0"],

Cell[BoxData[GridBox[{
   {"\"\<CheckDivergences\>\"", "Automatic", 
    RowBox[{
     RowBox[{
      RowBox[{"Automatic", " ", "arms", " ", "the", " ", "boundary"}], "-", 
      RowBox[{
      "divergence", " ", "scan", " ", "on", " ", "standalone", " ", "calls", " ", 
       RowBox[{"(", 
        RowBox[{
        "fails", " ", "on", " ", "a", " ", "divergent", " ", "integrand"}], 
        ")"}]}]}], ";", " ", 
     RowBox[{
      RowBox[{"True", "/", "False"}], " ", "override"}]}]},
   {"\"\<FindRoots\>\"", "Automatic", 
    RowBox[{
     RowBox[{
      RowBox[{"True", " ", "factors", " ", "degree"}], "-", 
      RowBox[{"2", " ", "letters", " ", "into", " ", "algebraic", " ", 
       RowBox[{"Wm", "/", "Wp"}], " ", "pairs"}]}], ";", " ", 
     RowBox[{
     "Automatic", " ", "defers", " ", "to", " ", "the", " ", "package", " ", 
      "setting"}], ";", " ", 
     RowBox[{"False", " ", "keeps", " ", "none"}]}]},
   {"\"\<SimplifyOutput\>\"", "True", 
    RowBox[{
     RowBox[{"True", " ", "returns", " ", "the", " ", 
      RowBox[{"reduced", "/", "canonical"}], " ", "result"}], ";", " ", 
     RowBox[{
     "False", " ", "returns", " ", "the", " ", "unreduced", " ", "factored", " ",
       "form", " ", "quickly", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"rational", " ", "single"}], "-", 
        RowBox[{"pole", " ", "integrands"}]}], ")"}]}]}]},
   {"\"\<Rationalize\>\"", "Automatic", 
    RowBox[{
     RowBox[{"root", "-", 
      RowBox[{"handling", " ", "umbrella"}]}], ";", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"on", " ", "this", " ", "single"}], "-", 
       RowBox[{"integrand", " ", "leaf", " ", "Automatic"}]}], " ", "=", " ", 
      
      RowBox[{"off", " ", 
       RowBox[{"(", 
        RowBox[{
        "use", " ", "STIntegrate", " ", "for", " ", "the", " ", "full", " ", 
         "escalation"}], ")"}]}]}]}]},
   {"\"\<EulerFilter\>\"", "False", 
    RowBox[{
    "accepted", " ", "for", " ", "API", " ", "symmetry", " ", "but", " ", 
     "inert", " ", "here", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"this", " ", "leaf", " ", "runs", " ", "no", " ", "linear"}], "-", 
       RowBox[{"reducibility", " ", "search"}]}], ")"}]}]},
   {"\"\<IntegrationOrder\>\"", "None", 
    RowBox[{
     RowBox[{
     "None", " ", "uses", " ", "the", " ", "given", " ", "variable", " ", 
      "list", " ", "as", " ", "the", " ", "order"}], ";", " ", 
     RowBox[{
     "a", " ", "global", " ", "permutation", " ", "reorders", " ", "before", " ",
       "integration"}]}]},
   {"\"\<IntegrationOrderVerify\>\"", "False", 
    RowBox[{
    "inert", " ", "on", " ", "this", " ", "direct", " ", "leaf", " ", 
     RowBox[{"(", 
      RowBox[{"the", " ", "order", " ", "is", " ", "trusted"}], ")"}]}]}
  },
  GridBoxAlignment->{"Columns" -> {Left, Left, Left}},
  GridBoxDividers->{"Rows" -> {True, {False}, True}}]], "OptionsTable",Express\
ionUUID->"b717356a-67d4-4a61-842c-e12938514c53"]
}, Open  ]],

