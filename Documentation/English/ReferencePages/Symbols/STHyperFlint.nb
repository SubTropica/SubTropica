Cell["\<\
Evaluate the Euler integral over [0,Infinity) with the HyperFLINT engine; \
here the result is Log[2].  The in-process integrator runs best from a \
notebook front end.\
\>", "ExampleText",ExpressionUUID->"8be2a758-1eb8-4c69-90b5-c7f2b7599612"],

Cell[BoxData[
 RowBox[{"STHyperFlint", "[", 
  RowBox[{
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", " ", "+", " ", "x1"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"2", " ", "+", " ", "x1"}], ")"}]}], ")"}]}], ",", " ", 
   RowBox[{"{", "x1", "}"}]}], "]"}]], "Input",ExpressionUUID->"a8a8c9df-bdb1-\
4401-9516-1081fd9caf9e"]
}, Open  ]],

