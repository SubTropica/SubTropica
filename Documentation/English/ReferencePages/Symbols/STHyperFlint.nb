Cell["\<\
Evaluate the Euler integral over [0,Infinity) with the HyperFLINT engine; \
here the result is Log[2].  The in-process integrator runs best from a \
notebook front end.\
\>", "ExampleText",ExpressionUUID->"a4ed52e1-eb94-41bf-9b68-4339f39c7970"],

Cell[BoxData[
 RowBox[{"STHyperFlint", "[", 
  RowBox[{
   RowBox[{"1", "/", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", " ", "+", " ", "x1"}], ")"}], " ", 
      RowBox[{"(", 
       RowBox[{"2", " ", "+", " ", "x1"}], ")"}]}], ")"}]}], ",", " ", 
   RowBox[{"{", "x1", "}"}]}], "]"}]], "Input",ExpressionUUID->"9d964981-de04-\
4357-9f95-8ae0570069ae"]
}, Open  ]],

