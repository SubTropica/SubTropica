Notebook[{

Cell[CellGroupData[{
Cell["STFactor", "ObjectName",ExpressionUUID->"50f9e17e-36a0-40fc-894b-ab030a3ca62b"],

Cell[BoxData[GridBox[{
   {Cell[TextData[{
     StyleBox["STFactor", "TI"],
     " \[LineSeparator], x_i \[RightArrow] x_i/\[Lambda] for each component \
\\rho_i > 0) and then apply STFactor to the result."
    }], "TableText",ExpressionUUID->"420b2f44-deea-40a9-b858-89616b8e465c"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Usage",
 CellID->1,ExpressionUUID->"93d81ae4-ed5c-4b72-aed5-da1d9cbaea85"],

Cell["\<\
STFactor factorizes products inside powers that depend on \[CurlyEpsilon]: it \
splits (a\[CenterDot] b)^{c\[CurlyEpsilon]+d} into a^{c\[CurlyEpsilon]+d}\\, \
b^{c\[CurlyEpsilon]+d} whenever one of the factors is manifestly positive for \
positive integration variables: (see example below) A typical usage is to \
rescale the integration variables along a ray \\rho of the Newton polytope \
(e.g., x_i \[RightArrow] x_i/\[Lambda] for each component \\rho_i > 0) and \
then apply STFactor to the result. The factorized form makes the \
\[Lambda]-dependence explicit, revealing whether the integrand diverges or \
converges along that ray.\
\>", "Notes",ExpressionUUID->"84a8b2ca-3eea-4e73-934c-2b0a5572d603"],

Cell[BoxData[
 RowBox[{"STFactor", "[", "expression", "]"}]], "Input",ExpressionUUID->"b122af3c-18dd-4ca1-aef0-898d1199c467"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[GridBox[{
    {
     StyleBox[
      RowBox[{"Basic", " ", "Examples"}], "PrimaryExamplesSection"], 
     ButtonBox[
      RowBox[{
       RowBox[{"More", " ", "Examples"}], " ", "\[RightTriangle]"}],
      BaseStyle->"ExtendedExamplesLink",
      ButtonData:>"ExtendedExamples"]}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"9cc638e4-9d7b-\
4dde-a4fa-698d4d1b7649"],

Cell["Split (a b)^eps into a^eps b^eps across positive factors.", \
"ExampleText",ExpressionUUID->"a97763e6-01c0-4f7d-8251-d0eab6e65632"],

Cell[BoxData[
 RowBox[{"STFactor", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"x1", " ", "+", " ", "x2"}], ")"}], " ", "x3"}], ")"}], "^", 
   "eps"}], "]"}]], "Input",ExpressionUUID->"b6de9146-c045-40e5-b0ca-\
2594305840a9"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"x1", "+", "x2"}], ")"}], "eps"], " ", 
  SuperscriptBox["x3", "eps"]}]], "Output",ExpressionUUID->"83e6fc16-06e4-\
4b58-9ecc-23e3812124c2"]
}, Open  ]],

