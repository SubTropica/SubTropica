Notebook[{

Cell[CellGroupData[{
Cell["STFactor", "ObjectName",ExpressionUUID->"cf0c5e6e-c465-444c-98a1-d8d8a3513a48"],

Cell[BoxData[GridBox[{
   {Cell[TextData[{
     StyleBox["STFactor", "TI"],
     " \[LineSeparator], x_i \[RightArrow] x_i/\[Lambda] for each component \
\\rho_i > 0) and then apply STFactor to the result."
    }], "TableText",ExpressionUUID->"adbaa563-0e90-4749-bd7c-30ad21116b5c"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Usage",
 CellID->1,ExpressionUUID->"feed7ad7-9b0f-4597-9300-83254afa7262"],

Cell["\<\
STFactor factorizes products inside powers that depend on \[CurlyEpsilon]: it \
splits (a\[CenterDot] b)^{c\[CurlyEpsilon]+d} into a^{c\[CurlyEpsilon]+d}\\, \
b^{c\[CurlyEpsilon]+d} whenever one of the factors is manifestly positive for \
positive integration variables: (see example below) A typical usage is to \
rescale the integration variables along a ray \\rho of the Newton polytope \
(e.g., x_i \[RightArrow] x_i/\[Lambda] for each component \\rho_i > 0) and \
then apply STFactor to the result. The factorized form makes the \
\[Lambda]-dependence explicit, revealing whether the integrand diverges or \
converges along that ray.\
\>", "Notes",ExpressionUUID->"bbfb4e9a-87be-4679-abe9-b4af28b7756d"],

Cell[BoxData[
 RowBox[{"STFactor", "[", "expression", "]"}]], "Input",ExpressionUUID->"203b2d8d-7847-4581-b15d-4ae4aae3b53a"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[GridBox[{
    {
     StyleBox[
      RowBox[{"Basic", " ", "Examples"}], "PrimaryExamplesSection"], 
     ButtonBox[
      RowBox[{
       RowBox[{"More", " ", "Examples"}], " ", "\[RightTriangle]"}],
      BaseStyle->"ExtendedExamplesLink",
      ButtonData:>"ExtendedExamples"]}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"99fa5a53-11c0-\
4f23-8282-8dfc7618e89f"],

Cell["Split (a b)^eps into a^eps b^eps across positive factors.", \
"ExampleText",ExpressionUUID->"e3361295-19f6-4ca4-97d8-384266f20f66"],

Cell[BoxData[
 RowBox[{"STFactor", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"x1", " ", "+", " ", "x2"}], ")"}], " ", "x3"}], ")"}], "^", 
   "eps"}], "]"}]], "Input",ExpressionUUID->"65d9ce64-7156-47a3-aceb-\
2fa2b3e716df"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"x1", "+", "x2"}], ")"}], "eps"], " ", 
  SuperscriptBox["x3", "eps"]}]], "Output",ExpressionUUID->"a36ec457-5290-\
4143-b4bc-c57a5cd4f349"]
}, Open  ]],

