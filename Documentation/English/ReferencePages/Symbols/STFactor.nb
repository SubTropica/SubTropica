Notebook[{

Cell[CellGroupData[{
Cell["STFactor", "ObjectName",ExpressionUUID->"69772dbe-bed8-4b4e-9391-6aa0fc756fc6"],

Cell[BoxData[GridBox[{
   {Cell[TextData[{
     StyleBox["STFactor", "TI"],
     " \[LineSeparator], x_i \[RightArrow] x_i/\[Lambda] for each component \
\\rho_i > 0) and then apply STFactor to the result."
    }], "TableText",ExpressionUUID->"a2a94d97-4d25-428b-93c9-a55f19ea2fbb"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Usage",
 CellID->1,ExpressionUUID->"3123fe45-bc98-430c-aded-8db5cb9bcf8a"],

Cell["\<\
STFactor factorizes products inside powers that depend on \[CurlyEpsilon]: it \
splits (a\[CenterDot] b)^{c\[CurlyEpsilon]+d} into a^{c\[CurlyEpsilon]+d}\\, \
b^{c\[CurlyEpsilon]+d} whenever one of the factors is manifestly positive for \
positive integration variables: (see example below) A typical usage is to \
rescale the integration variables along a ray \\rho of the Newton polytope \
(e.g., x_i \[RightArrow] x_i/\[Lambda] for each component \\rho_i > 0) and \
then apply STFactor to the result. The factorized form makes the \
\[Lambda]-dependence explicit, revealing whether the integrand diverges or \
converges along that ray.\
\>", "Notes",ExpressionUUID->"f81628e6-001c-4e53-90ca-596c5480729e"],

Cell[BoxData[
 RowBox[{"STFactor", "[", "expression", "]"}]], "Input",ExpressionUUID->"7af3c9b2-7236-453b-99b3-59273a3bc5d4"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[GridBox[{
    {
     StyleBox[
      RowBox[{"Basic", " ", "Examples"}], "PrimaryExamplesSection"], 
     ButtonBox[
      RowBox[{
       RowBox[{"More", " ", "Examples"}], " ", "\[RightTriangle]"}],
      BaseStyle->"ExtendedExamplesLink",
      ButtonData:>"ExtendedExamples"]}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"b34abe47-487e-\
4e7d-a949-e45026b7dcd1"],

Cell["Split (a b)^eps into a^eps b^eps across positive factors.", \
"ExampleText",ExpressionUUID->"91917a20-303d-4d8f-9fdb-02448cc5115b"],

Cell[BoxData[
 RowBox[{"STFactor", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"x1", " ", "+", " ", "x2"}], ")"}], " ", "x3"}], ")"}], "^", 
   "eps"}], "]"}]], "Input",ExpressionUUID->"d56d8a8f-8d39-49ab-8504-\
dfda7eef6cba"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"x1", "+", "x2"}], ")"}], "eps"], " ", 
  SuperscriptBox["x3", "eps"]}]], "Output",ExpressionUUID->"d751109b-8f9f-\
4abc-acb0-67fe65c7f903"]
}, Open  ]],

