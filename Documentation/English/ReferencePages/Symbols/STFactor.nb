Notebook[{

Cell[CellGroupData[{
Cell["STFactor", "ObjectName",ExpressionUUID->"74619314-dfb6-499b-962c-f23fdf92b88d"],

Cell[BoxData[GridBox[{
   {Cell[TextData[{
     StyleBox["STFactor", "TI"],
     " \[LineSeparator], x_i \[RightArrow] x_i/\[Lambda] for each component \
\\rho_i > 0) and then apply STFactor to the result."
    }], "TableText",ExpressionUUID->"d9b3fbed-5742-4f8c-95c9-6c9b4e47935d"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Usage",
 CellID->1,ExpressionUUID->"06c97a85-136b-43d5-862f-e6ba7b0af5ab"],

Cell["\<\
STFactor factorizes products inside powers that depend on \[CurlyEpsilon]: it \
splits (a\[CenterDot] b)^{c\[CurlyEpsilon]+d} into a^{c\[CurlyEpsilon]+d}\\, \
b^{c\[CurlyEpsilon]+d} whenever one of the factors is manifestly positive for \
positive integration variables: (see example below) A typical usage is to \
rescale the integration variables along a ray \\rho of the Newton polytope \
(e.g., x_i \[RightArrow] x_i/\[Lambda] for each component \\rho_i > 0) and \
then apply STFactor to the result. The factorized form makes the \
\[Lambda]-dependence explicit, revealing whether the integrand diverges or \
converges along that ray.\
\>", "Notes",ExpressionUUID->"f629480a-cf0b-4713-81df-0455f7b7651e"],

Cell[BoxData[
 RowBox[{"STFactor", "[", "expression", "]"}]], "Input",ExpressionUUID->"ced67a31-594c-4b3a-8dea-852f5c98658a"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[GridBox[{
    {
     StyleBox[
      RowBox[{"Basic", " ", "Examples"}], "PrimaryExamplesSection"], 
     ButtonBox[
      RowBox[{
       RowBox[{"More", " ", "Examples"}], " ", "\[RightTriangle]"}],
      BaseStyle->"ExtendedExamplesLink",
      ButtonData:>"ExtendedExamples"]}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"b5632f81-807f-\
4d95-8038-86dad09e0377"],

Cell["Split (a b)^eps into a^eps b^eps across positive factors.", \
"ExampleText",ExpressionUUID->"babc44b8-e9fa-4941-9ec2-be219e8da816"],

Cell[BoxData[
 RowBox[{"STFactor", "[", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"x1", " ", "+", " ", "x2"}], ")"}], " ", "x3"}], ")"}], "^", 
   "eps"}], "]"}]], "Input",ExpressionUUID->"c805d787-f489-46d7-bd5c-\
e4583fae3152"],

Cell[BoxData[
 RowBox[{
  SuperscriptBox[
   RowBox[{"(", 
    RowBox[{"x1", "+", "x2"}], ")"}], "eps"], " ", 
  SuperscriptBox["x3", "eps"]}]], "Output",ExpressionUUID->"ee233ed2-4099-\
4b8b-a495-b48a83e98917"]
}, Open  ]],

