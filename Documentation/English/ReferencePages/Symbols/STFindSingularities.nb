Cell[BoxData[
 InterpretationBox[GridBox[{
    {
     StyleBox[
      RowBox[{"Basic", " ", "Examples"}], "PrimaryExamplesSection"], 
     ButtonBox[
      RowBox[{
       RowBox[{"More", " ", "Examples"}], " ", "\[RightTriangle]"}],
      BaseStyle->"ExtendedExamplesLink",
      ButtonData:>"ExtendedExamples"]}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"64ab78ee-533d-\
437d-9a38-31ce62d96616"],

Cell["\<\
Find the Landau singularities by the chi-drop method (Euler-characteristic \
drops of the twisted critical ideal).  Returns an Association keyed by \
\"singularities\"/\"chi\"/\"complete\"/\"trusted\"/...; requires the \
SPQR/msolve and FiniteFlow stack.\
\>", "ExampleText",ExpressionUUID->"587a3516-3b81-45d6-851e-80dd8e6c5b85"],

Cell[BoxData[
 RowBox[{"STFindSingularities", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"edges", ",", " ", "nodes"}], "}"}], ",", " ", 
   RowBox[{"FindLetters", " ", "->", " ", "False"}]}], "]"}]], "Input",Express\
ionUUID->"e76c285b-7f0d-4546-b95e-6e85f4c9a5b7"]
}, Open  ]],

