Notebook[{

Cell[CellGroupData[{
Cell["STFindSingularities", "ObjectName",ExpressionUUID->"5ddfed3f-ba21-440d-87cb-6fb58dec910f"],

Cell[BoxData[GridBox[{
   {Cell[TextData[{
     StyleBox["STFindSingularities[{edges, nodes}, opts]", "TI"],
     " \[LineSeparator]finds the Landau singularities of the graph by the \
chi-drop method (Chestnov-Crisanti-Giroux): Euler-characteristic drops of the \
twisted critical ideal of {x1, ..., xE, U, F}, read off per-coordinate SPQR \
elimination ideals, vetted per letter by the constrained sector count. \
Returns an Association with \"singularities\", \"chi\", \"complete\", \
\"trusted\", \"oddLetters\", \"diagnostics\", \"provenance\". NOTE: on hard \
problems a FiniteFlow projection may not honor \"Budget\" (native calls are \
not interruptible); for untrusted inputs run under an external process-level \
watchdog."
    }], "TableText",ExpressionUUID->"2521bb75-e784-4c7e-a395-869610be8a8a"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Usage",
 CellID->1,ExpressionUUID->"a8f78133-5b90-4c34-b142-43f1c5ed5721"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Options", "OptionsSection",ExpressionUUID->"10590c40-1648-4fc0-a79c-35441e00cf97"],

Cell[BoxData[GridBox[{
   {"\"\<Method\>\"", "\"\<SPQRLandau\>\"", 
    RowBox[{
     RowBox[{"elimination", " ", "method"}], ";", " ", 
     RowBox[{"the", " ", "only", " ", "supported", " ", "value"}]}]},
   {"\"\<FindLetters\>\"", "True", 
    RowBox[{
     RowBox[{"also", " ", "resolve", " ", "algebraic", " ", 
      RowBox[{"(", 
       RowBox[{"square", "-", "root"}], ")"}], " ", "letters"}], ",", " ", 
     RowBox[{
     "not", " ", "just", " ", "the", " ", "rational", " ", "alphabet"}]}]},
   {"\"\<ConfirmPrimes\>\"", "2", 
    RowBox[{
    "independent", " ", "modular", " ", "primes", " ", "the", 
     " ", "\"\<trusted\>\"", " ", "verdict", " ", "must", " ", "agree", " ", 
     "on"}]},
   {"\"\<Seed\>\"", "20260610", 
    RowBox[{
     RowBox[{"FiniteFlow", " ", "modular"}], "-", 
     RowBox[{"prime", " ", "/", " ", "parameter"}], "-", 
     RowBox[{"point", " ", "seed"}]}]},
   {"\"\<Budget\>\"", "300", 
    RowBox[{
     RowBox[{"per", "-", 
      RowBox[{"projection", " ", "time", " ", "budget", " ", 
       RowBox[{"(", "s", ")"}]}]}], ";", " ", 
     RowBox[{"not", " ", "always", " ", "honored", " ", 
      RowBox[{"(", 
       RowBox[{
       "native", " ", "calls", " ", "are", " ", "not", " ", "interruptible"}],
        ")"}]}]}]},
   {"\"\<Chart\>\"", "Automatic", 
    RowBox[{
     RowBox[{"per", "-", 
      RowBox[{"coordinate", " ", "elimination", " ", "chart"}]}], ";", " ", 
     RowBox[{
     "Automatic", " ", "tries", " ", "charts", " ", "until", " ", "one", " ", 
      "succeeds"}]}]},
   {"\"\<Exponents\>\"", "Automatic", 
    RowBox[{"propagator", " ", "exponents"}]},
   {"\"\<Verbose\>\"", "False", 
    RowBox[{"print", " ", 
     RowBox[{"progress", " ", "/", " ", "diagnostics"}]}]}
  },
  GridBoxAlignment->{"Columns" -> {Left, Left, Left}},
  GridBoxDividers->{"Rows" -> {True, {False}, True}}]], "OptionsTable",Express\
ionUUID->"205ae4d4-f93b-4ab1-8088-84b4edde3144"]
}, Open  ]],

