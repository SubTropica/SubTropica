41be-8a66-45121129c134"],

Cell["\<\
Find the Landau singularities by the chi-drop method (Euler-characteristic \
drops of the twisted critical ideal).  Returns an Association keyed by \
\"singularities\"/\"chi\"/\"complete\"/\"trusted\"/...; requires the \
SPQR/msolve and FiniteFlow stack.\
\>", "ExampleText",ExpressionUUID->"b1efaf2e-54f3-4bda-ad4b-57124655e884"],

Cell[BoxData[
 RowBox[{"STFindSingularities", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"edges", ",", " ", "nodes"}], "}"}], ",", " ", 
   RowBox[{"FindLetters", " ", "->", " ", "False"}]}], "]"}]], "Input",Express\
ionUUID->"078bb0a4-3e1d-4020-87b2-984294b17088"]
}, Open  ]],

