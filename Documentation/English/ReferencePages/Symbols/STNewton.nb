Notebook[{

Cell[CellGroupData[{
Cell["STNewton", "ObjectName",ExpressionUUID->"b19a9c67-e2bd-4e31-aaa5-8c657bda912e"],

Cell[BoxData[GridBox[{
   {Cell[TextData[{
     StyleBox["STNewton[polynomial, xvars]", "TI"],
     " \[LineSeparator]computes the Newton polytope data of the polynomial. \
It returns an association <| equations -> supporting plane equations, rays -> \
outer-pointing normal rays, facets -> facet inequalities, vertices -> vertices"
    }], "TableText",ExpressionUUID->"0382c17b-62ab-4253-87aa-6700449d9c51"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Usage",
 CellID->1,ExpressionUUID->"7bf86bf2-4f9e-40de-9918-c02674ab0c0a"]
}, Open  ]],

