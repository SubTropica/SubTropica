Cell[TextData[{
 Cell[BoxData[
  ButtonBox["STForgetCoefficients",
   BaseStyle->"Link",
   ButtonData->"paclet:SubTropica/ref/STForgetCoefficients"]], 
  "InlineFormula",ExpressionUUID->"fa6e6826-46e2-49dd-be2f-556409af8815"],
 " \[EmptyVerySmallSquare] ",
