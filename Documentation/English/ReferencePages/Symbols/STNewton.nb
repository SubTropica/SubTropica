4085-b647-cc6c8ff3c1b6"],

Cell["\<\
Newton-polytope data (vertices, rays, facets) of the triangle U-polynomial.\
\>", "ExampleText",ExpressionUUID->"9d64414d-e05a-4867-81d5-04303e094ad7"],

Cell[BoxData[
 RowBox[{"STNewton", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"x1", " ", "x2"}], " ", "+", " ", 
    RowBox[{"x1", " ", "x3"}], " ", "+", " ", 
    RowBox[{"x2", " ", "x3"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x1", ",", " ", "x2", ",", " ", "x3"}], "}"}]}], "]"}]], "Input",E\
xpressionUUID->"42a6433b-8bbb-4790-9781-ede31b73a7a6"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"equations\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "2"}], ",", "1", ",", "1", ",", "1"}], "}"}], "}"}]}], ",", 
   RowBox[{"\<\"rays\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "0", ",", 
        RowBox[{"-", "1"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"facets\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0", ",", "0", ",", 
        RowBox[{"-", "1"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"vertices\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "1", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0", ",", "1", ",", "1"}], "}"}]}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"d0b878ca-2338-4721-aac1-\
4df39d307742"]
}, Open  ]],

