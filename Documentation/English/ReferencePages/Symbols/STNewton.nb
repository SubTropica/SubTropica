   BaseStyle->"Link",
   ButtonData->"paclet:SubTropica/ref/STForgetCoefficients"]], 
  "InlineFormula",ExpressionUUID->"2258bf89-0b89-4e87-8f59-8c81a8057950"],
 " \[EmptyVerySmallSquare] ",
