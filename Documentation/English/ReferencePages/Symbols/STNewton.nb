   BaseStyle->"Link",
   ButtonData->"paclet:SubTropica/ref/STForgetCoefficients"]], 
  "InlineFormula",ExpressionUUID->"0946247e-6d80-47c0-ab47-df65061d9981"],
 " \[EmptyVerySmallSquare] ",
