4bda-89a5-f41765ba4ce3"],

Cell["\<\
Newton-polytope data (vertices, rays, facets) of the triangle U-polynomial.\
\>", "ExampleText",ExpressionUUID->"29d2c45e-b4ae-47e8-903d-37eba63c77ce"],

Cell[BoxData[
 RowBox[{"STNewton", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"x1", " ", "x2"}], " ", "+", " ", 
    RowBox[{"x1", " ", "x3"}], " ", "+", " ", 
    RowBox[{"x2", " ", "x3"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x1", ",", " ", "x2", ",", " ", "x3"}], "}"}]}], "]"}]], "Input",E\
xpressionUUID->"e35a9aba-628c-42b4-94a9-420282ba5dd8"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"equations\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "2"}], ",", "1", ",", "1", ",", "1"}], "}"}], "}"}]}], ",", 
   RowBox[{"\<\"rays\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "0", ",", 
        RowBox[{"-", "1"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"facets\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0", ",", "0", ",", 
        RowBox[{"-", "1"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"vertices\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "1", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0", ",", "1", ",", "1"}], "}"}]}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"b8c78441-2947-40c5-8384-\
e7266acb287b"]
}, Open  ]],

