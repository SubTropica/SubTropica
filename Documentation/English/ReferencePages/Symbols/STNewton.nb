   BaseStyle->"Link",
   ButtonData->"paclet:SubTropica/ref/STForgetCoefficients"]], 
  "InlineFormula",ExpressionUUID->"253e15e4-b962-4e09-b41a-07fb7176e8cd"],
 " \[EmptyVerySmallSquare] ",
