44f5-b82d-75fc880da8f8"],

Cell["\<\
Newton-polytope data (vertices, rays, facets) of the triangle U-polynomial.\
\>", "ExampleText",ExpressionUUID->"dc8f979a-8d42-4ac7-8b6b-dd0239af372d"],

Cell[BoxData[
 RowBox[{"STNewton", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"x1", " ", "x2"}], " ", "+", " ", 
    RowBox[{"x1", " ", "x3"}], " ", "+", " ", 
    RowBox[{"x2", " ", "x3"}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x1", ",", " ", "x2", ",", " ", "x3"}], "}"}]}], "]"}]], "Input",E\
xpressionUUID->"289c1f52-c911-4be8-9678-03da4f294d96"],

Cell[BoxData[
 RowBox[{"\[LeftAssociation]", 
  RowBox[{
   RowBox[{"\<\"equations\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "2"}], ",", "1", ",", "1", ",", "1"}], "}"}], "}"}]}], ",", 
   RowBox[{"\<\"rays\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "0", ",", 
        RowBox[{"-", "1"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"facets\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "0", ",", "0", ",", 
        RowBox[{"-", "1"}]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"-", "1"}], ",", "1", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", 
        RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}]}], "}"}]}], ",", 
   RowBox[{"\<\"vertices\"\>", "\[Rule]", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "0", ",", "1"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "1", ",", "1", ",", "0"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"1", ",", "0", ",", "1", ",", "1"}], "}"}]}], "}"}]}]}], 
  "\[RightAssociation]"}]], "Output",ExpressionUUID->"1147229a-9d31-483d-ad11-\
fe2494f1d0d2"]
}, Open  ]],

