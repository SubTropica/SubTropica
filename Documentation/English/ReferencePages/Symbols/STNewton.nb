Notebook[{

Cell[CellGroupData[{
Cell["STNewton", "ObjectName",ExpressionUUID->"d5192cf6-2686-468b-9172-3e3c72511fd1"],

Cell[BoxData[GridBox[{
   {Cell[TextData[{
     StyleBox["STNewton[polynomial, xvars]", "TI"],
     " \[LineSeparator]computes the Newton polytope data of the polynomial. \
It returns an association <| equations -> supporting plane equations, rays -> \
outer-pointing normal rays, facets -> facet inequalities, vertices -> vertices"
    }], "TableText",ExpressionUUID->"a28deaf8-bfdd-4c91-ade0-f38306df750f"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Usage",
 CellID->1,ExpressionUUID->"05feefd7-3e7f-40a4-b509-6aa7fcda6bb3"]
}, Open  ]],

