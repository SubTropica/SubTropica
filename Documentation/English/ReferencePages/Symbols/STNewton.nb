Cell[TextData[{
 Cell[BoxData[
  ButtonBox["STForgetCoefficients",
   BaseStyle->"Link",
   ButtonData->"paclet:SubTropica/ref/STForgetCoefficients"]], 
  "InlineFormula",ExpressionUUID->"4a8ba03b-074c-44ab-96e4-5d0bfc336de5"],
 " \[EmptyVerySmallSquare] ",
