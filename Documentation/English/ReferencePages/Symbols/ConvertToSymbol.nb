Cell["The symbol of the dilogarithm Li2(z).", "ExampleText",ExpressionUUID->"c9466a1d-b622-4da9-9cea-71bdcbeaf7c3"],

Cell[BoxData[
 RowBox[{"ConvertToSymbol", "[", 
  RowBox[{"PolyLog", "[", 
   RowBox[{"2", ",", " ", "z"}], "]"}], "]"}]], "Input",ExpressionUUID->\
"521f7dba-baf8-4710-8036-c1a69f78a822"],

Cell[BoxData[
 RowBox[{"-", 
