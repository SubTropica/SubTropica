Cell["The symbol of the dilogarithm Li2(z).", "ExampleText",ExpressionUUID->"036dab22-9c52-43c4-a36f-270b5d612b0b"],

Cell[BoxData[
 RowBox[{"ConvertToSymbol", "[", 
  RowBox[{"PolyLog", "[", 
   RowBox[{"2", ",", " ", "z"}], "]"}], "]"}]], "Input",ExpressionUUID->\
"bc83cb6f-e63b-406b-b0c9-d3619e40b604"],

Cell[BoxData[
 RowBox[{"-", 
