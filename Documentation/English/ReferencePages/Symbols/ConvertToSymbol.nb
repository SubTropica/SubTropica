Cell["The symbol of the dilogarithm Li2(z).", "ExampleText",ExpressionUUID->"0b6348f2-a9f2-4cd8-b083-33f3e5aff8f6"],

Cell[BoxData[
 RowBox[{"ConvertToSymbol", "[", 
  RowBox[{"PolyLog", "[", 
   RowBox[{"2", ",", " ", "z"}], "]"}], "]"}]], "Input",ExpressionUUID->\
"6b0484ce-8757-4ee5-9af6-779dd69a0536"],

