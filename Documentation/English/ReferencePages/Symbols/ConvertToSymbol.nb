Cell["The symbol of the dilogarithm Li2(z).", "ExampleText",ExpressionUUID->"c3d0412e-0b00-4fa0-91c9-9aa1081bd40a"],

Cell[BoxData[
 RowBox[{"ConvertToSymbol", "[", 
  RowBox[{"PolyLog", "[", 
   RowBox[{"2", ",", " ", "z"}], "]"}], "]"}]], "Input",ExpressionUUID->\
"e74d4954-3a2e-411e-a2f7-6030f39b7632"],

