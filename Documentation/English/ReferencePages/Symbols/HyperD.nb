4fc4-9387-97e55e24160c"],

Cell["\<\
HyperD differentiates through Hlog and Mpl with variable-dependent arguments, \
unlike built-in D.\
\>", "ExampleText",ExpressionUUID->"56cf8215-c84a-4e71-86ac-320f8c1b1a4e"],

Cell[BoxData[
 RowBox[{"HyperD", "[", 
  RowBox[{
   RowBox[{"Mpl", "[", 
    RowBox[{
     RowBox[{"{", "2", "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{"x", "/", "u"}]}], "}"}]}], "]"}], ",", " ", "x"}], 
  "]"}]], "Input",ExpressionUUID->"335cdcd6-402e-4b0f-be9a-d4bc66138774"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{"Mpl", "[", 
    RowBox[{
     RowBox[{"{", "1", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", "-", 
       FractionBox["x", "u"]}], "}"}]}], "]"}], 
   RowBox[{"u", " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      FractionBox["x", "u"]}], ")"}]}]]}]], "Output",ExpressionUUID->\
"ab142e5b-3626-4940-bee9-7b09ac1096df"]
}, Open  ]],

