   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"5c38a168-fa8b-\
4f46-bf37-9c67b9f5b555"],

Cell["\<\
HyperD differentiates through Hlog and Mpl with variable-dependent arguments, \
unlike built-in D.\
\>", "ExampleText",ExpressionUUID->"849d8ec5-5508-4819-a074-8f12b0e34ca3"],

Cell[BoxData[
 RowBox[{"HyperD", "[", 
  RowBox[{
   RowBox[{"Mpl", "[", 
    RowBox[{
     RowBox[{"{", "2", "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{"x", "/", "u"}]}], "}"}]}], "]"}], ",", " ", "x"}], 
  "]"}]], "Input",ExpressionUUID->"7637ff06-8c21-4e95-a3ba-a67c04b7fffb"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{"Mpl", "[", 
    RowBox[{
     RowBox[{"{", "1", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", "-", 
       FractionBox["x", "u"]}], "}"}]}], "]"}], 
   RowBox[{"u", " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      FractionBox["x", "u"]}], ")"}]}]]}]], "Output",ExpressionUUID->\
"37aa9002-1cbc-45db-bb64-acf0fed2ee2c"]
}, Open  ]],

