4964-9845-fc5f9d63b0bb"],

Cell["\<\
HyperD differentiates through Hlog and Mpl with variable-dependent arguments, \
unlike built-in D.\
\>", "ExampleText",ExpressionUUID->"95a5d98e-a221-4841-ae3b-c499edcda18a"],

Cell[BoxData[
 RowBox[{"HyperD", "[", 
  RowBox[{
   RowBox[{"Mpl", "[", 
    RowBox[{
     RowBox[{"{", "2", "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{"x", "/", "u"}]}], "}"}]}], "]"}], ",", " ", "x"}], 
  "]"}]], "Input",ExpressionUUID->"f8a0958f-c7e6-4335-b0f5-b7878e90606d"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{"Mpl", "[", 
    RowBox[{
     RowBox[{"{", "1", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", "-", 
       FractionBox["x", "u"]}], "}"}]}], "]"}], 
   RowBox[{"u", " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      FractionBox["x", "u"]}], ")"}]}]]}]], "Output",ExpressionUUID->\
"82e1af71-0667-4de4-88ed-6615a124572f"]
}, Open  ]],

