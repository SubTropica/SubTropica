43d1-abc0-b54bd797ebf1"],

Cell["\<\
HyperD differentiates through Hlog and Mpl with variable-dependent arguments, \
unlike built-in D.\
\>", "ExampleText",ExpressionUUID->"9abe1044-bd7e-4183-a272-7322df5aadff"],

Cell[BoxData[
 RowBox[{"HyperD", "[", 
  RowBox[{
   RowBox[{"Mpl", "[", 
    RowBox[{
     RowBox[{"{", "2", "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{"x", "/", "u"}]}], "}"}]}], "]"}], ",", " ", "x"}], 
  "]"}]], "Input",ExpressionUUID->"037a15a3-67c5-4e6e-b10a-210eb3e9ff21"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{"Mpl", "[", 
    RowBox[{
     RowBox[{"{", "1", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", "-", 
       FractionBox["x", "u"]}], "}"}]}], "]"}], 
   RowBox[{"u", " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      FractionBox["x", "u"]}], ")"}]}]]}]], "Output",ExpressionUUID->\
"bbd4dfc1-e7c2-466e-b53f-0906c00df5c4"]
}, Open  ]],

