404e-9f7e-138e0b71bb02"],

Cell["\<\
HyperD differentiates through Hlog and Mpl with variable-dependent arguments, \
unlike built-in D.\
\>", "ExampleText",ExpressionUUID->"a7e9570a-0717-4778-973b-0dc0d4502514"],

Cell[BoxData[
 RowBox[{"HyperD", "[", 
  RowBox[{
   RowBox[{"Mpl", "[", 
    RowBox[{
     RowBox[{"{", "2", "}"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{"x", "/", "u"}]}], "}"}]}], "]"}], ",", " ", "x"}], 
  "]"}]], "Input",ExpressionUUID->"6d5c7a5e-74e8-45e3-8e31-cb245be3f49c"],

Cell[BoxData[
 RowBox[{"-", 
  FractionBox[
   RowBox[{"Mpl", "[", 
    RowBox[{
     RowBox[{"{", "1", "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", "-", 
       FractionBox["x", "u"]}], "}"}]}], "]"}], 
   RowBox[{"u", " ", 
    RowBox[{"(", 
     RowBox[{"1", "-", 
      FractionBox["x", "u"]}], ")"}]}]]}]], "Output",ExpressionUUID->\
"381be673-3914-4810-b08b-46f02d89f2fb"]
}, Open  ]],

