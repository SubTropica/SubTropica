     ButtonBox[
      RowBox[{
       RowBox[{"More", " ", "Examples"}], " ", "\[RightTriangle]"}],
      BaseStyle->"ExtendedExamplesLink",
      ButtonData:>"ExtendedExamples"]}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"2f0dc2ff-c5a9-\
4794-afba-7cdc41f6922a"],

Cell["\<\
Evaluate a rational Euler integral analytically with HyperFORM (under FORM), \
returning a rational combination of zeta values; for the regression integrand \
the result is -79/24 + Pi^2/12.  Requires FORM and HyperFORM.\
\>", "ExampleText",ExpressionUUID->"48f79385-2c41-4436-834b-c096e25600a9"],

Cell[BoxData[
 RowBox[{"STHyperForm", "[", 
  RowBox[{"integrand", ",", " ", 
   RowBox[{"{", 
    RowBox[{
    "x4", ",", " ", "x1", ",", " ", "x2", ",", " ", "x5", ",", " ", "x3"}], 
    "}"}]}], "]"}]], "Input",ExpressionUUID->"0409e73b-b909-431d-ad07-\
7bdd81433854"]
}, Open  ]],

