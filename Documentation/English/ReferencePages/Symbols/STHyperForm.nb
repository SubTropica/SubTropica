     StyleBox[
      RowBox[{"Basic", " ", "Examples"}], "PrimaryExamplesSection"], 
     ButtonBox[
      RowBox[{
       RowBox[{"More", " ", "Examples"}], " ", "\[RightTriangle]"}],
      BaseStyle->"ExtendedExamplesLink",
      ButtonData:>"ExtendedExamples"]}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"90f5ef20-b9f8-\
4f55-9aed-1466b0d6ad29"],

Cell["\<\
Evaluate a rational Euler integral analytically with HyperFORM (under FORM), \
returning a rational combination of zeta values; for the regression integrand \
the result is -79/24 + Pi^2/12.  Requires FORM and HyperFORM.\
\>", "ExampleText",ExpressionUUID->"bfdbc23e-a169-49c8-9f7d-9114b08d3126"],

Cell[BoxData[
 RowBox[{"STHyperForm", "[", 
  RowBox[{"integrand", ",", " ", 
   RowBox[{"{", 
    RowBox[{
    "x4", ",", " ", "x1", ",", " ", "x2", ",", " ", "x5", ",", " ", "x3"}], 
    "}"}]}], "]"}]], "Input",ExpressionUUID->"08b94c25-11e7-4730-8045-\
df5a7ea45537"]
}, Open  ]],

