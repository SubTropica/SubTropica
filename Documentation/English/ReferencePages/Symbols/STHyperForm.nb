   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"987ff533-f782-\
46ea-b0aa-b309d06ea4a9"],

Cell["\<\
Evaluate a rational Euler integral analytically with HyperFORM (under FORM), \
returning a rational combination of zeta values; for the regression integrand \
the result is -79/24 + Pi^2/12.  Requires FORM and HyperFORM.\
\>", "ExampleText",ExpressionUUID->"81d469b7-9ab7-48dd-ad3c-a556076e8f29"],

Cell[BoxData[
 RowBox[{"STHyperForm", "[", 
  RowBox[{"integrand", ",", " ", 
   RowBox[{"{", 
    RowBox[{
    "x4", ",", " ", "x1", ",", " ", "x2", ",", " ", "x5", ",", " ", "x3"}], 
    "}"}]}], "]"}]], "Input",ExpressionUUID->"1ecc9b54-4755-4dca-be7f-\
fd162c3ac4e7"]
}, Open  ]],

