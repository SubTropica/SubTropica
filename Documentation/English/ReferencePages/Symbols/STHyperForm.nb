Notebook[{

Cell[CellGroupData[{
Cell["STHyperForm", "ObjectName",ExpressionUUID->"0c63ab80-aa51-4667-a645-d3acdb292775"],

Cell[BoxData[GridBox[{
   {Cell[TextData[{
     StyleBox["STHyperForm[integrand, {x1, ..., xn}]", "TI"],
     " \[LineSeparator]evaluates the Euler integral of a rational integrand \
(optionally carrying Log[poly] numerator factors) over [0, \\[Infinity])^n \
analytically with the HyperFORM package (Kardos) running under FORM. The \
variable list doubles as the integration order. Returns a rational \
combination of Zeta values on success, $Failed (with a message) on \
out-of-scope input or when HyperFORM cannot reduce all boundary constants. \
Requires the optional dependencies FORM (>= 5.0, ConfigureSubTropica[FormPath \
-> ...]) and HyperFORM (ConfigureSubTropica[HyperFormPath -> ...]). \
\"IntegrationOrder\" -> {x1, ..., xn} (a permutation of the supplied \
variables) reorders the integration before the call (the variable list \
otherwise doubles as the order); the per-face rule-list form is ignored on \
this single-integrand leaf. For verified per-face pinning use STIntegrate / \
STIntegrateHF."
    }], "TableText",ExpressionUUID->"6b51b785-4843-41db-b1b0-3344df414733"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Usage",
 CellID->1,ExpressionUUID->"08174316-cb47-4409-ad08-b31846e8a7ae"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Options", "OptionsSection",ExpressionUUID->"622c9061-4c59-41bf-b19e-c9f70b6883e5"],

Cell[BoxData[GridBox[{
   {"\"\<IntegrationOrder\>\"", "None", 
    RowBox[{
     RowBox[{
     "None", " ", "uses", " ", "the", " ", "given", " ", "variable", " ", 
      "list", " ", "as", " ", "the", " ", "order"}], ";", " ", 
     RowBox[{
     "a", " ", "global", " ", "permutation", " ", "reorders", " ", "before", " ",
       "integration"}]}]},
   {"\"\<IntegrationOrderVerify\>\"", "False", 
    RowBox[{
    "inert", " ", "on", " ", "this", " ", "direct", " ", "leaf", " ", 
     RowBox[{"(", 
      RowBox[{"the", " ", "order", " ", "is", " ", "trusted"}], ")"}]}]}
  },
  GridBoxAlignment->{"Columns" -> {Left, Left, Left}},
  GridBoxDividers->{"Rows" -> {True, {False}, True}}]], "OptionsTable",Express\
ionUUID->"a0f96990-d77e-4f8e-a684-8314f7ba0eb9"]
}, Open  ]],

