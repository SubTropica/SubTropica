   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"ae9cef8a-e24b-\
4b97-9df1-b43b56228936"],

Cell["\<\
Evaluate a rational Euler integral analytically with HyperFORM (under FORM), \
returning a rational combination of zeta values; for the regression integrand \
the result is -79/24 + Pi^2/12.  Requires FORM and HyperFORM.\
\>", "ExampleText",ExpressionUUID->"9f6cbe30-3ada-4d7f-bf01-10f343724cb4"],

Cell[BoxData[
 RowBox[{"STHyperForm", "[", 
  RowBox[{"integrand", ",", " ", 
   RowBox[{"{", 
    RowBox[{
    "x4", ",", " ", "x1", ",", " ", "x2", ",", " ", "x5", ",", " ", "x3"}], 
    "}"}]}], "]"}]], "Input",ExpressionUUID->"33506cb6-7265-4a52-8668-\
fe2a824aa3f2"]
}, Open  ]],

