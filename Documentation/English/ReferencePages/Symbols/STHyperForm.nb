   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"796e0437-11a6-\
4237-b8ae-bcd64fdcd163"],

Cell["\<\
Evaluate a rational Euler integral analytically with HyperFORM (under FORM), \
returning a rational combination of zeta values; for the regression integrand \
the result is -79/24 + Pi^2/12.  Requires FORM and HyperFORM.\
\>", "ExampleText",ExpressionUUID->"befafe6b-c807-497b-ad32-2a0e1931d67d"],

Cell[BoxData[
 RowBox[{"STHyperForm", "[", 
  RowBox[{"integrand", ",", " ", 
   RowBox[{"{", 
    RowBox[{
    "x4", ",", " ", "x1", ",", " ", "x2", ",", " ", "x5", ",", " ", "x3"}], 
    "}"}]}], "]"}]], "Input",ExpressionUUID->"e8b3287b-2250-4a14-a0ef-\
78502b5cf410"]
}, Open  ]],

