   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"350071c0-d750-\
4dfc-859f-52e8b89b2d80"],

Cell["\<\
Evaluate a rational Euler integral analytically with HyperFORM (under FORM), \
returning a rational combination of zeta values; for the regression integrand \
the result is -79/24 + Pi^2/12.  Requires FORM and HyperFORM.\
\>", "ExampleText",ExpressionUUID->"11c7e372-7070-459b-9d28-bd1a7bdfb564"],

Cell[BoxData[
 RowBox[{"STHyperForm", "[", 
  RowBox[{"integrand", ",", " ", 
   RowBox[{"{", 
    RowBox[{
    "x4", ",", " ", "x1", ",", " ", "x2", ",", " ", "x5", ",", " ", "x3"}], 
    "}"}]}], "]"}]], "Input",ExpressionUUID->"cadb0299-c546-4489-8d9b-\
2440e736a657"]
}, Open  ]],

