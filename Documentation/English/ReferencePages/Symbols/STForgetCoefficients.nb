Cell["Keep the monomial support, set every coefficient to 1.", "ExampleText",ExpressionUUID->"e4ef0c23-48cd-407d-88e9-af5bde732490"],

Cell[BoxData[
 RowBox[{"STForgetCoefficients", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"2", " ", 
     RowBox[{"x", "^", "2"}], " ", "y"}], " ", "+", " ", 
    RowBox[{"5", " ", "x"}], " ", "+", " ", "3"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", "y"}], "}"}]}], "]"}]], "Input",ExpressionUUID->\
"3ba63531-bad2-4d36-8196-8841bdb8cb79"],

Cell[BoxData[
 RowBox[{"1", "+", "x", "+", 
  RowBox[{
   SuperscriptBox["x", "2"], " ", "y"}]}]], "Output",ExpressionUUID->\
"b4559491-4e5e-4369-9b73-93888a9de3a5"]
}, Open  ]],

