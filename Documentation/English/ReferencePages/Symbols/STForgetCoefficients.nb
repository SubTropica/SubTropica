Cell["Keep the monomial support, set every coefficient to 1.", "ExampleText",ExpressionUUID->"5b74ec5c-a24d-4c7f-badc-707201fed939"],

Cell[BoxData[
 RowBox[{"STForgetCoefficients", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"2", " ", 
     RowBox[{"x", "^", "2"}], " ", "y"}], " ", "+", " ", 
    RowBox[{"5", " ", "x"}], " ", "+", " ", "3"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", "y"}], "}"}]}], "]"}]], "Input",ExpressionUUID->\
"97fc1b1f-1693-432c-951f-93889e15c90d"],

Cell[BoxData[
 RowBox[{"1", "+", "x", "+", 
  RowBox[{
   SuperscriptBox["x", "2"], " ", "y"}]}]], "Output",ExpressionUUID->\
"a9c19ba5-e7d7-4424-a0b5-d320f30ef686"]
}, Open  ]],

