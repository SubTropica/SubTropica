Cell["Keep the monomial support, set every coefficient to 1.", "ExampleText",ExpressionUUID->"432154ec-bdb5-4ec7-8708-57038b3031d5"],

Cell[BoxData[
 RowBox[{"STForgetCoefficients", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"2", " ", 
     RowBox[{"x", "^", "2"}], " ", "y"}], " ", "+", " ", 
    RowBox[{"5", " ", "x"}], " ", "+", " ", "3"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", "y"}], "}"}]}], "]"}]], "Input",ExpressionUUID->\
