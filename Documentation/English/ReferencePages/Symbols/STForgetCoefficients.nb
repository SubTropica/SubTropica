Cell["Keep the monomial support, set every coefficient to 1.", "ExampleText",ExpressionUUID->"a7c78c1d-3510-4a0f-91c9-6abb0259facd"],

Cell[BoxData[
 RowBox[{"STForgetCoefficients", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"2", " ", 
