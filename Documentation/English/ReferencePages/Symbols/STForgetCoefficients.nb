Cell["Keep the monomial support, set every coefficient to 1.", "ExampleText",ExpressionUUID->"85396079-f08d-49b0-bae7-f96d1ff4c639"],

Cell[BoxData[
 RowBox[{"STForgetCoefficients", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"2", " ", 
     RowBox[{"x", "^", "2"}], " ", "y"}], " ", "+", " ", 
    RowBox[{"5", " ", "x"}], " ", "+", " ", "3"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", "y"}], "}"}]}], "]"}]], "Input",ExpressionUUID->\
"de9cfa8c-0621-424e-844f-ba31bbf89c96"],

Cell[BoxData[
 RowBox[{"1", "+", "x", "+", 
  RowBox[{
   SuperscriptBox["x", "2"], " ", "y"}]}]], "Output",ExpressionUUID->\
"d74cbfed-b0ad-4b55-839b-c50cab1e94ee"]
