Cell["Keep the monomial support, set every coefficient to 1.", "ExampleText",ExpressionUUID->"b33ae970-377f-4a9e-aca8-b088f89f44b9"],

Cell[BoxData[
 RowBox[{"STForgetCoefficients", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"2", " ", 
     RowBox[{"x", "^", "2"}], " ", "y"}], " ", "+", " ", 
    RowBox[{"5", " ", "x"}], " ", "+", " ", "3"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x", ",", " ", "y"}], "}"}]}], "]"}]], "Input",ExpressionUUID->\
