Notebook[{

Cell[CellGroupData[{
Cell["STToIterInt", "ObjectName",ExpressionUUID->"82ea5884-8a97-4bfe-9300-4d4d47686172"],

Cell[BoxData[GridBox[{
   {Cell[TextData[{
     StyleBox["STToIterInt[expr]", "TI"],
     " \[LineSeparator]numerically evaluates hyperlogarithm expressions using \
IterInt (G. Baur, C. Duhr, arXiv:2606.02744; github.com/baugid/IterInt) as an \
independent, arbitrary-precision evaluator \\[LongDash] an Integrator-side \
alternative to STToGinsh. Each Hlog[z, {a1,...,an}] is evaluated as the \
Goncharov polylogarithm G(a1,...,an; z) via IterInt's iterated-integral ODE \
solver (the iterint_mpfr driver) along the straight path 0 -> z(1 - \
i*Epsilon). Validated against STToGinsh for letters OFF the real integration \
path; words with a (near-)real letter ON [0, Re z] are rejected with \
STToIterInt::oncontour (the straight-path ODE is unreliable there \
\\[LongDash] use STToGinsh for those). Log[a] -> Log[a], zeta[n] -> Zeta[n]; \
depth>=2 multiple zeta values route through ginsh. Options \"Precision\", \
\"TolExp\", \"HStartExp\", \"Epsilon\" control the driver; the defaults are \
robust for spurious-pole algebraic-letter results (and correspondingly slow \
on trailing-zero words). Requires the iterint_mpfr driver \
(ConfigureSubTropica[IterIntPath -> ...])."
    }], "TableText",ExpressionUUID->"03e7ebad-650d-4446-b00b-9b5a1a800e48"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Usage",
 CellID->1,ExpressionUUID->"242e1ebb-14fe-4d3b-a084-e5c182773e2c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Options", "OptionsSection",ExpressionUUID->"d4290694-6672-45c1-a864-f7230a558938"],

Cell[BoxData[GridBox[{
   {"\"\<Precision\>\"", "80", 
    RowBox[{"working", " ", "precision", " ", 
     RowBox[{"(", "digits", ")"}], " ", "of", " ", "the", " ", "iterint_mpfr",
      " ", "ODE", " ", "solver"}]},
   {"\"\<TolExp\>\"", "45", 
    RowBox[{"ODE", "-", 
     RowBox[{"solver", " ", "tolerance", " ", "exponent"}]}]},
   {"\"\<HStartExp\>\"", "28", 
    RowBox[{
     RowBox[{"initial", " ", "step"}], "-", 
     RowBox[{"size", " ", "exponent"}]}]},
   {"\"\<Epsilon\>\"", 
    RowBox[{"10", "^", 
     RowBox[{"-", "6"}]}], 
    RowBox[{
     RowBox[{
      RowBox[{
      "imaginary", " ", "offset", " ", "\[Eta]", " ", "in", " ", "the", " ", 
       "straight"}], "-", 
      RowBox[{"path", " ", "endpoint", " ", "z"}]}], " ", "\[Rule]", " ", 
     RowBox[{"z", 
      RowBox[{"(", 
       RowBox[{"1", " ", "-", " ", 
        RowBox[{"I", " ", "\[Eta]"}]}], ")"}]}]}]}
  },
  GridBoxAlignment->{"Columns" -> {Left, Left, Left}},
  GridBoxDividers->{"Rows" -> {True, {False}, True}}]], "OptionsTable",Express\
ionUUID->"08e583fb-823a-4783-ad3f-f7956a7a3967"]
}, Open  ]],

