Cell["\<\
Arbitrary-precision evaluation via the IterInt driver; here G(2I;1) = \
0.111572... + 0.463647... I.  A letter on the straight path [0, Re z] is \
refused (use STToGinsh there).\
\>", "ExampleText",ExpressionUUID->"feb6e885-097d-40b9-8d99-dcfab7c4e240"],

Cell[BoxData[
 RowBox[{"STToIterInt", "[", 
  RowBox[{"Hlog", "[", 
   RowBox[{"1", ",", " ", 
    RowBox[{"{", 
     RowBox[{"2", " ", "I"}], "}"}]}], "]"}], "]"}]], "Input",ExpressionUUID->\
"5009c2d2-af92-4f75-b0a0-1c3536fa70ba"]
}, Open  ]],

