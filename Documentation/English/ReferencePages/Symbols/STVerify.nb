Cell["\<\
Cross-check a symbolic result against a fresh numerical evaluation; returns \
an Association whose \"pass\" key is True when the relative error is below \
Tolerance.  Requires a numerical backend.\
\>", "ExampleText",ExpressionUUID->"77f3485b-06c6-4c03-88e6-feeea2a01a6b"],

Cell[BoxData[
 RowBox[{"ConfigureSubTropica", "[", 
  RowBox[{
  "PythonPath", " ", "->", " ", "\"\<.venvs/subtropica312/bin/python\>\""}], 
  "]"}]], "Input",ExpressionUUID->"8a015f07-a5a4-4b67-b450-8f55fc747501"],

Cell[BoxData[
 RowBox[{"STVerify", "[", 
