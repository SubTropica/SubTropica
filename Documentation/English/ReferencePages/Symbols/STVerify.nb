Notebook[{

Cell[CellGroupData[{
Cell["STVerify", "ObjectName",ExpressionUUID->"034c2161-8c39-4e02-bfb6-44756a9da33b"],

Cell[BoxData[GridBox[{
   {Cell[TextData[{
     StyleBox["STVerify", "TI"],
     " \[LineSeparator]STVerify cross-checks a symbolic result from \
STIntegrate against a numerical evaluation."
    }], "TableText",ExpressionUUID->"a89013ac-99b6-439d-a8e9-8d9eaeb00e9c"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Usage",
 CellID->1,ExpressionUUID->"1ceecbf3-1c13-40fc-97f8-e7d056a99af6"],

Cell["\<\
STVerify cross-checks a symbolic result from STIntegrate against a numerical \
evaluation. It automatically generates a Euclidean kinematic point, runs \
STNIntegrate for the numerical side and STToGinsh for the symbolic side, and \
compares Laurent coefficients order by order. The syntax is: (see example \
below)\
\>", "Notes",ExpressionUUID->"d5e04659-ff35-40cb-a852-dfb96c01c674"],

Cell[BoxData[
 RowBox[{"STVerify", "[", 
  RowBox[{"input", ",", " ", "result", "\n", "    ", ",", " ", 
   RowBox[{"\"\<Order\>\"", "      ", "->", " ", "0"}], "\n", "    ", ",", 
   " ", 
   RowBox[{"\"\<Dimension\>\"", "  ", "->", " ", 
    RowBox[{"4", " ", "-", " ", 
     RowBox[{"2", " ", "eps"}]}]}], " ", "\n", "    ", ",", " ", 
   RowBox[{"\"\<Tolerance\>\"", "  ", "->", " ", 
    RowBox[{"10", "^", 
     RowBox[{"-", "3"}]}]}], "\n", "    ", ",", " ", 
   RowBox[{"\"\<MaxEval\>\"", "    ", "->", " ", "Automatic"}], "\n", "    ", 
   ",", " ", 
   RowBox[{"\"\<Accuracy\>\"", "   ", "->", " ", 
    RowBox[{"10", "^", 
     RowBox[{"-", "4"}]}]}], "\n", "    ", ",", " ", 
   RowBox[{"\"\<Integrator\>\"", " ", "->", " ", "\"\<Qmc\>\""}], "\n", 
   "    ", ",", " ", 
   RowBox[{"\"\<Method\>\"", "     ", "->", " ", "\"\<pySecDec\>\""}], "\n", 
   "    ", ",", " ", 
   RowBox[{"\"\<Verbose\>\"", "    ", "->", " ", "False"}]}], "]"}]], "Input",\
ExpressionUUID->"84d6ba79-7929-4449-9206-b6b564820646"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Details", "Section",ExpressionUUID->"b26ece09-8a51-4389-a401-a3e4921e5def"],

Cell["Options", "Subsection",ExpressionUUID->"833a45bc-0f5c-4e7d-b6b5-abe0dac1e16a"],

Cell["\<\
\"Tolerance\" (default 10^{-3}) sets the threshold for the relative error \
between numerical and symbolic coefficients. \"MaxEval\" -> Automatic \
defaults to 10^6 for one-loop integrals and 10^7 otherwise. The remaining \
options are inherited from STNIntegrate.\
\>", "Text",ExpressionUUID->"d81670c7-d239-4fbf-ae76-be827ac4b33e"],

Cell["Return value", "Subsection",ExpressionUUID->"2a1cd11c-5f69-48c7-b0d0-2e9c16297696"],

Cell["\<\
An Association with keys \"pass\" (True/False), \"reason\", \"maxRelErr\", \
\"relErr\" (per-coefficient relative errors), \"coefficients\" (detailed \
comparison at each \[CurlyEpsilon]-order), \"kinPoint\" (the kinematic point \
used), and \"symbolic\" (the evaluated symbolic result).\
\>", "Text",ExpressionUUID->"89ad5f0f-a03d-4b8b-bc5d-10a73ceb034b"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Options", "OptionsSection",ExpressionUUID->"b1ae60dd-f42b-4f14-a0b4-ad20ac9c9355"],

Cell[BoxData[GridBox[{
   {"\"\<Method\>\"", "\"\<pySecDec\>\"", 
    RowBox[{
     RowBox[{"numerical", " ", 
      RowBox[{"backend", ":", " ", "\"\<pySecDec\>\""}]}], ",", 
     " ", "\"\<FIESTA\>\"", ",", " ", "\"\<AMFlow\>\"", ",", " ", 
     RowBox[{"or", " ", "\"\<feyntrop\>\""}]}]},
   {"\"\<Tolerance\>\"", 
    RowBox[{"1", "/", "1000"}], 
    RowBox[{
     RowBox[{
      RowBox[{"pass", "/", "fail"}], " ", "threshold", " ", "on", " ", "the", 
      " ", "symbolic"}], "-", "vs", "-", 
     RowBox[{"numeric", " ", "relative", " ", "error"}]}]},
   {"\"\<Accuracy\>\"", 
    RowBox[{"1", "/", "10000"}], 
    RowBox[{
    "target", " ", "relative", " ", "accuracy", " ", "for", " ", "the", " ", 
     "numeric", " ", "run"}]},
   {"\"\<MaxEval\>\"", "Automatic", 
    RowBox[{"maximum", " ", "integrand", " ", "evaluations"}]},
   {"\"\<Order\>\"", "0", 
    RowBox[{"\[CurlyEpsilon]", "-", 
     RowBox[{
     "order", " ", "at", " ", "which", " ", "to", " ", "compare"}]}]},
   {"\"\<Verbose\>\"", "False", 
    RowBox[{
     RowBox[{"print", " ", "backend"}], ",", " ", 
     RowBox[{"kinematic", " ", "point"}], ",", " ", 
     RowBox[{
      RowBox[{"and", " ", "per"}], "-", 
      RowBox[{"order", " ", "comparison"}]}]}]},
   {"\"\<ResultIndex\>\"", "1", 
    RowBox[{"which", " ", "stored", " ", 
     RowBox[{"Results", "[", 
      RowBox[{"[", "i", "]"}], "]"}], " ", "record", " ", "to", " ", "verify",
      " ", 
     RowBox[{"(", 
      RowBox[{"CNI", " ", "form"}], ")"}]}]},
   {"\"\<LibraryPath\>\"", "\"\<library-bundled\>\"", 
    RowBox[{
    "directory", " ", "to", " ", "load", " ", "the", " ", "CNI", " ", "entry",
      " ", "from"}]},
   {"\"\<Substitutions\>\"", "Automatic", 
    RowBox[{
     RowBox[{
     "kinematic", " ", "rules", " ", "forwarded", " ", "to", " ", 
      "STNIntegrate"}], ";", " ", 
     RowBox[{
      RowBox[{"else", " ", "auto"}], "-", "generated"}]}]},
   {"\"\<NumSamples\>\"", "1", 
    RowBox[{
     RowBox[{"if", " ", ">", "1"}], ",", " ", 
     RowBox[{
     "verify", " ", "at", " ", "that", " ", "many", " ", "independent", " ", 
      "kinematic", " ", "points", " ", "and", " ", "aggregate"}]}]},
   {"\"\<Seed\>\"", "Automatic", 
    RowBox[{
    "integer", " ", "seed", " ", "override", " ", "for", " ", "the", " ", 
     "kinematic", " ", "point"}]},
   {"\"\<Integrator\>\"", "Automatic", 
    RowBox[{
     RowBox[{"backend", " ", "integrator"}], ";", " ", 
     RowBox[{"Automatic", " ", "picks", " ", "per", " ", "Method"}]}]},
   {"\"\<Dimension\>\"", 
    RowBox[{"4", " ", "-", " ", 
     RowBox[{"2", " ", "eps"}]}], 
    RowBox[{"spacetime", " ", "dimension", " ", 
     RowBox[{"(", 
      RowBox[{
      "CNI", " ", "form", " ", "defaults", " ", "to", " ", "the", " ", 
       "stored", " ", "value"}], ")"}]}]},
   {"\"\<Exponents\>\"", "Automatic", 
    RowBox[{"propagator", " ", "exponents", " ", 
     RowBox[{"(", 
      RowBox[{"propagator", " ", "form"}], ")"}]}]},
   {"\"\<MaxTime\>\"", "Automatic", 
    RowBox[{
     RowBox[{"wall", "-", 
      RowBox[{"clock", " ", "cap", " ", 
       RowBox[{"(", "s", ")"}], " ", "on", " ", "a", " ", "single", " ", 
       "run"}]}], ";", " ", 
     RowBox[{"Infinity", " ", "disables"}]}]},
   {"\"\<NumberOfSubkernels\>\"", "1", 
    RowBox[{
     RowBox[{"(", "FIESTA", ")"}], " ", "parallel", " ", "subkernels"}]},
   {"\"\<NumberOfLinks\>\"", "4", 
    RowBox[{
     RowBox[{"(", "FIESTA", ")"}], " ", "MathLink", " ", "links"}]},
   {"\"\<Strategy\>\"", "\"\<S2\>\"", 
    RowBox[{
     RowBox[{
      RowBox[{"(", "FIESTA", ")"}], " ", "sector"}], "-", 
     RowBox[{"decomposition", " ", "strategy"}]}]},
   {"\"\<ComplexMode\>\"", "Automatic", 
    RowBox[{
     RowBox[{
      RowBox[{"(", "FIESTA", ")"}], " ", "complex"}], "-", 
     RowBox[{"contour", " ", "mode"}]}]},
   {"\"\<AMFlowIBPReducer\>\"", "\"\<FiniteFlow+LiteRed\>\"", 
    RowBox[{
     RowBox[{
      RowBox[{"(", "AMFlow", ")"}], " ", "IBP"}], "-", 
     RowBox[{"reduction", " ", "backend"}]}]},
   {"\"\<AMFlowPrecision\>\"", "16", 
    RowBox[{
     RowBox[{"(", "AMFlow", ")"}], " ", "working", " ", "precision", " ", 
     RowBox[{"(", "digits", ")"}]}]},
   {"\"\<AMFlowFamily\>\"", "Automatic", 
    RowBox[{
     RowBox[{
      RowBox[{"(", "AMFlow", ")"}], " ", "integral"}], "-", 
     RowBox[{"family", " ", "specification"}]}]},
   {"\"\<AMFlowNThread\>\"", "4", 
    RowBox[{
     RowBox[{"(", "AMFlow", ")"}], " ", "worker", " ", "threads"}]},
   {"\"\<FeyntropLambda\>\"", "0", 
    RowBox[{
     RowBox[{
      RowBox[{"(", "feyntrop", ")"}], " ", "contour"}], "-", 
     RowBox[{"deformation", " ", "parameter"}]}]},
   {"\"\<FeyntropSeed\>\"", "0", 
    RowBox[{
     RowBox[{
      RowBox[{"(", "feyntrop", ")"}], " ", "tropical"}], "-", 
     RowBox[{"sampling", " ", "RNG", " ", "seed"}]}]},
   {"\"\<FeyntropNThread\>\"", "Automatic", 
    RowBox[{
     RowBox[{"(", "feyntrop", ")"}], " ", "worker", " ", "threads"}]}
  },
  GridBoxAlignment->{"Columns" -> {Left, Left, Left}},
  GridBoxDividers->{"Rows" -> {True, {False}, True}}]], "OptionsTable",Express\
ionUUID->"69b83711-6347-456e-981b-83967c790b15"]
}, Open  ]],

