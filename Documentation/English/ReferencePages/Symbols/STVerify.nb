Cell["\<\
Cross-check a symbolic result against a fresh numerical evaluation; returns \
an Association whose \"pass\" key is True when the relative error is below \
Tolerance.  Requires a numerical backend.\
\>", "ExampleText",ExpressionUUID->"8f88b7af-8ee1-4d7c-87ac-bc3dccab8010"],

Cell[BoxData[
 RowBox[{"ConfigureSubTropica", "[", 
  RowBox[{
  "PythonPath", " ", "->", " ", "\"\<.venvs/subtropica312/bin/python\>\""}], 
  "]"}]], "Input",ExpressionUUID->"24dfba7b-9701-47a8-8a46-b4b3e4bfb2e3"],

Cell[BoxData[
 RowBox[{"STVerify", "[", 
  RowBox[{"diag", ",", " ", 
   RowBox[{"STIntegrate", "[", "diag", "]"}]}], "]"}]], "Input",ExpressionUUID\
->"5f8656c9-8291-4a52-9f93-53e93a533418"]
}, Open  ]],

