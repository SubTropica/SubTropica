Cell["FeynmanPlot", "ObjectName",ExpressionUUID->"112085a0-4ad9-4738-9b9e-4565cc8beb8a"],

Cell[BoxData[GridBox[{
   {Cell[TextData[{
     StyleBox["FeynmanPlot[{edges, nodes}]", "TI"],
     " \[LineSeparator]visualizes a Feynman diagram specified in the SOFIA / \
