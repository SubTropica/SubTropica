Cell["FeynmanPlot", "ObjectName",ExpressionUUID->"6b7ec79e-73f7-4291-b60a-489c63551a3f"],

Cell[BoxData[GridBox[{
   {Cell[TextData[{
     StyleBox["FeynmanPlot[{edges, nodes}]", "TI"],
     " \[LineSeparator]visualizes a Feynman diagram specified in the SOFIA / \
SubTropica convention. The option \"LabelInternalEdges\" -> True additionally \
numbers the internal edges in the order they were drawn."
    }], "TableText",ExpressionUUID->"d047769c-22e3-4bd7-ab00-ec63c47c9700"]}
