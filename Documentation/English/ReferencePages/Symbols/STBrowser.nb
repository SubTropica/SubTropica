   ButtonData->"paclet:SubTropica/ref/FeynmanIntegrate"]], "InlineFormula",
  ExpressionUUID->"71151635-3995-441d-8941-41f930133fc4"],
 " \[EmptyVerySmallSquare] ",
 Cell[BoxData[
  ButtonBox["STStop",
   BaseStyle->"Link",
   ButtonData->"paclet:SubTropica/ref/STStop"]], "InlineFormula",
  ExpressionUUID->"dd5d9fa4-bff2-486d-8824-22d508fd913c"]
}], "SeeAlso",ExpressionUUID->"f809f1ee-9bf3-4e29-b1ff-416ce34f4279"]
}, Open  ]],

