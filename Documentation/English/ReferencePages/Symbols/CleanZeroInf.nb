Notebook[{

Cell[CellGroupData[{
Cell["CleanZeroInf", "ObjectName",ExpressionUUID->"d9c3ced3-f216-4063-8336-85572e99e6f1"],

Cell[BoxData[GridBox[{
   {Cell[TextData[{
     StyleBox["CleanZeroInf", "TI"],
     " \[LineSeparator]While HyperIntica is the main (analytic) integration \
routine working under the hood of the STIntegrate function, it can also be \
used as a standalone function."
    }], "TableText",ExpressionUUID->"5c1b54e1-30fa-423b-8a6d-c08a3d23f007"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Usage",
 CellID->1,ExpressionUUID->"f9d13bc9-3a42-429c-a1d5-775c3a184a04"],

Cell["\<\
While HyperIntica is the main (analytic) integration routine working under \
the hood of the STIntegrate function, it can also be used as a standalone \
function. It evaluates iterated integrals \[Integral]_0^\[Infinity] \
\[Ellipsis] \[Integral]_0^\[Infinity] f\\, dx_1 \[Ellipsis] dx_n in  for \
expressions built from hyperlogarithms, polylogarithms, logarithms, and \
rational functions, returning results in terms of multi-zeta values and \
hyperlogarithms in the original integrand f parameters (if any). The syntax \
is: (see example below)\
\>", "Notes",ExpressionUUID->"05d26c73-0e6b-484c-9af9-65212e657e0c"],

Cell[BoxData[
 RowBox[{"HyperIntica", "[", 
  RowBox[{"integrand", ",", " ", "variables", ",", " ", 
   RowBox[{"\"\<Monitor\>\"", " ", "->", " ", "False"}]}], "]"}]], "Input",Exp\
ressionUUID->"5da9e190-9545-4085-b698-cefa5ef55fb5"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Details", "Section",ExpressionUUID->"79166f93-1fff-48ad-aa97-f0e5eaa824d9"],

Cell["Required arguments", "Subsection",ExpressionUUID->"4292fe3b-3a79-494b-a92c-268ac5fb6c9b"],

Cell["\<\
The argument integrand accepts either a symbolic expression involving Hlog, \
Mpl, PolyLog, logarithms and/or rational functions. The argument \
variables\\,= {x_1, ..., x_n} is the ordered list of integration variables, \
each x_i integrated, left to right, from 0 to \[Infinity] by default.\
\>", "Text",ExpressionUUID->"efb07abf-985a-4495-8f96-0d780a793396"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[GridBox[{
    {
     StyleBox[
      RowBox[{"Basic", " ", "Examples"}], "PrimaryExamplesSection"], 
     ButtonBox[
      RowBox[{
       RowBox[{"More", " ", "Examples"}], " ", "\[RightTriangle]"}],
      BaseStyle->"ExtendedExamplesLink",
      ButtonData:>"ExtendedExamples"]}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"a08e9d03-e8dc-\
4132-ab04-3ba985be8cbd"],

Cell["\<\
CleanZeroInf applies the MZV-cleanup chain to a raw HyperIntica result; here \
it yields -3 mzv[2]/2 = -Pi^2/4.\
\>", "ExampleText",ExpressionUUID->"935944bf-5a37-424c-9470-424b79e65dd1"],

Cell[BoxData[
 RowBox[{
  RowBox[{"HyperIntica", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Log", "[", "z", "]"}], "/", 
     RowBox[{"(", 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{"z", "^", "2"}]}], ")"}]}], ",", " ", 
    RowBox[{"{", "z", "}"}]}], "]"}], " ", "//", " ", 
  "CleanZeroInf"}]], "Input",ExpressionUUID->"b0cec405-c75f-4b47-a0d5-\
34e8ade88ab3"]
}, Open  ]],

