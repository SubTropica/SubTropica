      ButtonData:>"ExtendedExamples"]}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"14938d00-62bc-\
4dae-9afb-5aa57e07d611"],

Cell["\<\
ZeroInfPeriod is the inert head for a regularized period; convert it with \
ZeroInfPeriodAsMpl.\
\>", "ExampleText",ExpressionUUID->"f94ed50f-e2eb-49d5-9c6d-42f7f0588c7a"],

Cell[BoxData[
 RowBox[{
  RowBox[{"ZeroInfPeriod", "[", 
   RowBox[{"{", 
    RowBox[{"X13", "/", "X24"}], "}"}], "]"}], " ", "/.", " ", 
  RowBox[{"ZeroInfPeriod", " ", "->", " ", "ZeroInfPeriodAsMpl"}]}]], "Input",\
ExpressionUUID->"3e166cbe-70be-4749-a01a-ed078e5e4dd5"],

Cell[BoxData[
 RowBox[{"-", 
  RowBox[{"Log", "[", 
   RowBox[{"-", 
    FractionBox["X13", "X24"]}], "]"}]}]], "Output",ExpressionUUID->"3bbc61a9-\
99d5-484e-b0c6-4516d1423774"]
}, Open  ]],

