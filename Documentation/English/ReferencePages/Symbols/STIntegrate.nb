Cell["Options", "OptionsSection",ExpressionUUID->"d5e64e8a-4e02-4641-b570-38f6c93b34ef"],

Cell[BoxData[GridBox[{
   {"\"\<Order\>\"", "Automatic", 
    RowBox[{"expansion", " ", "order", " ", "in", " ", "\[CurlyEpsilon]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Automatic", " ", "=", " ", 
        RowBox[{"through", " ", 
         RowBox[{"\[CurlyEpsilon]", "^", "0"}]}]}], ",", " ", 
       RowBox[{"the", " ", "finite", " ", "part"}]}], ")"}]}]},
   {"\"\<Dimension\>\"", 
    RowBox[{"4", " ", "-", " ", 
     RowBox[{"2", " ", "eps"}]}], 
    RowBox[{"spacetime", " ", "dimension"}]},
   {"\"\<Normalization\>\"", "Automatic", 
    RowBox[{"overall", " ", "prefactor", " ", 
     RowBox[{"(", 
      RowBox[{"Automatic", " ", "=", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"L", " ", "\[CurlyEpsilon]", " ", "\[Gamma]"}], "]"}]}], 
      ")"}]}]},
   {"\"\<Substitutions\>\"", 
    RowBox[{"{", "}"}], 
    RowBox[{"kinematic", " ", "replacement", " ", "rules"}]},
   {"\"\<EuclideanRegionQ\>\"", "False", 
    RowBox[{
     RowBox[{
      RowBox[{
      "True", " ", "flips", " ", "every", " ", "Mandelstam", " ", "invariant",
        " ", "s"}], " ", "\[Rule]", " ", 
      RowBox[{"-", "s"}]}], ",", " ", 
     RowBox[{
     "continuing", " ", "physical", " ", "kinematics", " ", "to", " ", "the", 
      " ", "Euclidean", " ", "region"}]}]},
   {"\"\<Representation\>\"", "\"\<Schwinger\>\"", 
    RowBox[{"\"\<Schwinger\>\"", " ", "or", " ", "\"\<LeePomeransky\>\""}]},
   {"\"\<Exponents\>\"", "Automatic", 
    RowBox[{
     RowBox[{"propagator", "/", "numerator"}], " ", "exponents"}]},
   {"\"\<LoopMomenta\>\"", "Automatic", 
    RowBox[{"loop", " ", "momenta", " ", 
     RowBox[{"(", 
      RowBox[{"auto", "-", 
       RowBox[{"detected", " ", "as", " ", 
        RowBox[{"l", "[", "i", "]"}]}]}], ")"}]}]},
   {"\"\<Gauge\>\"", "Automatic", 
    RowBox[{"gauge", " ", "choice", " ", 
     RowBox[{"(", 
      RowBox[{"Automatic", " ", "scans", " ", "all"}], ")"}]}]},
   {"\"\<IncludeGauges\>\"", "All", 
