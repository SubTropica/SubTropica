Cell[CellGroupData[{

Cell["Gauge", "ExampleSubsection",ExpressionUUID->"9f4705e8-e63c-4fc8-bdf8-c92deab5615c"],

Cell["Fix a specific gauge instead of scanning:", "ExampleText",ExpressionUUID->"537d2ce6-9004-490c-9319-88821ce351f4"],

Cell[BoxData[
 RowBox[{"STIntegrate", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"l", "[", "1", "]"}], "^", "2"}], ",", " ", 
     RowBox[{
      RowBox[{"(", 
