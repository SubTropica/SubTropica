Cell[CellGroupData[{

Cell["Gauge", "ExampleSubsection",ExpressionUUID->"c3d37144-5513-4bb3-a0df-22b1dbc6e02b"],

Cell["Fix a specific gauge instead of scanning:", "ExampleText",ExpressionUUID->"8eef1ff9-a813-4624-8fc2-9855968e6796"],

Cell[BoxData[
 RowBox[{"STIntegrate", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"l", "[", "1", "]"}], "^", "2"}], ",", " ", 
     RowBox[{
      RowBox[{"(", 
