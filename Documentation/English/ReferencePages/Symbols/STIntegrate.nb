ExpressionUUID->"a61b2e34-0788-42b2-a253-4947df5dc5ad"]
}, Open  ]],

Cell[CellGroupData[{

Cell["SelectFaces", "ExampleSubsection",ExpressionUUID->"e8bf215c-2cda-4edd-a253-d9b1a93d42d1"],

Cell["Integrate only specific tropical faces:", "ExampleText",ExpressionUUID->"7d75c8cd-21d0-4efc-b13d-edcc9b29d4b9"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"First", " ", "obtain", " ", "a", " ", "checkpoint"}], " ", "*)"}],
   "\n", 
  RowBox[{
   RowBox[{"stage", " ", "=", " ", 
    RowBox[{"STIntegrate", "[", 
     RowBox[{"diag", ",", " ", 
      RowBox[{"\"\<StopAt\>\"", " ", "->", 
       " ", "\"\<AfterLinearOrder\>\""}]}], "]"}]}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Integrate", " ", "faces", " ", "1", " ", "and", " ", "4", " ", "only"}], 
    " ", "*)"}], "\n", 
   RowBox[{"STIntegrate", "[", 
    RowBox[{"diag", ",", " ", 
     RowBox[{"\"\<StartAt\>\"", " ", "->", " ", 
      RowBox[{"stage", "[", "\"\<CheckpointID\>\"", "]"}]}], ",", "\n", "  ", 
     
     RowBox[{"\"\<SelectFaces\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "4"}], "}"}]}]}], "]"}]}]}]], "Input",Expression\
UUID->"102cc644-f486-411e-8b56-e41c17750b70"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Integrator", "ExampleSubsection",ExpressionUUID->"935cc45b-28b7-4089-a5e7-c189a8600c55"],

Cell["\<\
Select the symbolic integration backend explicitly. The two engines return \
the same analytic result; HyperFLINT (the default when the add-on is \
installed) is the faster:\
\>", "ExampleText",ExpressionUUID->"621fccba-052d-4b56-bfa0-ab2fa3335295"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"box", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "0"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", "0"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", "0"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "4"}], "}"}], ",", " ", "0"}], "}"}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "0"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"STIntegrate", "[", 
  RowBox[{"box", ",", " ", 
   RowBox[{"\"\<Integrator\>\"", " ", "->", " ", "\"\<HyperFLINT\>\""}]}], 
  "]"}], "\n", 
 RowBox[{"STIntegrate", "[", 
  RowBox[{"box", ",", " ", 
   RowBox[{"\"\<Integrator\>\"", " ", "->", " ", "\"\<HyperIntica\>\""}]}], 
  "]"}]}], "Input",ExpressionUUID->"62fa5d1c-b330-4702-9da0-7e33807cbab4"]
}, Open  ]],

Cell[CellGroupData[{

Cell["FindRoots", "ExampleSubsection",ExpressionUUID->"764c2bc2-82d1-4495-9efd-126d5ceb522a"],

Cell["\<\
Introduce algebraic Wm/Wp (d-log) letters for integrals whose alphabet \
contains square roots. The diagonal massive box (two opposite massive \
internal lines of mass m, two massless) is linearly reducible only once the \
roots are introduced:\
\>", "ExampleText",ExpressionUUID->"2cea42ac-c48c-4d54-8741-0dd51d69bc21"],

Cell[BoxData[
 RowBox[{"STIntegrate", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", "m"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "0"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4"}], "}"}], ",", " ", "m"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", "0"}], "}"}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "m"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "m"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "m"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "m"}], "}"}]}], "}"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<FindRoots\>\"", " ", "->", " ", "True"}]}], "]"}]], "Input",Ex\
pressionUUID->"b32de904-6064-4469-b7f3-8b77f80c6c6a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Rationalize", "ExampleSubsection",ExpressionUUID->"f3d642e6-52d9-4f31-8d75-db14f66567f3"],

Cell["\<\
(Experimental.) \"Rationalize\" is the umbrella for the per-face \
root-handling escalation: strict, then \"FindRoots\" algebraic letters, then \
an Euler change of variables that rationalizes a square-root letter. \
Automatic (the default) reaches the rationalization rung only as a last \
resort; True forces it available, False stops at algebraic letters:\
\>", "ExampleText",ExpressionUUID->"eeb60daa-d833-4a73-916d-344f21d7ff74"],

Cell[BoxData[
 RowBox[{"STIntegrate", "[", 
  RowBox[{"diag", ",", " ", 
   RowBox[{"\"\<Rationalize\>\"", " ", "->", " ", "True"}]}], "]"}]], "Input",\
ExpressionUUID->"5ea7d634-831e-4ecf-b335-6d13c653ed87"],

Cell["\<\
Only a single genus-zero (conic) radicand in the terminal integration \
variable is rationalized; degree \[GreaterEqual] 3 / elliptic radicands, \
several coupled roots, or roots in more than one variable are reported as not \
linearly reducible. \"Rationalize\" supersedes the deprecated \"Carry\" \
option.\
\>", "ExampleText",ExpressionUUID->"4c70b318-777f-44cd-bc6f-07c7b3aecd3f"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Applications", "ExampleSection",ExpressionUUID->"897eeb4c-3241-4923-8ef2-a1835b002362"],

Cell["\<\
Evaluate a rank-1 tensor triangle integral entering the one-loop QED electron \
vertex correction (the building block whose magnetic form factor yields the \
Schwinger term a_e = \[Alpha]/(2 \[Pi])). The triangle has two massive \
propagators (electron mass m) and one massless propagator (photon), with a \
numerator from the QED vertex. (These kinematics put the electrons on-shell, \
so the integral has no Euclidean region and is not STVerify-able.):\
\>", "ExampleText",ExpressionUUID->"fe0a6143-db59-4949-932f-9f92cd8b5b3d"],

Cell[BoxData[
 RowBox[{"STIntegrate", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"l", "[", "1", "]"}], " ", "-", " ", 
        RowBox[{"p", "[", "2", "]"}]}], ")"}], "^", "2"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"m", "^", "2"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"l", "[", "1", "]"}]}], " ", "+", " ", 
         RowBox[{"p", "[", "1", "]"}], " ", "+", " ", 
         RowBox[{"p", "[", "2", "]"}]}], ")"}], "^", "2"}]}], ",", "\n", 
     "   ", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"m", "^", "2"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"l", "[", "1", "]"}], "^", "2"}]}], ",", "\n", "   ", 
     RowBox[{"q", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"l", "[", "1", "]"}], " ", "-", " ", 
        RowBox[{"p", "[", "2", "]"}]}], ")"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"\"\<Exponents\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1", ",", " ", "1", ",", " ", 
      RowBox[{"-", "1"}]}], "}"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<Substitutions\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"M", "[", "1", "]"}], " ", "->", " ", "m"}], ",", " ", 
      RowBox[{
       RowBox[{"M", "[", "2", "]"}], " ", "->", " ", "m"}], ",", " ", 
      RowBox[{
       RowBox[{"M", "[", "3", "]"}], " ", "->", " ", "0"}]}], "}"}]}], ",", 
   "\n", "  ", 
   RowBox[{"\"\<CleanOutput\>\"", " ", "->", " ", "True"}]}], "]"}]], "Input",\
ExpressionUUID->"c521b6c0-79ba-464a-a3c6-f7e2503e6a17"]
}, Open  ]]
}, Open  ]],

