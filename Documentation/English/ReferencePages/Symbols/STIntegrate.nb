Cell[CellGroupData[{

Cell["StopAt and StartAt", "ExampleSubsection",ExpressionUUID->"f7859a96-a55e-4ad6-973b-4c9fc4fc8063"],

Cell["Pause the pipeline after building the integrand:", "ExampleText",ExpressionUUID->"28b81ad3-e20a-4c88-a780-14ae4dc16757"],

Cell[BoxData[
 RowBox[{"result", " ", "=", " ", 
  RowBox[{"STIntegrate", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"l", "[", "1", "]"}], "^", "2"}], ",", " ", 
      RowBox[{
       RowBox[{"(", 
