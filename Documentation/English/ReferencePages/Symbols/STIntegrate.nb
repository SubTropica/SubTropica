ExpressionUUID->"01bc9ad7-3ad7-4731-890e-0a045c729033"]
}, Open  ]],

Cell[CellGroupData[{

Cell["SelectFaces", "ExampleSubsection",ExpressionUUID->"10cec1cd-3516-41c3-89df-5475c173a914"],

Cell["Integrate only specific tropical faces:", "ExampleText",ExpressionUUID->"0072ebb7-326b-4d7b-895e-e93b041aa247"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"First", " ", "obtain", " ", "a", " ", "checkpoint"}], " ", "*)"}],
   "\n", 
  RowBox[{
   RowBox[{"stage", " ", "=", " ", 
    RowBox[{"STIntegrate", "[", 
     RowBox[{"diag", ",", " ", 
      RowBox[{"\"\<StopAt\>\"", " ", "->", 
       " ", "\"\<AfterLinearOrder\>\""}]}], "]"}]}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Integrate", " ", "faces", " ", "1", " ", "and", " ", "4", " ", "only"}], 
    " ", "*)"}], "\n", 
   RowBox[{"STIntegrate", "[", 
    RowBox[{"diag", ",", " ", 
     RowBox[{"\"\<StartAt\>\"", " ", "->", " ", 
      RowBox[{"stage", "[", "\"\<CheckpointID\>\"", "]"}]}], ",", "\n", "  ", 
     
     RowBox[{"\"\<SelectFaces\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "4"}], "}"}]}]}], "]"}]}]}]], "Input",Expression\
UUID->"cf3211d5-cda8-4228-83c8-8a8053f7addb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Integrator", "ExampleSubsection",ExpressionUUID->"c28e0ab3-c28c-4071-b299-5c9c80482a7d"],

Cell["\<\
Select the symbolic integration backend explicitly. The two engines return \
the same analytic result; HyperFLINT (the default when the add-on is \
installed) is the faster:\
\>", "ExampleText",ExpressionUUID->"145c23c6-8281-4e4b-b573-6c673b179fd4"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"box", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "0"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", "0"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", "0"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "4"}], "}"}], ",", " ", "0"}], "}"}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "0"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"STIntegrate", "[", 
  RowBox[{"box", ",", " ", 
   RowBox[{"\"\<Integrator\>\"", " ", "->", " ", "\"\<HyperFLINT\>\""}]}], 
  "]"}], "\n", 
 RowBox[{"STIntegrate", "[", 
  RowBox[{"box", ",", " ", 
   RowBox[{"\"\<Integrator\>\"", " ", "->", " ", "\"\<HyperIntica\>\""}]}], 
  "]"}]}], "Input",ExpressionUUID->"54f644aa-fe0f-40d0-babd-beec70b740a1"]
}, Open  ]],

Cell[CellGroupData[{

Cell["FindRoots", "ExampleSubsection",ExpressionUUID->"58091ff4-80a2-42be-a100-0704a4b60338"],

Cell["\<\
Introduce algebraic Wm/Wp (d-log) letters for integrals whose alphabet \
contains square roots. The diagonal massive box (two opposite massive \
internal lines of mass m, two massless) is linearly reducible only once the \
roots are introduced:\
\>", "ExampleText",ExpressionUUID->"fc9ca0f7-c62e-4269-a702-ff8507c7df2a"],

Cell[BoxData[
 RowBox[{"STIntegrate", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", "m"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "0"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4"}], "}"}], ",", " ", "m"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", "0"}], "}"}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "m"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "m"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "m"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "m"}], "}"}]}], "}"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<FindRoots\>\"", " ", "->", " ", "True"}]}], "]"}]], "Input",Ex\
pressionUUID->"ee5e68c6-5794-486d-8667-87fa24766c7c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Rationalize", "ExampleSubsection",ExpressionUUID->"82679d3c-fd44-4c85-8390-959d3a2e9a20"],

Cell["\<\
(Experimental.) \"Rationalize\" is the umbrella for the per-face \
root-handling escalation: strict, then \"FindRoots\" algebraic letters, then \
an Euler change of variables that rationalizes a square-root letter. \
Automatic (the default) reaches the rationalization rung only as a last \
resort; True forces it available, False stops at algebraic letters:\
\>", "ExampleText",ExpressionUUID->"d8796aa2-69b4-43b6-808c-26e27081adbf"],

Cell[BoxData[
 RowBox[{"STIntegrate", "[", 
  RowBox[{"diag", ",", " ", 
   RowBox[{"\"\<Rationalize\>\"", " ", "->", " ", "True"}]}], "]"}]], "Input",\
ExpressionUUID->"c95b55d7-df6b-4e83-b46a-b1eeed543444"],

Cell["\<\
Only a single genus-zero (conic) radicand in the terminal integration \
variable is rationalized; degree \[GreaterEqual] 3 / elliptic radicands, \
several coupled roots, or roots in more than one variable are reported as not \
linearly reducible. \"Rationalize\" supersedes the deprecated \"Carry\" \
option.\
\>", "ExampleText",ExpressionUUID->"ecd583ed-b37e-4bba-be17-7affd6f0af19"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Applications", "ExampleSection",ExpressionUUID->"176f65a3-3838-4ca5-96e8-21228c9aebe9"],

Cell["\<\
Evaluate a rank-1 tensor triangle integral entering the one-loop QED electron \
vertex correction (the building block whose magnetic form factor yields the \
Schwinger term a_e = \[Alpha]/(2 \[Pi])). The triangle has two massive \
propagators (electron mass m) and one massless propagator (photon), with a \
numerator from the QED vertex. (These kinematics put the electrons on-shell, \
so the integral has no Euclidean region and is not STVerify-able.):\
\>", "ExampleText",ExpressionUUID->"7ca3b665-6e44-4d8f-b66a-bfc692ee432b"],

Cell[BoxData[
 RowBox[{"STIntegrate", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"l", "[", "1", "]"}], " ", "-", " ", 
        RowBox[{"p", "[", "2", "]"}]}], ")"}], "^", "2"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"m", "^", "2"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"l", "[", "1", "]"}]}], " ", "+", " ", 
         RowBox[{"p", "[", "1", "]"}], " ", "+", " ", 
         RowBox[{"p", "[", "2", "]"}]}], ")"}], "^", "2"}]}], ",", "\n", 
     "   ", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"m", "^", "2"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"l", "[", "1", "]"}], "^", "2"}]}], ",", "\n", "   ", 
     RowBox[{"q", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"l", "[", "1", "]"}], " ", "-", " ", 
        RowBox[{"p", "[", "2", "]"}]}], ")"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"\"\<Exponents\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1", ",", " ", "1", ",", " ", 
      RowBox[{"-", "1"}]}], "}"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<Substitutions\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"M", "[", "1", "]"}], " ", "->", " ", "m"}], ",", " ", 
      RowBox[{
       RowBox[{"M", "[", "2", "]"}], " ", "->", " ", "m"}], ",", " ", 
      RowBox[{
       RowBox[{"M", "[", "3", "]"}], " ", "->", " ", "0"}]}], "}"}]}], ",", 
   "\n", "  ", 
   RowBox[{"\"\<CleanOutput\>\"", " ", "->", " ", "True"}]}], "]"}]], "Input",\
ExpressionUUID->"dd76f627-47fa-40fc-9ba7-e289edc22b87"]
}, Open  ]]
}, Open  ]],

