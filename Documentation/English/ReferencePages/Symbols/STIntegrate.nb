Cell[CellGroupData[{

Cell["Gauge", "ExampleSubsection",ExpressionUUID->"e19155d9-9dc7-489e-9aab-396836ffce62"],

Cell["Fix a specific gauge instead of scanning:", "ExampleText",ExpressionUUID->"fb9ee233-4a3f-4e93-9b05-31880c4aafc5"],

Cell[BoxData[
 RowBox[{"STIntegrate", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"l", "[", "1", "]"}], "^", "2"}], ",", " ", 
     RowBox[{
      RowBox[{"(", 
