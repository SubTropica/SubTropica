Cell[BoxData[GridBox[{
   {"\"\<Order\>\"", "Automatic", 
    RowBox[{"expansion", " ", "order", " ", "in", " ", "\[CurlyEpsilon]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Automatic", " ", "=", " ", 
        RowBox[{"through", " ", 
         RowBox[{"\[CurlyEpsilon]", "^", "0"}]}]}], ",", " ", 
       RowBox[{"the", " ", "finite", " ", "part"}]}], ")"}]}]},
   {"\"\<Dimension\>\"", 
