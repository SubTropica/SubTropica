Cell[CellGroupData[{

Cell["SelectFaces", "ExampleSubsection",ExpressionUUID->"1985e07a-a1ac-49ea-a959-47b26e7f3b5c"],

Cell["Integrate only specific tropical faces:", "ExampleText",ExpressionUUID->"578efb0b-d1c2-4929-970e-06c0a05f8c53"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"First", " ", "obtain", " ", "a", " ", "checkpoint"}], " ", "*)"}],
   "\n", 
  RowBox[{
   RowBox[{"stage", " ", "=", " ", 
    RowBox[{"STIntegrate", "[", 
     RowBox[{"diag", ",", " ", 
      RowBox[{"\"\<StopAt\>\"", " ", "->", 
       " ", "\"\<AfterLinearOrder\>\""}]}], "]"}]}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Integrate", " ", "faces", " ", "1", " ", "and", " ", "4", " ", "only"}], 
    " ", "*)"}], "\n", 
   RowBox[{"STIntegrate", "[", 
    RowBox[{"diag", ",", " ", 
     RowBox[{"\"\<StartAt\>\"", " ", "->", " ", 
      RowBox[{"stage", "[", "\"\<CheckpointID\>\"", "]"}]}], ",", "\n", "  ", 
     
     RowBox[{"\"\<SelectFaces\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "4"}], "}"}]}]}], "]"}]}]}]], "Input",Expression\
UUID->"323091dd-025d-49cf-bc28-5dfad329fa02"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Integrator", "ExampleSubsection",ExpressionUUID->"586434de-102c-434a-b156-b40d3d9d5a51"],

Cell["\<\
Select the symbolic integration backend explicitly. The two engines return \
the same analytic result; HyperFLINT (the default when the add-on is \
installed) is the faster:\
\>", "ExampleText",ExpressionUUID->"5623fd21-916b-40d6-a856-a1319c637fbb"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"box", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "0"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", "0"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", "0"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "4"}], "}"}], ",", " ", "0"}], "}"}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "0"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"STIntegrate", "[", 
  RowBox[{"box", ",", " ", 
   RowBox[{"\"\<Integrator\>\"", " ", "->", " ", "\"\<HyperFLINT\>\""}]}], 
  "]"}], "\n", 
 RowBox[{"STIntegrate", "[", 
  RowBox[{"box", ",", " ", 
   RowBox[{"\"\<Integrator\>\"", " ", "->", " ", "\"\<HyperIntica\>\""}]}], 
  "]"}]}], "Input",ExpressionUUID->"474302e0-eab6-404c-9681-8c3b3a6b6b8a"]
}, Open  ]],

Cell[CellGroupData[{

Cell["FindRoots", "ExampleSubsection",ExpressionUUID->"e177529d-84bb-4c9c-b119-6e94c31a5899"],

Cell["\<\
Introduce algebraic Wm/Wp (d-log) letters for integrals whose alphabet \
contains square roots. The diagonal massive box (two opposite massive \
internal lines of mass m, two massless) is linearly reducible only once the \
roots are introduced:\
\>", "ExampleText",ExpressionUUID->"75e37b21-1014-4016-a54e-f9eb699d0073"],

Cell[BoxData[
 RowBox[{"STIntegrate", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", "m"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "0"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4"}], "}"}], ",", " ", "m"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", "0"}], "}"}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "m"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "m"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "m"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "m"}], "}"}]}], "}"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<FindRoots\>\"", " ", "->", " ", "True"}]}], "]"}]], "Input",Ex\
pressionUUID->"6b4db0cf-2dfc-4174-9969-700f598bcf23"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Rationalize", "ExampleSubsection",ExpressionUUID->"094b5c97-5b7f-4a5f-8275-729d20e89a40"],

Cell["\<\
(Experimental.) \"Rationalize\" is the umbrella for the per-face \
root-handling escalation: strict, then \"FindRoots\" algebraic letters, then \
an Euler change of variables that rationalizes a square-root letter. \
Automatic (the default) reaches the rationalization rung only as a last \
resort; True forces it available, False stops at algebraic letters:\
\>", "ExampleText",ExpressionUUID->"d7adfa3c-3045-46ba-ac09-319cf84493c3"],

Cell[BoxData[
 RowBox[{"STIntegrate", "[", 
  RowBox[{"diag", ",", " ", 
   RowBox[{"\"\<Rationalize\>\"", " ", "->", " ", "True"}]}], "]"}]], "Input",\
ExpressionUUID->"b543ee94-1aa2-48f7-b3ac-a7c1350903b5"],

Cell["\<\
Only a single genus-zero (conic) radicand in the terminal integration \
variable is rationalized; degree \[GreaterEqual] 3 / elliptic radicands, \
several coupled roots, or roots in more than one variable are reported as not \
linearly reducible. \"Rationalize\" supersedes the deprecated \"Carry\" \
option.\
\>", "ExampleText",ExpressionUUID->"c35f6090-8ad0-4d15-8511-9465214eb1cf"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Applications", "ExampleSection",ExpressionUUID->"4c969945-00a7-48b7-bbcc-4f9c367cb0f2"],

Cell["\<\
Evaluate a rank-1 tensor triangle integral entering the one-loop QED electron \
vertex correction (the building block whose magnetic form factor yields the \
Schwinger term a_e = \[Alpha]/(2 \[Pi])). The triangle has two massive \
propagators (electron mass m) and one massless propagator (photon), with a \
numerator from the QED vertex. (These kinematics put the electrons on-shell, \
so the integral has no Euclidean region and is not STVerify-able.):\
\>", "ExampleText",ExpressionUUID->"c17a531f-3ac1-4c2b-9228-37ee3e581b85"],

Cell[BoxData[
 RowBox[{"STIntegrate", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"l", "[", "1", "]"}], " ", "-", " ", 
        RowBox[{"p", "[", "2", "]"}]}], ")"}], "^", "2"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"m", "^", "2"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"l", "[", "1", "]"}]}], " ", "+", " ", 
         RowBox[{"p", "[", "1", "]"}], " ", "+", " ", 
         RowBox[{"p", "[", "2", "]"}]}], ")"}], "^", "2"}]}], ",", "\n", 
     "   ", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"m", "^", "2"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"l", "[", "1", "]"}], "^", "2"}]}], ",", "\n", "   ", 
     RowBox[{"q", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"l", "[", "1", "]"}], " ", "-", " ", 
        RowBox[{"p", "[", "2", "]"}]}], ")"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"\"\<Exponents\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1", ",", " ", "1", ",", " ", 
      RowBox[{"-", "1"}]}], "}"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<Substitutions\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"M", "[", "1", "]"}], " ", "->", " ", "m"}], ",", " ", 
      RowBox[{
       RowBox[{"M", "[", "2", "]"}], " ", "->", " ", "m"}], ",", " ", 
      RowBox[{
       RowBox[{"M", "[", "3", "]"}], " ", "->", " ", "0"}]}], "}"}]}], ",", 
   "\n", "  ", 
   RowBox[{"\"\<CleanOutput\>\"", " ", "->", " ", "True"}]}], "]"}]], "Input",\
ExpressionUUID->"56c7b9df-12af-43bd-8118-a0fbed2f8225"]
}, Open  ]]
}, Open  ]],

