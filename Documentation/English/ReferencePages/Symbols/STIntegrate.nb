       RowBox[{"{", 
        RowBox[{"3", ",", " ", 
         RowBox[{"M", "[", "3", "]"}]}], "}"}]}], "}"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<Substitutions\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"MM1", " ", "->", " ", 
