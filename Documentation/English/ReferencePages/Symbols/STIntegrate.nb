ExpressionUUID->"d352dd61-11c4-4eb5-a8c6-0b7a357fb440"]
}, Open  ]],

Cell[CellGroupData[{

Cell["SelectFaces", "ExampleSubsection",ExpressionUUID->"0cfdf8ea-6ab5-4283-a5a8-cc89ad0304c1"],

Cell["Integrate only specific tropical faces:", "ExampleText",ExpressionUUID->"af76ec27-38c4-4e62-9687-55b094521524"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"First", " ", "obtain", " ", "a", " ", "checkpoint"}], " ", "*)"}],
   "\n", 
  RowBox[{
   RowBox[{"stage", " ", "=", " ", 
    RowBox[{"STIntegrate", "[", 
     RowBox[{"diag", ",", " ", 
      RowBox[{"\"\<StopAt\>\"", " ", "->", 
       " ", "\"\<AfterLinearOrder\>\""}]}], "]"}]}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Integrate", " ", "faces", " ", "1", " ", "and", " ", "4", " ", "only"}], 
    " ", "*)"}], "\n", 
   RowBox[{"STIntegrate", "[", 
    RowBox[{"diag", ",", " ", 
     RowBox[{"\"\<StartAt\>\"", " ", "->", " ", 
      RowBox[{"stage", "[", "\"\<CheckpointID\>\"", "]"}]}], ",", "\n", "  ", 
     
     RowBox[{"\"\<SelectFaces\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "4"}], "}"}]}]}], "]"}]}]}]], "Input",Expression\
UUID->"02b5d177-5031-4c95-922f-9a98c1ad9d2f"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Integrator", "ExampleSubsection",ExpressionUUID->"893b2a61-fa9b-454f-91b2-f963004d7eef"],

Cell["\<\
Select the symbolic integration backend explicitly. The two engines return \
the same analytic result; HyperFLINT (the default when the add-on is \
installed) is the faster:\
\>", "ExampleText",ExpressionUUID->"0d26243f-be27-4ae7-a741-f0bd2499d60d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"box", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "0"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", "0"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", "0"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "4"}], "}"}], ",", " ", "0"}], "}"}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "0"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"STIntegrate", "[", 
  RowBox[{"box", ",", " ", 
   RowBox[{"\"\<Integrator\>\"", " ", "->", " ", "\"\<HyperFLINT\>\""}]}], 
  "]"}], "\n", 
 RowBox[{"STIntegrate", "[", 
  RowBox[{"box", ",", " ", 
   RowBox[{"\"\<Integrator\>\"", " ", "->", " ", "\"\<HyperIntica\>\""}]}], 
  "]"}]}], "Input",ExpressionUUID->"5daacbb1-5746-4e9e-9247-cb7add78da15"]
}, Open  ]],

Cell[CellGroupData[{

Cell["FindRoots", "ExampleSubsection",ExpressionUUID->"c29876f1-236f-4876-b6a8-1e028567f5e2"],

Cell["\<\
Introduce algebraic Wm/Wp (d-log) letters for integrals whose alphabet \
contains square roots. The diagonal massive box (two opposite massive \
internal lines of mass m, two massless) is linearly reducible only once the \
roots are introduced:\
\>", "ExampleText",ExpressionUUID->"103ab417-6593-4ca5-b005-05900765d281"],

Cell[BoxData[
 RowBox[{"STIntegrate", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", "m"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "0"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4"}], "}"}], ",", " ", "m"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", "0"}], "}"}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "m"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "m"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "m"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "m"}], "}"}]}], "}"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<FindRoots\>\"", " ", "->", " ", "True"}]}], "]"}]], "Input",Ex\
pressionUUID->"5668dc20-c892-4a55-b500-9cfb85289275"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Rationalize", "ExampleSubsection",ExpressionUUID->"1ea5e839-4a6b-4131-a4a5-a00438fb0cba"],

Cell["\<\
(Experimental.) \"Rationalize\" is the umbrella for the per-face \
root-handling escalation: strict, then \"FindRoots\" algebraic letters, then \
an Euler change of variables that rationalizes a square-root letter. \
Automatic (the default) reaches the rationalization rung only as a last \
resort; True forces it available, False stops at algebraic letters:\
\>", "ExampleText",ExpressionUUID->"95cd85e3-cb81-43d6-85ae-d01b8df4e1b2"],

Cell[BoxData[
 RowBox[{"STIntegrate", "[", 
  RowBox[{"diag", ",", " ", 
   RowBox[{"\"\<Rationalize\>\"", " ", "->", " ", "True"}]}], "]"}]], "Input",\
ExpressionUUID->"30f54902-c291-4efd-975b-314e5813709c"],

Cell["\<\
Only a single genus-zero (conic) radicand in the terminal integration \
variable is rationalized; degree \[GreaterEqual] 3 / elliptic radicands, \
several coupled roots, or roots in more than one variable are reported as not \
linearly reducible. \"Rationalize\" supersedes the deprecated \"Carry\" \
option.\
\>", "ExampleText",ExpressionUUID->"b75e33e8-c1a8-40fd-993f-9b68916455da"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Applications", "ExampleSection",ExpressionUUID->"96f3590f-cba9-4253-8e87-5ff2f40d483e"],

Cell["\<\
Evaluate a rank-1 tensor triangle integral entering the one-loop QED electron \
vertex correction (the building block whose magnetic form factor yields the \
Schwinger term a_e = \[Alpha]/(2 \[Pi])). The triangle has two massive \
propagators (electron mass m) and one massless propagator (photon), with a \
numerator from the QED vertex. (These kinematics put the electrons on-shell, \
so the integral has no Euclidean region and is not STVerify-able.):\
\>", "ExampleText",ExpressionUUID->"d967f87d-d08d-46b1-a601-7dd2fad5d770"],

Cell[BoxData[
 RowBox[{"STIntegrate", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"l", "[", "1", "]"}], " ", "-", " ", 
        RowBox[{"p", "[", "2", "]"}]}], ")"}], "^", "2"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"m", "^", "2"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"l", "[", "1", "]"}]}], " ", "+", " ", 
         RowBox[{"p", "[", "1", "]"}], " ", "+", " ", 
         RowBox[{"p", "[", "2", "]"}]}], ")"}], "^", "2"}]}], ",", "\n", 
     "   ", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"m", "^", "2"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"l", "[", "1", "]"}], "^", "2"}]}], ",", "\n", "   ", 
     RowBox[{"q", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"l", "[", "1", "]"}], " ", "-", " ", 
        RowBox[{"p", "[", "2", "]"}]}], ")"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"\"\<Exponents\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1", ",", " ", "1", ",", " ", 
      RowBox[{"-", "1"}]}], "}"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<Substitutions\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"M", "[", "1", "]"}], " ", "->", " ", "m"}], ",", " ", 
      RowBox[{
       RowBox[{"M", "[", "2", "]"}], " ", "->", " ", "m"}], ",", " ", 
      RowBox[{
       RowBox[{"M", "[", "3", "]"}], " ", "->", " ", "0"}]}], "}"}]}], ",", 
   "\n", "  ", 
   RowBox[{"\"\<CleanOutput\>\"", " ", "->", " ", "True"}]}], "]"}]], "Input",\
ExpressionUUID->"68902274-f650-41a3-9e37-32bf5bbc5163"]
}, Open  ]]
}, Open  ]],

