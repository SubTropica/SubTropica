}, Open  ]],

Cell[CellGroupData[{

Cell["SelectFaces", "ExampleSubsection",ExpressionUUID->"af9ae1f0-461d-4826-8be0-fc1f27339712"],

Cell["Integrate only specific tropical faces:", "ExampleText",ExpressionUUID->"33b871ea-9be7-4359-882c-3575b75135a3"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", " ", 
   RowBox[{"First", " ", "obtain", " ", "a", " ", "checkpoint"}], " ", "*)"}],
   "\n", 
  RowBox[{
   RowBox[{"stage", " ", "=", " ", 
    RowBox[{"STIntegrate", "[", 
     RowBox[{"diag", ",", " ", 
      RowBox[{"\"\<StopAt\>\"", " ", "->", 
       " ", "\"\<AfterLinearOrder\>\""}]}], "]"}]}], "\n", 
   RowBox[{"(*", " ", 
    RowBox[{
    "Integrate", " ", "faces", " ", "1", " ", "and", " ", "4", " ", "only"}], 
    " ", "*)"}], "\n", 
   RowBox[{"STIntegrate", "[", 
    RowBox[{"diag", ",", " ", 
     RowBox[{"\"\<StartAt\>\"", " ", "->", " ", 
      RowBox[{"stage", "[", "\"\<CheckpointID\>\"", "]"}]}], ",", "\n", "  ", 
     
     RowBox[{"\"\<SelectFaces\>\"", " ", "->", " ", 
      RowBox[{"{", 
       RowBox[{"1", ",", " ", "4"}], "}"}]}]}], "]"}]}]}]], "Input",Expression\
UUID->"c6b8ce66-b852-432c-8183-848b568520c8"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Integrator", "ExampleSubsection",ExpressionUUID->"bef20489-04f7-426f-b3ff-8f37dddd335e"],

Cell["\<\
Select the symbolic integration backend explicitly. The two engines return \
the same analytic result; HyperFLINT (the default when the add-on is \
installed) is the faster:\
\>", "ExampleText",ExpressionUUID->"c41c32e6-8f73-46f5-9e75-76f6360e29f8"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"box", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "0"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "3"}], "}"}], ",", " ", "0"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", "0"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "4"}], "}"}], ",", " ", "0"}], "}"}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "0"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "0"}], "}"}]}], "}"}]}], "}"}]}], 
  ";"}], "\n", 
 RowBox[{"STIntegrate", "[", 
  RowBox[{"box", ",", " ", 
   RowBox[{"\"\<Integrator\>\"", " ", "->", " ", "\"\<HyperFLINT\>\""}]}], 
  "]"}], "\n", 
 RowBox[{"STIntegrate", "[", 
  RowBox[{"box", ",", " ", 
   RowBox[{"\"\<Integrator\>\"", " ", "->", " ", "\"\<HyperIntica\>\""}]}], 
  "]"}]}], "Input",ExpressionUUID->"e38cb5cb-3f46-4d1e-b6c3-2c16ec616b23"]
}, Open  ]],

Cell[CellGroupData[{

Cell["FindRoots", "ExampleSubsection",ExpressionUUID->"723478ba-79ed-45d9-8f8d-ebcd730d121f"],

Cell["\<\
Introduce algebraic Wm/Wp (d-log) letters for integrals whose alphabet \
contains square roots. The diagonal massive box (two opposite massive \
internal lines of mass m, two massless) is linearly reducible only once the \
roots are introduced:\
\>", "ExampleText",ExpressionUUID->"ce0b4625-d960-4dcf-8730-c936c162b466"],

Cell[BoxData[
 RowBox[{"STIntegrate", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "3"}], "}"}], ",", " ", "m"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"1", ",", " ", "2"}], "}"}], ",", " ", "0"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"2", ",", " ", "4"}], "}"}], ",", " ", "m"}], "}"}], ",", 
       " ", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"3", ",", " ", "4"}], "}"}], ",", " ", "0"}], "}"}]}], 
      "}"}], ",", "\n", "   ", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"1", ",", " ", "m"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"2", ",", " ", "m"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"3", ",", " ", "m"}], "}"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"4", ",", " ", "m"}], "}"}]}], "}"}]}], "}"}], ",", "\n", 
   "  ", 
   RowBox[{"\"\<FindRoots\>\"", " ", "->", " ", "True"}]}], "]"}]], "Input",Ex\
pressionUUID->"4ad8ea3e-f5dc-4fd2-9ccf-e1bddc136fa9"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Rationalize", "ExampleSubsection",ExpressionUUID->"9ed7b0f7-88fa-49f6-95bd-41dac5de6815"],

Cell["\<\
(Experimental.) \"Rationalize\" is the umbrella for the per-face \
root-handling escalation: strict, then \"FindRoots\" algebraic letters, then \
an Euler change of variables that rationalizes a square-root letter. \
Automatic (the default) reaches the rationalization rung only as a last \
resort; True forces it available, False stops at algebraic letters:\
\>", "ExampleText",ExpressionUUID->"83db070e-5d59-4f95-8162-4e4ef24b9ff6"],

Cell[BoxData[
 RowBox[{"STIntegrate", "[", 
  RowBox[{"diag", ",", " ", 
   RowBox[{"\"\<Rationalize\>\"", " ", "->", " ", "True"}]}], "]"}]], "Input",\
ExpressionUUID->"cc01f26d-bf6a-4f33-9796-80a19cee6335"],

Cell["\<\
Only a single genus-zero (conic) radicand in the terminal integration \
variable is rationalized; degree \[GreaterEqual] 3 / elliptic radicands, \
several coupled roots, or roots in more than one variable are reported as not \
linearly reducible. \"Rationalize\" supersedes the deprecated \"Carry\" \
option.\
\>", "ExampleText",ExpressionUUID->"36b0f01b-5fb7-44e7-aa6b-c12de0cb11b1"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["Applications", "ExampleSection",ExpressionUUID->"b3875c32-17e8-4c90-8cbb-7933d18afc5e"],

Cell["\<\
Evaluate a rank-1 tensor triangle integral entering the one-loop QED electron \
vertex correction (the building block whose magnetic form factor yields the \
Schwinger term a_e = \[Alpha]/(2 \[Pi])). The triangle has two massive \
propagators (electron mass m) and one massless propagator (photon), with a \
numerator from the QED vertex. (These kinematics put the electrons on-shell, \
so the integral has no Euclidean region and is not STVerify-able.):\
\>", "ExampleText",ExpressionUUID->"9dc30f54-27e2-4759-a36e-6bf9963664ad"],

Cell[BoxData[
 RowBox[{"STIntegrate", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"l", "[", "1", "]"}], " ", "-", " ", 
        RowBox[{"p", "[", "2", "]"}]}], ")"}], "^", "2"}], ",", "\n", "   ", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"m", "^", "2"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"-", 
          RowBox[{"l", "[", "1", "]"}]}], " ", "+", " ", 
         RowBox[{"p", "[", "1", "]"}], " ", "+", " ", 
         RowBox[{"p", "[", "2", "]"}]}], ")"}], "^", "2"}]}], ",", "\n", 
     "   ", 
     RowBox[{
      RowBox[{"-", 
       RowBox[{"m", "^", "2"}]}], " ", "+", " ", 
      RowBox[{
       RowBox[{"l", "[", "1", "]"}], "^", "2"}]}], ",", "\n", "   ", 
     RowBox[{"q", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"l", "[", "1", "]"}], " ", "-", " ", 
        RowBox[{"p", "[", "2", "]"}]}], ")"}]}]}], "}"}], ",", "\n", "  ", 
   RowBox[{"\"\<Exponents\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1", ",", " ", "1", ",", " ", 
      RowBox[{"-", "1"}]}], "}"}]}], ",", "\n", "  ", 
   RowBox[{"\"\<Substitutions\>\"", " ", "->", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"M", "[", "1", "]"}], " ", "->", " ", "m"}], ",", " ", 
      RowBox[{
       RowBox[{"M", "[", "2", "]"}], " ", "->", " ", "m"}], ",", " ", 
      RowBox[{
       RowBox[{"M", "[", "3", "]"}], " ", "->", " ", "0"}]}], "}"}]}], ",", 
   "\n", "  ", 
   RowBox[{"\"\<CleanOutput\>\"", " ", "->", " ", "True"}]}], "]"}]], "Input",\
ExpressionUUID->"36d25cda-239a-4712-b32f-c96a6be85b13"]
}, Open  ]]
}, Open  ]],

