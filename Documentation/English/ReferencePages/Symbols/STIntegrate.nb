    RowBox[{"\"\<StopAt\>\"", " ", "->", 
     " ", "\"\<AfterBuildingIntegrand\>\""}]}], "]"}]}]], "Input",ExpressionUU\
ID->"492272c9-b73c-4960-9c2d-35c1237f813e"],

Cell["Resume from a checkpoint:", "ExampleText",ExpressionUUID->"5adb75af-fda4-415d-96ad-110ce7da1609"],

Cell[BoxData[
 RowBox[{"STIntegrate", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"l", "[", "1", "]"}], "^", "2"}], ",", " ", 
