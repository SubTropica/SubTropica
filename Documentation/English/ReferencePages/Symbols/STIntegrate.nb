Cell[CellGroupData[{

Cell["StopAt and StartAt", "ExampleSubsection",ExpressionUUID->"a7fa477f-95dd-4e72-a439-01c4855394ab"],

Cell["Pause the pipeline after building the integrand:", "ExampleText",ExpressionUUID->"a9ccf87b-4b52-44e0-98cf-74b3de35bc9c"],

Cell[BoxData[
 RowBox[{"result", " ", "=", " ", 
  RowBox[{"STIntegrate", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"l", "[", "1", "]"}], "^", "2"}], ",", " ", 
      RowBox[{
       RowBox[{"(", 
