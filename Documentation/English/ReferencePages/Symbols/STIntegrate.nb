Cell["Options", "OptionsSection",ExpressionUUID->"e4a67b2d-64ed-44b3-b4f0-94b8fcf07d1f"],

Cell[BoxData[GridBox[{
   {"\"\<Order\>\"", "Automatic", 
    RowBox[{"expansion", " ", "order", " ", "in", " ", "\[CurlyEpsilon]", " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"Automatic", " ", "=", " ", 
        RowBox[{"through", " ", 
         RowBox[{"\[CurlyEpsilon]", "^", "0"}]}]}], ",", " ", 
       RowBox[{"the", " ", "finite", " ", "part"}]}], ")"}]}]},
   {"\"\<Dimension\>\"", 
    RowBox[{"4", " ", "-", " ", 
     RowBox[{"2", " ", "eps"}]}], 
    RowBox[{"spacetime", " ", "dimension"}]},
   {"\"\<Normalization\>\"", "Automatic", 
    RowBox[{"overall", " ", "prefactor", " ", 
     RowBox[{"(", 
      RowBox[{"Automatic", " ", "=", " ", 
       RowBox[{"Exp", "[", 
        RowBox[{"L", " ", "\[CurlyEpsilon]", " ", "\[Gamma]"}], "]"}]}], 
      ")"}]}]},
   {"\"\<Substitutions\>\"", 
    RowBox[{"{", "}"}], 
    RowBox[{"kinematic", " ", "replacement", " ", "rules"}]},
   {"\"\<EuclideanRegionQ\>\"", "False", 
    RowBox[{
     RowBox[{
