Cell[CellGroupData[{

Cell["Gauge", "ExampleSubsection",ExpressionUUID->"9e4c69ce-4a52-4a40-a4fc-88b0c25c9092"],

Cell["Fix a specific gauge instead of scanning:", "ExampleText",ExpressionUUID->"1844728c-aa24-4851-b9d8-a8e4697d4465"],

Cell[BoxData[
 RowBox[{"STIntegrate", "[", "\n", "  ", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"l", "[", "1", "]"}], "^", "2"}], ",", " ", 
     RowBox[{
      RowBox[{"(", 
