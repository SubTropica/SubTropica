Notebook[{

Cell[CellGroupData[{
Cell["STIntegrateHF", "ObjectName",ExpressionUUID->"3d30db15-b202-45de-bfd5-d3ca279de10c"],

Cell[BoxData[GridBox[{
   {Cell[TextData[{
     StyleBox["STIntegrateHF[args...]", "TI"],
     " \[LineSeparator]is a convenience alias for STIntegrate[args..., \
\"LROrderBackend\" -> \"HyperFLINT\", \"Integrator\" -> \"HyperFLINT\"]. It \
accepts every input form that STIntegrate does (graph, propagator list, Euler \
integrand, pre-built {pref, integrand, xvars, coeffs} quadruple) and every \
option. The HF backend rules are appended to the argument list, so any \
explicit \"LROrderBackend\" / \"Integrator\" in the user args overrides them \
(first-match wins under STIntegrate's OptionValue). FindRoots is left at its \
default (Automatic) so cases that need algebraic letters route through HF's \
Phase-7 Wm/Wp path transparently."
    }], "TableText",ExpressionUUID->"0699b3b5-efbc-4697-b2ba-7f9cbd496ca5"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Usage",
 CellID->1,ExpressionUUID->"8e1e8ee7-b2c8-463b-afa7-4cdc53ec85f7"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Options", "OptionsSection",ExpressionUUID->"58a48608-a49f-409b-8450-015307378d3c"],

Cell[BoxData[GridBox[{
   {"\"\<Integrator\>\"", "\"\<HyperFLINT\>\"", 
    RowBox[{
    "forced", " ", "to", " ", "HyperFLINT", " ", "by", " ", "the", " ", 
     "alias", " ", 
     RowBox[{"(", 
      RowBox[{"override", " ", "to", " ", "change", " ", "backend"}], ")"}]}]},
   {"\"\<LROrderBackend\>\"", "\"\<HyperFLINT\>\"", 
    RowBox[{
    "forced", " ", "to", " ", "HyperFLINT", " ", "by", " ", "the", " ", 
     "alias"}]},
   {"\"\<...\>\"", "", 
    RowBox[{
     RowBox[{
      RowBox[{"accepts", " ", "every", " ", "STIntegrate", " ", "option", " ", 
       RowBox[{"(", 
        RowBox[{"see", " ", "STIntegrate"}], ")"}]}], ";", " ", 
      RowBox[{
      "the", " ", "alias", " ", "only", " ", "appends", " ", "the", " ", 
       "HyperFLINT", " ", "backend", " ", "rules"}]}], ",", " ", 
     RowBox[{
     "which", " ", "an", " ", "explicit", " ", "user", " ", "value", " ", 
      "overrides"}]}]}
  },
  GridBoxAlignment->{"Columns" -> {Left, Left, Left}},
  GridBoxDividers->{"Rows" -> {True, {False}, True}}]], "OptionsTable",Express\
ionUUID->"19eb08b2-be0e-4b4d-963d-f4ba553d4648"]
}, Open  ]],

