       RowBox[{"More", " ", "Examples"}], " ", "\[RightTriangle]"}],
      BaseStyle->"ExtendedExamplesLink",
      ButtonData:>"ExtendedExamples"]}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"d723dec6-0b56-\
4475-a64d-402e557168e7"],

Cell["\<\
Clears all HyperIntica memoization caches; call when changing parameters or \
starting a fresh calculation.\
\>", "ExampleText",ExpressionUUID->"fd3a21be-be77-4013-99a8-80691fde34a7"],

Cell[BoxData[
 RowBox[{"ForgetAllMemo", "[", "]"}]], "Input",ExpressionUUID->"d92d984e-0a0e-42fe-baa4-6faed8e9eb03"]
}, Open  ]],

