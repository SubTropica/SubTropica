       RowBox[{"More", " ", "Examples"}], " ", "\[RightTriangle]"}],
      BaseStyle->"ExtendedExamplesLink",
      ButtonData:>"ExtendedExamples"]}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"ace0ced7-eee2-\
4792-90e0-8f0e9e106237"],

Cell["\<\
Clears all HyperIntica memoization caches; call when changing parameters or \
starting a fresh calculation.\
\>", "ExampleText",ExpressionUUID->"8e96a520-9026-4c55-87d2-caff490315c2"],

Cell[BoxData[
 RowBox[{"ForgetAllMemo", "[", "]"}]], "Input",ExpressionUUID->"a6577f05-761f-4d88-a1d6-5e0eec4ffc2b"]
}, Open  ]],

