     ButtonBox[
      RowBox[{
       RowBox[{"More", " ", "Examples"}], " ", "\[RightTriangle]"}],
      BaseStyle->"ExtendedExamplesLink",
      ButtonData:>"ExtendedExamples"]}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"99d42f36-5365-\
442a-8570-f1113429e045"],

Cell["\<\
Clears all HyperIntica memoization caches; call when changing parameters or \
starting a fresh calculation.\
\>", "ExampleText",ExpressionUUID->"2dcd572d-aef1-4762-8837-6fcb8413b0b7"],

Cell[BoxData[
 RowBox[{"ForgetAllMemo", "[", "]"}]], "Input",ExpressionUUID->"43c82e90-cd33-4553-a461-7af391b510c6"]
