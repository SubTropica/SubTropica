Notebook[{

Cell[CellGroupData[{
Cell["ForgetAllMemo", "ObjectName",ExpressionUUID->"62a87904-3883-4ed9-bae1-29d57ca038ba"],

Cell[BoxData[GridBox[{
   {Cell[TextData[{
     StyleBox["ForgetAllMemo", "TI"],
     " \[LineSeparator]While HyperIntica is the main (analytic) integration \
routine working under the hood of the STIntegrate function, it can also be \
used as a standalone function."
    }], "TableText",ExpressionUUID->"873e910c-810b-4d3a-b5b3-7af66a331a3e"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Usage",
 CellID->1,ExpressionUUID->"fd528f86-f529-465c-92ed-d43ba38290cc"],

Cell["\<\
While HyperIntica is the main (analytic) integration routine working under \
the hood of the STIntegrate function, it can also be used as a standalone \
function. It evaluates iterated integrals \[Integral]_0^\[Infinity] \
\[Ellipsis] \[Integral]_0^\[Infinity] f\\, dx_1 \[Ellipsis] dx_n in  for \
expressions built from hyperlogarithms, polylogarithms, logarithms, and \
rational functions, returning results in terms of multi-zeta values and \
hyperlogarithms in the original integrand f parameters (if any). The syntax \
is: (see example below)\
\>", "Notes",ExpressionUUID->"333a2269-3166-4ccd-b38b-dda90c2cff02"],

Cell[BoxData[
 RowBox[{"HyperIntica", "[", 
  RowBox[{"integrand", ",", " ", "variables", ",", " ", 
   RowBox[{"\"\<Monitor\>\"", " ", "->", " ", "False"}]}], "]"}]], "Input",Exp\
ressionUUID->"02e660a9-7261-44d6-93e3-b8439c45cd9c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Details", "Section",ExpressionUUID->"a9c364d7-d6aa-4c23-8a18-e51c64f80f9b"],

Cell["Memoization and cache management", "Subsection",ExpressionUUID->"d2f08702-87c1-442c-8438-885dd1560139"],

Cell["\<\
During integration, {HyperIntica} accumulates several internal memoization \
caches. These persist for the duration of the session, which is beneficial \
when evaluating many related integrals, and can be cleared at any time by \
calling ForgetAllMemo in the notebook where calculations are done.\
\>", "Text",ExpressionUUID->"2b8590df-7356-461f-9c97-8c0923051584"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[GridBox[{
    {
     StyleBox[
      RowBox[{"Basic", " ", "Examples"}], "PrimaryExamplesSection"], 
     ButtonBox[
      RowBox[{
       RowBox[{"More", " ", "Examples"}], " ", "\[RightTriangle]"}],
      BaseStyle->"ExtendedExamplesLink",
      ButtonData:>"ExtendedExamples"]}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"e9b28c5e-b5a7-\
4f48-9f69-4d7813ab917d"],

Cell["\<\
Clears all HyperIntica memoization caches; call when changing parameters or \
starting a fresh calculation.\
\>", "ExampleText",ExpressionUUID->"e85778d6-21cd-4109-b8da-942bad94666b"],

Cell[BoxData[
 RowBox[{"ForgetAllMemo", "[", "]"}]], "Input",ExpressionUUID->"5c4772a9-8ec2-45a4-8fb9-e9a8b7f07958"]
}, Open  ]],

