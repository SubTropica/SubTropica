       RowBox[{"More", " ", "Examples"}], " ", "\[RightTriangle]"}],
      BaseStyle->"ExtendedExamplesLink",
      ButtonData:>"ExtendedExamples"]}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"f4dd3a37-490d-\
4e85-abe9-2c1c9c791932"],

Cell["\<\
Clears all HyperIntica memoization caches; call when changing parameters or \
starting a fresh calculation.\
\>", "ExampleText",ExpressionUUID->"29e58e4c-c8aa-41a0-a1a2-6000fa9c73e4"],

Cell[BoxData[
 RowBox[{"ForgetAllMemo", "[", "]"}]], "Input",ExpressionUUID->"c483e69d-cbfa-4c04-b04f-8e76bb81deaf"]
