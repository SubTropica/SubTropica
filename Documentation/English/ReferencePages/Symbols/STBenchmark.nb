Notebook[{

Cell[CellGroupData[{
Cell["STBenchmark", "ObjectName",ExpressionUUID->"1c858b34-bedf-4dfb-ae02-4c38ceb72ed8"],

Cell[BoxData[GridBox[{
   {Cell[TextData[{
     StyleBox["STBenchmark[]", "TI"],
     " \[LineSeparator]runs the benchmark suite defined in mgDiagrams-style \
benchmark catalogue (embedded as $stBenchmarkCasesSource): a dependency check \
(see STDependencies[]) followed by the STIntegrate / STNIntegrate cases \
exercising the supported input forms and backends. Cases run sequentially in \
the main kernel; caches are cleared between cases so that one case's state \
cannot poison the next. The file ships two splits \\[LongDash] \"Short\" (10 \
cases, default, ~smoke test) and \"Long\" (21 cases, developer regression \
coverage); pick between them with the \"Suite\" option."
    }], "TableText",ExpressionUUID->"0a188bd3-3fb5-489c-91a9-2c36d79fdb59"]},
   {Cell[TextData[{
     StyleBox["STBenchmark[selector]", "TI"],
     " \[LineSeparator]restricts the run to a subset (e.g. \"diagrams\", \
{\"nIntDiagrams\", 1 ;; 3}, or a list of case ids). Options: \"Suite\" -> \
\"Short\" | \"Long\" (which case list to load); \"Verify\" -> True | False \
(cross-check nIntDiagrams via STVerify); \"Display\" -> \"Stream\" | \"Silent\
\"; \"Baseline\" -> Automatic | None | _String (path to baseline JSON); \
\"UpdateBaseline\" -> True | False | Automatic (bake current run as the new \
baseline; Automatic writes only when no baseline exists yet); \"Report\" -> \
None | _String (write a Markdown report); \"SkipPackageCheck\" -> True | \
False. Returns Null; per-case details are stored in $STLastBenchmarkResults \
(a list of Associations) for programmatic access."
    }], "TableText",ExpressionUUID->"cb7f0aae-1153-4f53-a449-62a9a4dbc12a"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Usage",
 CellID->1,ExpressionUUID->"83e0d4f6-3539-4c09-a1b7-1ffc4cb00b57"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Options", "OptionsSection",ExpressionUUID->"d0a2f481-4289-4b0e-a14c-bb14fce29a1f"],

Cell[BoxData[GridBox[{
   {"\"\<Suite\>\"", "\"\<Short\>\"", 
    RowBox[{"case", " ", 
     RowBox[{"list", ":", " ", 
      RowBox[{"\"\<Short\>\"", " ", 
       RowBox[{"(", 
        RowBox[{"smoke", " ", "test"}], ")"}], " ", "or", " ", "\"\<Long\>\"",
        " ", 
       RowBox[{"(", 
        RowBox[{"developer", " ", "regression"}], ")"}]}]}]}]},
   {"\"\<Verify\>\"", "True", 
    RowBox[{"cross", "-", 
     RowBox[{"check", " ", "the", " ", "numerical"}], "-", 
     RowBox[{"integration", " ", "cases", " ", "via", " ", "STVerify"}]}]},
   {"\"\<Display\>\"", "\"\<Stream\>\"", 
    RowBox[{"output", " ", 
     RowBox[{"mode", ":", " ", 
      RowBox[{"\"\<Stream\>\"", " ", 
       RowBox[{"(", "live", ")"}], " ", "or", " ", "\"\<Silent\>\""}]}]}]},
   {"\"\<Baseline\>\"", "Automatic", 
    RowBox[{
     RowBox[{"baseline", " ", "JSON", " ", "to", " ", "compare", " ", 
      RowBox[{"against", ":", " ", "Automatic"}]}], ",", " ", "None", ",", 
     " ", 
     RowBox[{"or", " ", "a", " ", "path"}]}]},
   {"\"\<UpdateBaseline\>\"", "Automatic", 
    RowBox[{
     RowBox[{"bake", " ", "this", " ", "run", " ", "as", " ", "the", " ", 
      RowBox[{"baseline", ":", " ", "True"}]}], ",", " ", "False", ",", " ", 
     RowBox[{"or", " ", "Automatic", " ", 
      RowBox[{"(", 
       RowBox[{"only", " ", "if", " ", "none", " ", "exists"}], ")"}]}]}]},
   {"\"\<Report\>\"", "None", 
    RowBox[{"None", ",", " ", 
     RowBox[{
     "or", " ", "a", " ", "path", " ", "to", " ", "write", " ", "a", " ", 
      "Markdown", " ", "report"}]}]},
   {"\"\<SkipPackageCheck\>\"", "False", 
    RowBox[{"skip", " ", "the", " ", 
     RowBox[{"dependency", "/", "package"}], " ", "check", " ", "step"}]},
   {"\"\<LROrderBackend\>\"", "Automatic", 
    RowBox[{
     RowBox[{"backend", " ", "for", " ", "the", " ", "linear"}], "-", 
     RowBox[{
     "reducibility", " ", "order", " ", "search", " ", "in", " ", "the", " ", 
      "cases"}]}]},
   {"\"\<Integrator\>\"", "Automatic", 
    RowBox[{
    "symbolic", " ", "integrator", " ", "for", " ", "the", " ", "cases", " ", 
     
     RowBox[{"(", 
      RowBox[{"Automatic", " ", "=", " ", 
       RowBox[{"HyperFLINT", " ", "if", " ", "available"}]}], ")"}]}]}
  },
  GridBoxAlignment->{"Columns" -> {Left, Left, Left}},
  GridBoxDividers->{"Rows" -> {True, {False}, True}}]], "OptionsTable",Express\
ionUUID->"4278999f-0f32-4736-9a30-7a3eeebe3588"]
}, Open  ]],

