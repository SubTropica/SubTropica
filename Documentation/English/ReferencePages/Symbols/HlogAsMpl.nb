      ButtonData:>"ExtendedExamples"]}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"579e0d8d-1aed-\
412f-a7f9-3cadf2be1492"],

Cell["The hyperlogarithm Hlog[z,{0,0,1}] equals -Li3(z).", "ExampleText",ExpressionUUID->"b79adf6a-3073-4ae5-8e44-478165e57287"],

Cell[BoxData[
 RowBox[{"HlogAsMpl", "[", 
  RowBox[{"z", ",", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]], "Input",Expr\
essionUUID->"c51d5d6f-49dc-4832-9ed2-dbd5f858c104"],

Cell[BoxData[
 RowBox[{"-", 
  RowBox[{"Mpl", "[", 
   RowBox[{
    RowBox[{"{", "3", "}"}], ",", 
    RowBox[{"{", "z", "}"}]}], "]"}]}]], "Output",ExpressionUUID->"a5850060-\
903e-46a6-a553-551d7e7d8018"]
}, Open  ]],

