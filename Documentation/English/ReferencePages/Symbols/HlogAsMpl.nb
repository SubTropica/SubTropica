       RowBox[{"More", " ", "Examples"}], " ", "\[RightTriangle]"}],
      BaseStyle->"ExtendedExamplesLink",
      ButtonData:>"ExtendedExamples"]}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"58362047-776b-\
42c5-8e2d-3cf384c26b2d"],

Cell["The hyperlogarithm Hlog[z,{0,0,1}] equals -Li3(z).", "ExampleText",ExpressionUUID->"6bdadf17-4a7a-410f-8260-e6b01f5fe8e4"],

Cell[BoxData[
 RowBox[{"HlogAsMpl", "[", 
  RowBox[{"z", ",", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]], "Input",Expr\
essionUUID->"02ca8626-925e-40b2-83a4-63ce23b40355"],

Cell[BoxData[
 RowBox[{"-", 
  RowBox[{"Mpl", "[", 
   RowBox[{
    RowBox[{"{", "3", "}"}], ",", 
    RowBox[{"{", "z", "}"}]}], "]"}]}]], "Output",ExpressionUUID->"f481e512-\
0c94-4039-83ed-9d570603ae12"]
}, Open  ]],

