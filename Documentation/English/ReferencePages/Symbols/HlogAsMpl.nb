       RowBox[{"More", " ", "Examples"}], " ", "\[RightTriangle]"}],
      BaseStyle->"ExtendedExamplesLink",
      ButtonData:>"ExtendedExamples"]}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"95ab6d35-7d89-\
4c99-8d6a-2f3d424fa3af"],

Cell["The hyperlogarithm Hlog[z,{0,0,1}] equals -Li3(z).", "ExampleText",ExpressionUUID->"323f4c1d-5c46-46f7-924b-37b0989d91d1"],

Cell[BoxData[
 RowBox[{"HlogAsMpl", "[", 
  RowBox[{"z", ",", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]], "Input",Expr\
essionUUID->"131827a1-0c7c-4579-80a1-59b03cb3629c"],

Cell[BoxData[
 RowBox[{"-", 
  RowBox[{"Mpl", "[", 
   RowBox[{
    RowBox[{"{", "3", "}"}], ",", 
    RowBox[{"{", "z", "}"}]}], "]"}]}]], "Output",ExpressionUUID->"8b1086a5-\
45bc-462e-a7c3-1580e45e1c2f"]
}, Open  ]],

