       RowBox[{"More", " ", "Examples"}], " ", "\[RightTriangle]"}],
      BaseStyle->"ExtendedExamplesLink",
      ButtonData:>"ExtendedExamples"]}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"f5cfc7ee-cd23-\
4fb0-84a0-8ba9f692cad3"],

Cell["The hyperlogarithm Hlog[z,{0,0,1}] equals -Li3(z).", "ExampleText",ExpressionUUID->"5b1282fc-478c-4481-af35-e899e289ac77"],

Cell[BoxData[
 RowBox[{"HlogAsMpl", "[", 
  RowBox[{"z", ",", " ", 
   RowBox[{"{", 
    RowBox[{"0", ",", " ", "0", ",", " ", "1"}], "}"}]}], "]"}]], "Input",Expr\
essionUUID->"312c6e66-2bd8-4977-8b66-f59fe5127d0d"],

Cell[BoxData[
 RowBox[{"-", 
  RowBox[{"Mpl", "[", 
   RowBox[{
    RowBox[{"{", "3", "}"}], ",", 
    RowBox[{"{", "z", "}"}]}], "]"}]}]], "Output",ExpressionUUID->"ed28b556-\
784c-4611-ae48-c737812064dd"]
}, Open  ]],

