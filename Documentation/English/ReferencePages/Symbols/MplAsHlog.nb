       RowBox[{"More", " ", "Examples"}], " ", "\[RightTriangle]"}],
      BaseStyle->"ExtendedExamplesLink",
      ButtonData:>"ExtendedExamples"]}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"7c6e1a1a-e536-\
451b-bc19-088af5fd6c96"],

Cell["\<\
Inverse of HlogAsMpl: rewrite a multiple polylog as a hyperlogarithm at 1.\
\>", "ExampleText",ExpressionUUID->"989b9c02-7df7-4b98-beb7-500b87f4367a"],

Cell[BoxData[
 RowBox[{"MplAsHlog", "[", 
  RowBox[{
   RowBox[{"{", "2", "}"}], ",", " ", 
   RowBox[{"{", "z", "}"}]}], "]"}]], "Input",ExpressionUUID->"45d9b76a-0354-\
4428-bf72-6e4ae8611531"],

Cell[BoxData[
 RowBox[{"-", 
  RowBox[{"Hlog", "[", 
   RowBox[{"1", ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", 
      FractionBox["1", "z"]}], "}"}]}], "]"}]}]], "Output",ExpressionUUID->\
"aa5d53b0-e925-489b-8a21-1e0b5fc2bd58"]
}, Open  ]],

