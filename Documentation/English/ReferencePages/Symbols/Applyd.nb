Notebook[{

Cell[CellGroupData[{
Cell["Applyd", "ObjectName",ExpressionUUID->"af9b5357-ee21-4f96-ae84-f43c2e7331e2"],

Cell[BoxData[GridBox[{
   {Cell[TextData[{
     StyleBox["Applyd[expr, {x1, ..., xn}]", "TI"],
     " \[LineSeparator]expands every differential d[f] in expr by the chain \
rule, d[f] -> Sum_i D[f, xi] d[xi], and normalizes the resulting wedge \
products (Wedge[d[xi], d[xj]] antisymmetric, Wedge[d[xi], d[xi]] = 0). Used \
to carry the Jacobian of a change of variables: for an integrand d[x] f[x] \
the substitution x -> x/(1 + x) followed by"
    }], "TableText",ExpressionUUID->"21e7b092-620b-4211-8118-96b3801af955"]},
   {Cell[TextData[{
     StyleBox["Applyd[#, {x}]", "TI"],
     " \[LineSeparator]gives f[x/(1 + x)] D[x/(1 + x), x] d[x], and the rule \
d[x_] :> 1 then removes the measure symbol, as in the \
energy-energy-correlator example of the paper (Sec. 4.3)."
    }], "TableText",ExpressionUUID->"22555662-296c-4a21-8b1e-21507e6c3f08"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Usage",
 CellID->1,ExpressionUUID->"424e4257-b9b6-42b6-a55c-ab71930d220c"]
}, Open  ]],

Cell[CellGroupData[{

Cell["See Also", "SeeAlsoSection",ExpressionUUID->"c9bfbabc-d54b-4ba3-bca8-c804d402f3b7"],

