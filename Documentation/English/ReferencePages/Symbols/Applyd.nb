Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[GridBox[{
    {
     StyleBox[
      RowBox[{"Basic", " ", "Examples"}], "PrimaryExamplesSection"], 
     ButtonBox[
      RowBox[{
       RowBox[{"More", " ", "Examples"}], " ", "\[RightTriangle]"}],
      BaseStyle->"ExtendedExamplesLink",
      ButtonData:>"ExtendedExamples"]}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"c2300497-d350-\
49ba-866f-2cf0c53f7de1"],

Cell["\<\
The Moebius map x -> x/(1 + x) applied to the integrand d[x] x^2/(1 - z x): \
Applyd rewrites the substituted differential d[x/(1 + x)] as D[x/(1 + x), x] \
d[x], and the rule d[x_] :> 1 removes the measure symbol, so the result \
carries the Jacobian of the change of variables (as in the energy-energy \
correlator example of the paper, Sec. 4.3).\
\>", "ExampleText",ExpressionUUID->"22cffd4b-9aa5-4dc2-bd4d-10cfa3387b65"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"d", "[", "x", "]"}], " ", 
    RowBox[{
     RowBox[{"x", "^", "2"}], "/", 
     RowBox[{"(", 
      RowBox[{"1", " ", "-", " ", 
       RowBox[{"z", " ", "x"}]}], ")"}]}]}], " ", "/.", " ", 
   RowBox[{"x", " ", "->", " ", 
    RowBox[{"x", "/", 
     RowBox[{"(", 
      RowBox[{"1", " ", "+", " ", "x"}], ")"}]}]}]}], " ", "//", " ", 
  RowBox[{
   RowBox[{
    RowBox[{"Applyd", "[", 
     RowBox[{"#", ",", " ", 
      RowBox[{"{", "x", "}"}]}], "]"}], " ", "//.", " ", 
    RowBox[{
     RowBox[{"d", "[", "x_", "]"}], " ", ":>", " ", "1"}]}], " ", 
   "&"}]}]], "Input",ExpressionUUID->"3a971634-f1d1-44b0-a484-6df25931c38b"],

Cell[BoxData[
 FractionBox[
  RowBox[{
   SuperscriptBox["x", "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", 
      FractionBox["x", 
       SuperscriptBox[
        RowBox[{"(", 
         RowBox[{"1", "+", "x"}], ")"}], "2"]]}], "+", 
     FractionBox["1", 
      RowBox[{"1", "+", "x"}]]}], ")"}]}], 
  RowBox[{
   SuperscriptBox[
    RowBox[{"(", 
     RowBox[{"1", "+", "x"}], ")"}], "2"], " ", 
   RowBox[{"(", 
    RowBox[{"1", "-", 
     FractionBox[
      RowBox[{"x", " ", "z"}], 
      RowBox[{"1", "+", "x"}]]}], ")"}]}]]], "Output",ExpressionUUID->\
"7930181a-69e2-45ca-9bd2-f6b28d601107"]
}, Open  ]],

