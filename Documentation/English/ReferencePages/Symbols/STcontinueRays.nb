Notebook[{

Cell[CellGroupData[{
Cell["STContinueRays", "ObjectName",ExpressionUUID->"c8986810-02a1-4bc0-9f53-d7615e6d8be8"],

Cell[BoxData[GridBox[{
   {Cell[TextData[{
     StyleBox["STContinueRays", "TI"],
     " \[LineSeparator]STcontinueRays performs the Nilsson--Passare \
analytical continuation along a specified set of rays of the Newton polytope, \
extracting pole contributions before the subtraction formula is applied."
    }], "TableText",ExpressionUUID->"12097ecd-9176-4a87-a8d4-367b5159a5d4"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Usage",
 CellID->1,ExpressionUUID->"aef61906-529a-451d-b15c-71b179624e31"],

Cell["\<\
STcontinueRays performs the Nilsson--Passare analytical continuation along a \
specified set of rays of the Newton polytope, extracting pole contributions \
before the subtraction formula is applied. It is called internally by \
STExpandIntegral, but can also be invoked directly when finer control over \
the continuation is needed (see the small-x example in Sec.~ for a worked \
illustration).  (see example below)\
\>", "Notes",ExpressionUUID->"b3e1fa89-1ebf-436c-91de-a512b64470bc"],

Cell[BoxData[
 RowBox[{"STcontinueRays", "[", 
  RowBox[{"prefsInts", ",", " ", "variables", ",", " ", "rays"}], 
  "]"}]], "Input",ExpressionUUID->"819b9ff4-c80c-485f-bc83-3fa8baebaf41"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Details", "Section",ExpressionUUID->"91b296b1-8dee-4abe-893a-86199ce4e950"],

Cell["Arguments", "Subsection",ExpressionUUID->"ec4ceb66-fa53-488f-bd6f-5c275bfd8d3c"],

Cell["\<\
prefsInts is a list of pairs {prefactor, integrand}, where each pair \
represents a term in the Euler integral. variables is the list of integration \
variables. rays is a list of rays (integer vectors) along which the \
continuation is to be performed. Inputing an empty list {} returns the input \
unchanged. The function processes the rays recursively, one at a time.\
\>", "Text",ExpressionUUID->"44fb71f3-814c-41ac-8c06-8ae591cea8ea"],

Cell["Return value", "Subsection",ExpressionUUID->"4c40a4e3-3651-4c6f-9a81-ff241de5f35e"],

Cell["\<\
A list of pairs {prefactor, integrand} after the continuation has been \
performed. Each resulting term can then be passed to STExpandIntegral for \
tropical subtraction.\
\>", "Text",ExpressionUUID->"558e64d7-0040-43c9-88f3-b6c008fc7818"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[GridBox[{
    {
     StyleBox[
      RowBox[{"Basic", " ", "Examples"}], "PrimaryExamplesSection"], 
     ButtonBox[
      RowBox[{
       RowBox[{"More", " ", "Examples"}], " ", "\[RightTriangle]"}],
      BaseStyle->"ExtendedExamplesLink",
      ButtonData:>"ExtendedExamples"]}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"34790b81-e7ec-\
4493-8abb-0ea27495f5a1"],

Cell["\<\
Nilsson-Passare continuation along given Newton-polytope rays, extracting \
pole contributions; called internally by STExpandIntegral.  Advanced: \
requires the surrounding subtraction-pipeline setup.\
\>", "ExampleText",ExpressionUUID->"2556342d-fb77-4246-b3c4-9c19045c1b41"],

Cell[BoxData[
 RowBox[{"STContinueRays", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"pref", ",", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"Times", " ", "@@", " ", "xvars"}], ")"}], " ", 
       "integrand"}]}], "}"}], "}"}], ",", " ", "xvars", ",", " ", 
   RowBox[{"{", 
    RowBox[{"{", 
     RowBox[{"1", ",", " ", "1"}], "}"}], "}"}]}], "]"}]], "Input",ExpressionU\
UID->"3d3c9919-b592-4ff3-91df-055486a30c21"]
}, Open  ]],

