Notebook[{

Cell[CellGroupData[{
Cell["STFactorPredictor", "ObjectName",ExpressionUUID->"17cbff9a-8c99-45ef-9f6c-12a4592421bf"],

Cell[BoxData[GridBox[{
   {Cell[TextData[{
     StyleBox["STFactorPredictor[f, g, var]", "TI"],
     " \[LineSeparator]returns the FactorList of the monic difference f/lc - \
g/lc (lc = leading coefficient in var) from the prebuilt factor table: {{c0, \
1}, {P1, n1}, ...} with negative exponents for denominator factors."
    }], "TableText",ExpressionUUID->"63dfeeb1-5f68-4587-87cd-6e9cfd920b2e"]},
   {Cell[TextData[{
     StyleBox["STFactorPredictor[f, var]", "TI"],
     " \[LineSeparator]returns the singleton record (coefficient and \
discriminant factor lists) for letter f."
    }], "TableText",ExpressionUUID->"0a1f6e47-1ceb-44c7-aa98-7f3db45a7bf5"]},
   {Cell[TextData[{
     StyleBox["STFactorPredictor[table, ...]", "TI"],
     " \[LineSeparator]uses an explicit table instead of the kernel-global \
default. Options: \"OnMiss\" -> \"Factor\" (default; compute on the spot) | \
\"Missing\"; \"ExtendTable\" -> True (runtime-append misses to the global \
table). Pair queries with arguments not of degree 1 in var return \
Missing[\"NotDeg1Pair\"]. Hit/miss counters live in the global table's \
\"Stats\". Representation note: a table hit returns factors in \
table-canonical normalization (stCanonicalPolyForm bases, units folded into \
the constant), while the \"OnMiss\" -> \"Factor\" path returns raw FactorList \
bases; the two agree in value, factor by factor up to units in the constant."
    }], "TableText",ExpressionUUID->"1afe78c7-40c5-4222-ac87-189208bf985b"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Usage",
 CellID->1,ExpressionUUID->"c39892e5-3c1b-4fc9-8299-1a8788ac291d"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Options", "OptionsSection",ExpressionUUID->"d8816978-bdc3-41b3-8204-1725fd9f39bb"],

Cell[BoxData[GridBox[{
   {"\"\<OnMiss\>\"", "\"\<Factor\>\"", 
    RowBox[{
     RowBox[{"on", " ", "a", " ", "table", " ", 
      RowBox[{"miss", ":", " ", 
       RowBox[{"\"\<Factor\>\"", " ", "computes", " ", "the", " ", 
        "factorization", " ", "on", " ", "the", " ", "spot"}]}]}], ",", " ", 
     RowBox[{"or", " ", "\"\<Missing\>\"", " ", "returns", " ", 
      RowBox[{"Missing", "[", "...", "]"}]}]}]},
   {"\"\<ExtendTable\>\"", "True", 
    RowBox[{
     RowBox[{
     "append", " ", "computed", " ", "misses", " ", "to", " ", "the", " ", 
      "kernel"}], "-", 
     RowBox[{"global", " ", "factor", " ", "table"}]}]}
  },
  GridBoxAlignment->{"Columns" -> {Left, Left, Left}},
  GridBoxDividers->{"Rows" -> {True, {False}, True}}]], "OptionsTable",Express\
ionUUID->"6705b106-5385-466c-8dbb-922ac3144c30"]
}, Open  ]],

