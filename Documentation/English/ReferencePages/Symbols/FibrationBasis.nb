Cell["\<\
Re-express a polylogarithm in the fibration basis with z as the innermost \
variable.\
\>", "ExampleText",ExpressionUUID->"3e4177bf-0d8e-4424-856a-c0363d9f409d"],

Cell[BoxData[
 RowBox[{"FibrationBasis", "[", 
  RowBox[{
   RowBox[{"PolyLog", "[", 
    RowBox[{"5", ",", " ", 
     RowBox[{
      RowBox[{"-", "1"}], "/", "z"}]}], "]"}], ",", " ", 
   RowBox[{"{", "z", "}"}]}], "]"}]], "Input",ExpressionUUID->"f642de3e-5171-\
4346-a544-6fc7d708f1ef"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   FractionBox["7", "360"], " ", 
   SuperscriptBox["\[Pi]", "4"], " ", 
   RowBox[{"Hlog", "[", 
    RowBox[{"z", ",", 
     RowBox[{"{", "0", "}"}]}], "]"}]}], "+", 
  RowBox[{
   FractionBox["1", "6"], " ", 
   SuperscriptBox["\[Pi]", "2"], " ", 
   RowBox[{"Hlog", "[", 
    RowBox[{"z", ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "]"}]}], "-", 
  RowBox[{"Hlog", "[", 
   RowBox[{"z", ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", 
      RowBox[{"-", "1"}]}], "}"}]}], "]"}], "+", 
  RowBox[{"Hlog", "[", 
   RowBox[{"z", ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}]}], "]"}], "-", 
  RowBox[{
   FractionBox["3", "2"], " ", 
   RowBox[{"Hlog", "[", 
    RowBox[{"z", ",", 
     RowBox[{"{", "0", "}"}]}], "]"}], " ", 
   RowBox[{"Zeta", "[", "3", "]"}]}], "+", 
  RowBox[{"4", " ", 
   RowBox[{"Zeta", "[", "5", "]"}]}]}]], "Output",ExpressionUUID->"b790e18d-\
5a83-4770-a3bd-6568e7fe728c"]
}, Open  ]],

