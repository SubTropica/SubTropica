Cell["\<\
Re-express a polylogarithm in the fibration basis with z as the innermost \
variable.\
\>", "ExampleText",ExpressionUUID->"eaae0285-03db-4a8e-bf17-f81be10caa01"],

Cell[BoxData[
 RowBox[{"FibrationBasis", "[", 
  RowBox[{
   RowBox[{"PolyLog", "[", 
    RowBox[{"5", ",", " ", 
     RowBox[{
      RowBox[{"-", "1"}], "/", "z"}]}], "]"}], ",", " ", 
   RowBox[{"{", "z", "}"}]}], "]"}]], "Input",ExpressionUUID->"38478141-660e-\
42c2-9792-165b68e68329"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   FractionBox["7", "360"], " ", 
   SuperscriptBox["\[Pi]", "4"], " ", 
   RowBox[{"Hlog", "[", 
    RowBox[{"z", ",", 
     RowBox[{"{", "0", "}"}]}], "]"}]}], "+", 
  RowBox[{
   FractionBox["1", "6"], " ", 
   SuperscriptBox["\[Pi]", "2"], " ", 
   RowBox[{"Hlog", "[", 
    RowBox[{"z", ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "]"}]}], "-", 
  RowBox[{"Hlog", "[", 
   RowBox[{"z", ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", 
      RowBox[{"-", "1"}]}], "}"}]}], "]"}], "+", 
  RowBox[{"Hlog", "[", 
   RowBox[{"z", ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}]}], "]"}], "-", 
  RowBox[{
   FractionBox["3", "2"], " ", 
   RowBox[{"Hlog", "[", 
    RowBox[{"z", ",", 
     RowBox[{"{", "0", "}"}]}], "]"}], " ", 
   RowBox[{"Zeta", "[", "3", "]"}]}], "+", 
  RowBox[{"4", " ", 
   RowBox[{"Zeta", "[", "5", "]"}]}]}]], "Output",ExpressionUUID->"20d75fef-\
4c77-46bc-a219-859cc20f1d26"]
}, Open  ]],

