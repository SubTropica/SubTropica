Cell["\<\
Re-express a polylogarithm in the fibration basis with z as the innermost \
variable.\
\>", "ExampleText",ExpressionUUID->"ba395bc9-a732-4c7c-bd9d-5d7dfe383221"],

Cell[BoxData[
 RowBox[{"FibrationBasis", "[", 
  RowBox[{
   RowBox[{"PolyLog", "[", 
    RowBox[{"5", ",", " ", 
     RowBox[{
      RowBox[{"-", "1"}], "/", "z"}]}], "]"}], ",", " ", 
   RowBox[{"{", "z", "}"}]}], "]"}]], "Input",ExpressionUUID->"d875e6a9-ee7f-\
4ca5-b215-a36175ff5ee0"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   FractionBox["7", "360"], " ", 
   SuperscriptBox["\[Pi]", "4"], " ", 
   RowBox[{"Hlog", "[", 
    RowBox[{"z", ",", 
     RowBox[{"{", "0", "}"}]}], "]"}]}], "+", 
  RowBox[{
   FractionBox["1", "6"], " ", 
   SuperscriptBox["\[Pi]", "2"], " ", 
   RowBox[{"Hlog", "[", 
    RowBox[{"z", ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "]"}]}], "-", 
  RowBox[{"Hlog", "[", 
   RowBox[{"z", ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", 
      RowBox[{"-", "1"}]}], "}"}]}], "]"}], "+", 
  RowBox[{"Hlog", "[", 
   RowBox[{"z", ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}]}], "]"}], "-", 
  RowBox[{
   FractionBox["3", "2"], " ", 
   RowBox[{"Hlog", "[", 
    RowBox[{"z", ",", 
     RowBox[{"{", "0", "}"}]}], "]"}], " ", 
   RowBox[{"Zeta", "[", "3", "]"}]}], "+", 
  RowBox[{"4", " ", 
   RowBox[{"Zeta", "[", "5", "]"}]}]}]], "Output",ExpressionUUID->"fe146392-\
2b31-424c-bba4-da86f9500461"]
}, Open  ]],

