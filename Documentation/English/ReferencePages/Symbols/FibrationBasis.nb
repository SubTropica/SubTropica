Cell["\<\
Re-express a polylogarithm in the fibration basis with z as the innermost \
variable.\
\>", "ExampleText",ExpressionUUID->"0c4e7999-1816-405d-81de-c0e4ec9c36d4"],

Cell[BoxData[
 RowBox[{"FibrationBasis", "[", 
  RowBox[{
   RowBox[{"PolyLog", "[", 
    RowBox[{"5", ",", " ", 
     RowBox[{
      RowBox[{"-", "1"}], "/", "z"}]}], "]"}], ",", " ", 
   RowBox[{"{", "z", "}"}]}], "]"}]], "Input",ExpressionUUID->"e6333270-eb52-\
4648-8766-3d4281074a6b"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   FractionBox["7", "360"], " ", 
   SuperscriptBox["\[Pi]", "4"], " ", 
   RowBox[{"Hlog", "[", 
    RowBox[{"z", ",", 
     RowBox[{"{", "0", "}"}]}], "]"}]}], "+", 
  RowBox[{
   FractionBox["1", "6"], " ", 
   SuperscriptBox["\[Pi]", "2"], " ", 
   RowBox[{"Hlog", "[", 
    RowBox[{"z", ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "]"}]}], "-", 
  RowBox[{"Hlog", "[", 
   RowBox[{"z", ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", 
      RowBox[{"-", "1"}]}], "}"}]}], "]"}], "+", 
  RowBox[{"Hlog", "[", 
   RowBox[{"z", ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}]}], "]"}], "-", 
  RowBox[{
   FractionBox["3", "2"], " ", 
   RowBox[{"Hlog", "[", 
    RowBox[{"z", ",", 
     RowBox[{"{", "0", "}"}]}], "]"}], " ", 
   RowBox[{"Zeta", "[", "3", "]"}]}], "+", 
  RowBox[{"4", " ", 
   RowBox[{"Zeta", "[", "5", "]"}]}]}]], "Output",ExpressionUUID->"7915ca45-\
a54c-4369-8509-6c9f884aed3c"]
}, Open  ]],

