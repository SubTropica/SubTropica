Cell["\<\
Re-express a polylogarithm in the fibration basis with z as the innermost \
variable.\
\>", "ExampleText",ExpressionUUID->"6cf0e896-c386-40e1-9eca-2eae6d76bd0f"],

Cell[BoxData[
 RowBox[{"FibrationBasis", "[", 
  RowBox[{
   RowBox[{"PolyLog", "[", 
    RowBox[{"5", ",", " ", 
     RowBox[{
      RowBox[{"-", "1"}], "/", "z"}]}], "]"}], ",", " ", 
   RowBox[{"{", "z", "}"}]}], "]"}]], "Input",ExpressionUUID->"d050534d-0330-\
4eb0-ac1a-9a11ca59180f"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   FractionBox["7", "360"], " ", 
   SuperscriptBox["\[Pi]", "4"], " ", 
   RowBox[{"Hlog", "[", 
    RowBox[{"z", ",", 
     RowBox[{"{", "0", "}"}]}], "]"}]}], "+", 
  RowBox[{
   FractionBox["1", "6"], " ", 
   SuperscriptBox["\[Pi]", "2"], " ", 
   RowBox[{"Hlog", "[", 
    RowBox[{"z", ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "0"}], "}"}]}], "]"}]}], "-", 
  RowBox[{"Hlog", "[", 
   RowBox[{"z", ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", 
      RowBox[{"-", "1"}]}], "}"}]}], "]"}], "+", 
  RowBox[{"Hlog", "[", 
   RowBox[{"z", ",", 
    RowBox[{"{", 
     RowBox[{"0", ",", "0", ",", "0", ",", "0", ",", "0"}], "}"}]}], "]"}], "-", 
  RowBox[{
   FractionBox["3", "2"], " ", 
   RowBox[{"Hlog", "[", 
    RowBox[{"z", ",", 
     RowBox[{"{", "0", "}"}]}], "]"}], " ", 
   RowBox[{"Zeta", "[", "3", "]"}]}], "+", 
  RowBox[{"4", " ", 
   RowBox[{"Zeta", "[", "5", "]"}]}]}]], "Output",ExpressionUUID->"514350ee-\
ba4e-4f6a-a248-e17195e6476c"]
}, Open  ]],

