Notebook[{

Cell[CellGroupData[{
Cell["STExpandIntegral", "ObjectName",ExpressionUUID->"e1e04a15-19e0-4e0b-8310-c4358d627384"],

Cell[BoxData[GridBox[{
   {Cell[TextData[{
     StyleBox["STExpandIntegral", "TI"],
     " \[LineSeparator]~."
    }], "TableText",ExpressionUUID->"d69237d8-ffa4-40ae-9d12-c1044b5161ec"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Usage",
 CellID->1,ExpressionUUID->"0d78f9f1-876f-4a20-9678-de3c47b167da"],

Cell["\<\
STExpandIntegral is the core routine that reduces a (potentially divergent) \
Euler integral to a sum of locally finite integrals, applying the \
Nilsson--Passare procedure followed by tropical subtractions as described in \
Sec.~. It takes three required and three optional positional arguments: (see \
example below)\
\>", "Notes",ExpressionUUID->"76b87b86-25ba-4eb5-9068-8cf38422688b"],

Cell[BoxData[
 RowBox[{
  RowBox[{"STExpandIntegral", "[", 
   RowBox[{
   "integrand", ",", " ", "variables", ",", " ", "coeffs", "\n", "\t", ",", 
    " ", 
    RowBox[{"{", "eps", "}"}], "  ", 
    RowBox[{"(*", " ", 
     RowBox[{"regulators", ",", " ", "optional"}], " ", "*)"}], "\n", "\t", ",",
     " ", 
    RowBox[{"{", "}"}], "     ", 
    RowBox[{"(*", " ", 
     RowBox[{"trDataGiven", ",", " ", "optional"}], " ", "*)"}], "\n", "\t", ",",
     " ", 
    RowBox[{"{", "}"}]}], "   ", "]"}], " ", 
  RowBox[{"(*", " ", 
   RowBox[{"forceUs", ",", " ", "optional"}], " ", "*)"}]}]], "Input",Expressi\
onUUID->"7f8ee64d-916b-431f-a2d4-ff32cdd504bb"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Details", "Section",ExpressionUUID->"4ca7385e-7551-4051-bbbb-463ce6d2b5db"],

Cell["Required arguments", "Subsection",ExpressionUUID->"e457d278-6863-422b-b096-c5323965c4ad"],

Cell["\<\
integrand is an Euler-type integrand, expressed as a product of polynomials \
raised to powers that depend on the dimensional regulator (see ). variables \
is the list of integration variables (Feynman or Schwinger parameters, \
denoted x_j=xj), and coeffs lists the kinematic coefficients appearing in \
those polynomials.\
\>", "Text",ExpressionUUID->"5966b7bd-24a5-4775-aa25-ecedd62466bb"],

Cell["Return value", "Subsection",ExpressionUUID->"94988f2a-1f16-4cd6-9ecd-dcfedc27711b"],

Cell["\<\
The function returns a list {{prefactor, subtraction}, ...}, one entry per \
Nilsson--Passare continuation term. Each subtraction is itself a list \
{{faceIntegrand, faceVariables}, ...} indexed by the divergent faces of the \
Newton polytope. Here faceIntegrand is a list of additive terms whose sum is \
locally finite and ready to be passed to HyperIntica.\
\>", "Text",ExpressionUUID->"a039756a-b143-41f1-8c45-87bc1bea2bc5"],

Cell["Optional arguments", "Subsection",ExpressionUUID->"884db379-737d-4552-9c35-bd236f07e54c"],

Cell["\<\
regulators (default {eps}) lists the dimensional regulators used to identify \
which rays of the Newton polytope correspond to divergences. trDataGiven \
(default {}) accepts pre-computed tropical data, skipping the Polymake call. \
When STIntegrate is used, tropical data for all gauge candidates is computed \
concurrently upfront and passed through this argument. forceUs (default {}) \
pins specific u-variables for both the NP continuation and the subtraction \
formula.\
\>", "Text",ExpressionUUID->"1640cec7-c1a7-4e89-9c0f-32e86e77dd03"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 InterpretationBox[GridBox[{
    {
     StyleBox[
      RowBox[{"Basic", " ", "Examples"}], "PrimaryExamplesSection"], 
     ButtonBox[
      RowBox[{
       RowBox[{"More", " ", "Examples"}], " ", "\[RightTriangle]"}],
      BaseStyle->"ExtendedExamplesLink",
      ButtonData:>"ExtendedExamples"]}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"33fb0a19-9f91-\
4415-8663-1bbcf43ee64b"],

Cell["\<\
Reduces a divergent Euler integral to a sum of locally finite integrals by \
Nilsson-Passare continuation and tropical subtractions; returns {prefactor, \
subtraction} pairs.  The integrand carries the internal dx/x measure, so it \
is premultiplied by x1 x2.\
\>", "ExampleText",ExpressionUUID->"c77a9e40-521b-4d00-9ad9-2262bf35cc59"],

Cell[BoxData[
 RowBox[{"STExpandIntegral", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"(", 
     RowBox[{"x1", " ", "x2"}], ")"}], " ", 
    RowBox[{"x1", "^", "eps"}], " ", 
    RowBox[{"x2", "^", "eps"}], " ", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"1", " ", "+", " ", "x1", " ", "+", " ", "x2"}], ")"}], "^", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"-", "3"}], " ", "eps"}], ")"}]}]}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"x1", ",", " ", "x2"}], "}"}], ",", " ", 
   RowBox[{"{", "}"}]}], "]"}]], "Input",ExpressionUUID->"142e50e6-acf3-4f04-\
b63a-b573883708ee"]
}, Open  ]],

