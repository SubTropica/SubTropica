     RowBox[{"(", 
      RowBox[{"or", " ", "the", " ", "IterInt", " ", "repo"}], ")"}]}]},
   {"\"\<SymbolicEvaluator\>\"", "Inherited", 
    RowBox[{
     RowBox[{"\"\<ginsh\>\"", " ", 
      RowBox[{"(", "default", ")"}], " ", "or", " ", "\"\<iterint\>\""}], ":",
