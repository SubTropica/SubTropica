Notebook[{

Cell[CellGroupData[{
Cell["ConfigureSubTropica", "ObjectName",ExpressionUUID->"ee25d8a6-6b47-4891-b9f8-67aa0b3a4000"],

Cell[BoxData[GridBox[{
   {Cell[TextData[{
     StyleBox["ConfigureSubTropica[opt -> val, ...]", "TI"],
     " \[LineSeparator]sets external-tool paths (PolymakePath, GinshPath, \
MaplePath, HyperIntPath, HyperFlintPath, PythonPath, FiniteFlowPath, \
SPQRPath, FIESTAPath, AMFlowPath, LiteRedPath, LiteIBPPath, FIREPath, \
FeyntropPath, IterIntPath, SymbolicEvaluator, KiraPath, NeatIBPPath, \
SingularPath, PolyLogToolsPath, LibraPath, DiffExpPath, FermatPath, FormPath, \
HyperFormPath, HyperLogProceduresPath, MsolvePath, \
PolymakeConcurrencyFraction). IterIntPath points at the iterint_mpfr driver \
(or IterInt repo dir); SymbolicEvaluator is \"ginsh\" (default) or \
\"iterint\" and selects which evaluator STVerify uses for the symbolic \
Hlog/Log/zeta result. Only options that are explicitly named are updated; \
omitted options leave the current global state unchanged (no silent reset to \
package defaults). The configuration is auto-persisted to $STConfigFile and \
reapplied on the next Get[\"SubTropica`\"], so you only need to call this \
once per machine."
    }], "TableText",ExpressionUUID->"ab1106ff-3771-489f-a40d-3e5015545fc6"]}
  },
  GridBoxAlignment->{"Columns" -> {{Left}}},
  GridBoxItemSize->{
   "Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}}]], "Usage",
 CellID->1,ExpressionUUID->"b65b3175-2eb5-493c-b9df-148a7c93b15b"]
}, Open  ]],

