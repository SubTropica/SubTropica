   {"\"\<HyperFlintPath\>\"", "Inherited", 
    RowBox[{"path", " ", "to", " ", "the", " ", "HyperFLINT", " ", "binary"}]},
   {"\"\<HyperFlintDataPath\>\"", "Inherited", 
