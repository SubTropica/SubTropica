   " ", 
   RowBox[{
   "PythonPath", " ", "->", 
    " ", "\"\<.venvs/subtropica312/bin/python\>\""}]}], "]"}]], "Input",Expres\
sionUUID->"11dd9b89-ca99-4aea-8597-b57eb98fc9bd"]
