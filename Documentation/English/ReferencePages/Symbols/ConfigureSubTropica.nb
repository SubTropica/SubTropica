       RowBox[{"the", " ", "only", " ", "required", " ", "dependency"}], 
       ")"}]}], ";", " ", 
     RowBox[{
      RowBox[{"\"\<\>\"", " ", "re"}], "-", 
      RowBox[{"runs", " ", "auto"}], "-", "discovery"}]}]},
   {"\"\<PythonPath\>\"", "Inherited", 
    RowBox[{
    "path", " ", "to", " ", "the", " ", "python", " ", "executable", " ", 
     "used", " ", "for", " ", "pySecDec"}]},
   {"\"\<GinshPath\>\"", "Inherited", 
    RowBox[{"path", " ", "to", " ", "the", " ", "ginsh", " ", 
     RowBox[{"(", "GiNaC", ")"}], " ", "executable"}]},
   {"\"\<IterIntPath\>\"", "Inherited", 
