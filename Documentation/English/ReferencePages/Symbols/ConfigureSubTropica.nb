  RowBox[{
   RowBox[{
   "PolymakePath", " ", "->", " ", "\"\</usr/local/bin/polymake\>\""}], ",", 
   " ", 
   RowBox[{
   "PythonPath", " ", "->", 
    " ", "\"\<.venvs/subtropica312/bin/python\>\""}]}], "]"}]], "Input",Expres\
sionUUID->"b1469098-046d-4eea-a4e4-b70a6e4d00a1"]
