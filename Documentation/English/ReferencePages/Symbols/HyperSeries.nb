   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"5f5f5e69-3150-\
4df3-a408-755281e46b29"],

Cell["\<\
The series expansion of Li2(z) about z = 0, expanded through Mpl.\
\>", "ExampleText",ExpressionUUID->"c4fd6994-2499-4205-a5ff-5fbce6498800"],

Cell[BoxData[
 RowBox[{"HyperSeries", "[", 
  RowBox[{
   RowBox[{"Mpl", "[", 
    RowBox[{
     RowBox[{"{", "2", "}"}], ",", " ", 
     RowBox[{"{", "z", "}"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"z", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]], "Input",Expr\
essionUUID->"93893515-06b4-4ecf-b22f-9364531851bf"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"z", "+", 
   FractionBox[
    SuperscriptBox["z", "2"], "4"], "+", 
   FractionBox[
    SuperscriptBox["z", "3"], "9"], "+", 
   FractionBox[
    SuperscriptBox["z", "4"], "16"], "+", 
   FractionBox[
    SuperscriptBox["z", "5"], "25"], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "z", "]"}], "6"],
    SeriesData[$CellContext`z, 0, {}, 1, 6, 1],
    Editable->False]}],
  SeriesData[$CellContext`z, 0, {1, 
    Rational[1, 4], 
    Rational[1, 9], 
    Rational[1, 16], 
    Rational[1, 25]}, 1, 6, 1],
  Editable->False]], "Output",ExpressionUUID->"9adf2234-c04c-4d50-88fa-\
ec0c3ec34436"]
}, Open  ]],

