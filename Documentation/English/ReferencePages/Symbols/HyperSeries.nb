      ButtonData:>"ExtendedExamples"]}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"6fe55b97-ed51-\
40e9-8e64-f75434488eb2"],

Cell["\<\
The series expansion of Li2(z) about z = 0, expanded through Mpl.\
\>", "ExampleText",ExpressionUUID->"e2918806-0ea2-4e30-b5a6-f9ea083d1c59"],

Cell[BoxData[
 RowBox[{"HyperSeries", "[", 
  RowBox[{
   RowBox[{"Mpl", "[", 
    RowBox[{
     RowBox[{"{", "2", "}"}], ",", " ", 
     RowBox[{"{", "z", "}"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"z", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]], "Input",Expr\
essionUUID->"c2ac86c9-1734-41ae-878c-0c0a8cd5ca91"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"z", "+", 
   FractionBox[
    SuperscriptBox["z", "2"], "4"], "+", 
   FractionBox[
    SuperscriptBox["z", "3"], "9"], "+", 
   FractionBox[
    SuperscriptBox["z", "4"], "16"], "+", 
   FractionBox[
    SuperscriptBox["z", "5"], "25"], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "z", "]"}], "6"],
    SeriesData[$CellContext`z, 0, {}, 1, 6, 1],
    Editable->False]}],
  SeriesData[$CellContext`z, 0, {1, 
    Rational[1, 4], 
    Rational[1, 9], 
    Rational[1, 16], 
    Rational[1, 25]}, 1, 6, 1],
  Editable->False]], "Output",ExpressionUUID->"1516cdd0-71ab-40d1-ad57-\
e92ba49977ed"]
}, Open  ]],

