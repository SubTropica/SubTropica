   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"bd3e7446-0e9e-\
4688-bdc5-9a4038d8569d"],

Cell["\<\
The series expansion of Li2(z) about z = 0, expanded through Mpl.\
\>", "ExampleText",ExpressionUUID->"0437b55f-c9d2-4bc1-a364-be502303425c"],

Cell[BoxData[
 RowBox[{"HyperSeries", "[", 
  RowBox[{
   RowBox[{"Mpl", "[", 
    RowBox[{
     RowBox[{"{", "2", "}"}], ",", " ", 
     RowBox[{"{", "z", "}"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"z", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]], "Input",Expr\
essionUUID->"6b063a79-e120-4660-821b-adbeee3bab02"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"z", "+", 
   FractionBox[
    SuperscriptBox["z", "2"], "4"], "+", 
   FractionBox[
    SuperscriptBox["z", "3"], "9"], "+", 
   FractionBox[
    SuperscriptBox["z", "4"], "16"], "+", 
   FractionBox[
    SuperscriptBox["z", "5"], "25"], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "z", "]"}], "6"],
    SeriesData[$CellContext`z, 0, {}, 1, 6, 1],
    Editable->False]}],
  SeriesData[$CellContext`z, 0, {1, 
    Rational[1, 4], 
    Rational[1, 9], 
    Rational[1, 16], 
    Rational[1, 25]}, 1, 6, 1],
  Editable->False]], "Output",ExpressionUUID->"9ba3ae23-c6df-4b46-a176-\
893e38a7c863"]
}, Open  ]],

