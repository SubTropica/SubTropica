       RowBox[{"More", " ", "Examples"}], " ", "\[RightTriangle]"}],
      BaseStyle->"ExtendedExamplesLink",
      ButtonData:>"ExtendedExamples"]}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"0e221875-655c-\
49e8-9569-857524b80136"],

Cell["\<\
The series expansion of Li2(z) about z = 0, expanded through Mpl.\
\>", "ExampleText",ExpressionUUID->"832691ff-a177-4bb5-81e4-04d0a33de0d0"],

Cell[BoxData[
 RowBox[{"HyperSeries", "[", 
  RowBox[{
   RowBox[{"Mpl", "[", 
    RowBox[{
     RowBox[{"{", "2", "}"}], ",", " ", 
     RowBox[{"{", "z", "}"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"z", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]], "Input",Expr\
essionUUID->"c9401ac4-016d-4058-b481-3d2ca0e01b75"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"z", "+", 
   FractionBox[
    SuperscriptBox["z", "2"], "4"], "+", 
   FractionBox[
    SuperscriptBox["z", "3"], "9"], "+", 
   FractionBox[
    SuperscriptBox["z", "4"], "16"], "+", 
   FractionBox[
    SuperscriptBox["z", "5"], "25"], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "z", "]"}], "6"],
    SeriesData[$CellContext`z, 0, {}, 1, 6, 1],
    Editable->False]}],
  SeriesData[$CellContext`z, 0, {1, 
    Rational[1, 4], 
    Rational[1, 9], 
    Rational[1, 16], 
    Rational[1, 25]}, 1, 6, 1],
  Editable->False]], "Output",ExpressionUUID->"aa3f6198-2d07-4d56-aeb6-\
ac9d8937302d"]
}, Open  ]],

