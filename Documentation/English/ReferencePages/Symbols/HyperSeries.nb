      ButtonData:>"ExtendedExamples"]}
   }],
  $Line = 0; Null]], "PrimaryExamplesSection",ExpressionUUID->"93587d55-82f2-\
4c27-8a95-975edac32085"],

Cell["\<\
The series expansion of Li2(z) about z = 0, expanded through Mpl.\
\>", "ExampleText",ExpressionUUID->"3fbdcc6d-302f-489a-a06a-7067cbddd052"],

Cell[BoxData[
 RowBox[{"HyperSeries", "[", 
  RowBox[{
   RowBox[{"Mpl", "[", 
    RowBox[{
     RowBox[{"{", "2", "}"}], ",", " ", 
     RowBox[{"{", "z", "}"}]}], "]"}], ",", " ", 
   RowBox[{"{", 
    RowBox[{"z", ",", " ", "0", ",", " ", "5"}], "}"}]}], "]"}]], "Input",Expr\
essionUUID->"cd76f729-d495-4aff-8810-0efc8e0f6b4d"],

Cell[BoxData[
 InterpretationBox[
  RowBox[{"z", "+", 
   FractionBox[
    SuperscriptBox["z", "2"], "4"], "+", 
   FractionBox[
    SuperscriptBox["z", "3"], "9"], "+", 
   FractionBox[
    SuperscriptBox["z", "4"], "16"], "+", 
   FractionBox[
    SuperscriptBox["z", "5"], "25"], "+", 
   InterpretationBox[
    SuperscriptBox[
     RowBox[{"O", "[", "z", "]"}], "6"],
    SeriesData[$CellContext`z, 0, {}, 1, 6, 1],
    Editable->False]}],
  SeriesData[$CellContext`z, 0, {1, 
    Rational[1, 4], 
    Rational[1, 9], 
    Rational[1, 16], 
    Rational[1, 25]}, 1, 6, 1],
  Editable->False]], "Output",ExpressionUUID->"5aa4441c-a31d-4c10-a4dd-\
9e5fa70eff6c"]
}, Open  ]],

